+static void bootparam_get_config_board_id(u64 *board_id)
+{
+	void __iomem *bootparam = ioremap(0x9b000, 0x2000);
+	*board_id = readq(bootparam + 0x328);
+	iounmap(bootparam);
+}
+
+static void bootparam_get_config_gddr6_id(u16 *gddr6_id)
+{
+	void __iomem *bootparam = ioremap(0x9b000, 0x2000);
+	*gddr6_id = readw(bootparam + 0x1184);
+	iounmap(bootparam);
+}
+
+int icc_fan_update_param(const u8 *param)
+{
+	u8 *buf;
+	struct icc_msg *msg;
+	u16 status;
+	int ret;
+
+	buf = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	msg = (struct icc_msg *)buf;
+
+	msg->service_id = ICC_SERVICE_ID_FAN;
+	msg->msg_type = 0xe;
+	msg->length = sizeof(*msg) + PS5_FAN_PARAM_OFF + PS5_FAN_PARAM_SIZE;
+	memcpy(msg->data + PS5_FAN_PARAM_OFF, param, PS5_FAN_PARAM_SIZE);
+
+	ret = icc_query(buf, buf);
+	if (ret)
+		goto out;
+
+	status = get_unaligned_le16(msg->data);
+	if (status) {
+		pr_err("FanServo: EMC rejected param, status 0x%x\n", status);
+		ret = -EIO;
+	}
+
+out:
+	kfree(buf);
+	return ret;
+}
+EXPORT_SYMBOL(icc_fan_update_param);
+
+int icc_fan_update_autoservo_param(void)
+{
+	u64 board_id, board_mask_a, board_mask_b;
+	u16 gddr6_id;
+	u8 gddr6_vendor, gddr6_revision;
+	const char *board_name = NULL;
+	const char *gddr6_name = NULL;
+	const u8 *param = NULL;
+	int ret;
+
+	bootparam_get_config_board_id(&board_id);
+	board_id = be64_to_cpu(board_id);
+	board_mask_a = board_id & BOARD_MASK_A;
+	board_mask_b = board_id & BOARD_MASK_B;
+
+	bootparam_get_config_gddr6_id(&gddr6_id);
+	gddr6_vendor = gddr6_id & 0xf;
+	gddr6_revision = (gddr6_id >> 4) & 0xf;
+
+	pr_info("FanServo: board_id 0x%016llx mask_a 0x%016llx mask_b 0x%016llx gddr6_id 0x%04x vendor 0x%x revision 0x%x\n",
+		board_id, board_mask_a, board_mask_b, gddr6_id, gddr6_vendor,
+		gddr6_revision);
+
+	if (board_mask_a == BOARD_SANCARLO_1 || board_mask_a == BOARD_SANCARLO_2) {
+		board_name = "Sancarlo";
+		param = autoservo_param_sancarlo;
+	} else if (board_mask_a == BOARD_A_EIGER_1 || board_mask_a == BOARD_A_EIGER_2) {
+		board_name = "A-Eiger";
+		switch (gddr6_vendor) {
+		case GDDR6_SAMSUNG:
+			gddr6_name = "Samsung";
+			param = autoservo_param_a_eiger_samsung;
+			break;
+		case GDDR6_HYNIX:
+			gddr6_name = "Hynix";
+			param = autoservo_param_a_eiger_hynix;
+			break;
+		case GDDR6_MICRON:
+			gddr6_name = "Micron";
+			param = autoservo_param_a_eiger_micron;
+			break;
+		default:
+			pr_info("FanServo: %s Unknown Vendor 0x%x\n", board_name, gddr6_vendor);
+			goto not_updated;
+		}
+	} else if (board_mask_a == BOARD_A_DENALI_1 || board_mask_a == BOARD_A_DENALI_2) {
+		board_name = "A-Denali";
+		switch (gddr6_vendor) {
+		case GDDR6_SAMSUNG:
+			gddr6_name = "Samsung";
+			param = autoservo_param_a_denali_samsung;
+			break;
+		case GDDR6_HYNIX:
+			gddr6_name = "Hynix";
+			param = autoservo_param_a_denali_hynix;
+			break;
+		case GDDR6_MICRON:
+			gddr6_name = "Micron";
+			param = autoservo_param_a_denali_micron;
+			break;
+		default:
+			pr_info("FanServo: %s Unknown Vendor 0x%x\n", board_name, gddr6_vendor);
+			goto not_updated;
+		}
+	} else if (board_mask_b == BOARD_B_EIGER_DENALI_1 || board_mask_b == BOARD_B_EIGER_DENALI_2) {
+		board_name = "B-Eiger/Denali";
+		if (gddr6_vendor == GDDR6_SAMSUNG && gddr6_revision == 8) {
+			gddr6_name = "Samsung D1x";
+			param = autoservo_param_b_eiger_denali_samsung_d1x;
+		} else if (gddr6_vendor == GDDR6_SAMSUNG && gddr6_revision == 9) {
+			gddr6_name = "Samsung D1z";
+			param = NULL;
+		} else if (gddr6_vendor == GDDR6_HYNIX && gddr6_revision == 0) {
+			gddr6_name = "Hynix 1x";
+			param = autoservo_param_b_eiger_denali_hynix_1x_micron_120s;
+		} else if (gddr6_vendor == GDDR6_HYNIX && gddr6_revision == 1) {
+			gddr6_name = "Hynix 1y";
+			param = autoservo_param_b_eiger_denali_hynix_1y_micron_130s;
+		} else if (gddr6_vendor == GDDR6_MICRON && gddr6_revision == 0) {
+			gddr6_name = "Micron 120s";
+			param = autoservo_param_b_eiger_denali_hynix_1x_micron_120s;
+		} else if (gddr6_vendor == GDDR6_MICRON && gddr6_revision == 1) {
+			gddr6_name = "Micron 130s";
+			param = autoservo_param_b_eiger_denali_hynix_1y_micron_130s;
+		} else {
+			pr_info("FanServo: %s Unknown Vendor/Revision 0x%x/0x%x\n", board_name, gddr6_vendor, gddr6_revision);
+			goto not_updated;
+		}
+	} else if (board_mask_b == BOARD_D_EIGER_DENALI_1 || board_mask_b == BOARD_D_EIGER_DENALI_2) {
+		board_name = "D-Eiger/Denali";
+		if (gddr6_vendor == GDDR6_SAMSUNG && gddr6_revision == 9) {
+			gddr6_name = "Samsung D1z";
+			param = autoservo_param_d_eiger_denali_samsung_d1z;
+		} else if (gddr6_vendor == GDDR6_HYNIX && gddr6_revision == 1) {
+			gddr6_name = "Hynix 1y";
+			param = autoservo_param_d_eiger_denali_hynix_1y;
+		} else if (gddr6_vendor == GDDR6_MICRON && gddr6_revision == 1) {
+			gddr6_name = "Micron 130s";
+			param = autoservo_param_d_eiger_denali_micron_130s_y31j;
+		} else if (gddr6_vendor == GDDR6_MICRON && gddr6_revision == 2) {
+			gddr6_name = "Micron Y31J";
+			param = autoservo_param_d_eiger_denali_micron_130s_y31j;
+		} else {
+			pr_info("FanServo: %s Unknown Vendor/Revision 0x%x/0x%x\n", board_name, gddr6_vendor, gddr6_revision);
+			goto not_updated;
+		}
+	} else {
+		pr_info("FanServo: 0x%016llX\n", board_id);
+		goto not_updated;
+	}
+
+	if (gddr6_name)
+		pr_info("FanServo: %s %s\n", board_name, gddr6_name);
+	else
+		pr_info("FanServo: %s\n", board_name);
+
+	if (!param)
+		goto not_updated;
+
+	ret = icc_fan_update_param(param);
+	if (ret)
+		pr_err("Error: %s: %d\n", __func__, ret);
+
+	return ret;
+
+not_updated:
+	pr_info("FanServo: Not update\n");
+	return 0;
+}
+EXPORT_SYMBOL(icc_fan_update_autoservo_param);
+
+static inline struct ps5_fan_curve ps5_fan_default_curve(void)
+{
+	return ps5_fan_quiet_default;
+}
+
+static inline struct ps5_fan_curve ps5_fan_board_curve(unsigned int minimum_pwm)
+{
+	struct ps5_fan_curve curve = ps5_fan_default_curve();
+	int i;
+
+	if (minimum_pwm > 255)
+		minimum_pwm = 255;
+	for (i = 0; i < PS5_CURVE_POINTS; i++)
+		if (curve.pwm[i] < minimum_pwm)
+			curve.pwm[i] = minimum_pwm;
+	return curve;
+}
+
+static inline int ps5_fan_curve_valid(const struct ps5_fan_curve *curve)
+{
+	int i;
+
+	if (curve->stop_temp < 0 || curve->stop_temp >= curve->temp[0])
+		return -EINVAL;
+	for (i = 0; i < PS5_CURVE_POINTS; i++) {
+		if (curve->temp[i] < 0 ||
+		    curve->temp[i] > PS5_FAN_EMERGENCY_MC ||
+		    curve->pwm[i] > 255)
+			return -EINVAL;
+		if (i && (curve->temp[i] <= curve->temp[i - 1] ||
+			  curve->pwm[i] < curve->pwm[i - 1]))
+			return -EINVAL;
+	}
+	return curve->pwm[PS5_CURVE_POINTS - 1] == 255 ? 0 : -EINVAL;
+}
+
+static inline unsigned int
+ps5_fan_interpolate(const struct ps5_fan_curve *curve, int temp)
+{
+	int i;
+
+	if (temp <= curve->temp[0])
+		return curve->pwm[0];
+	for (i = 1; i < PS5_CURVE_POINTS; i++) {
+		if (temp <= curve->temp[i]) {
+			unsigned int span = curve->temp[i] - curve->temp[i - 1];
+			unsigned int rise = curve->pwm[i] - curve->pwm[i - 1];
+
+			return curve->pwm[i - 1] +
+			       (rise * (temp - curve->temp[i - 1]) + span / 2) /
+				       span;
+		}
+	}
+	return 255;
+}
+
+static inline unsigned int ps5_fan_auto_pwm(const struct ps5_fan_curve *curve,
+					    int raw_temp, int filtered_temp,
+					    bool *running)
+{
+	if (raw_temp < curve->stop_temp)
+		*running = false;
+	else if (raw_temp >= curve->temp[0])
+		*running = true;
+	if (!*running)
+		return 0;
+	return ps5_fan_interpolate(curve, filtered_temp);
+}
+
+static inline unsigned int ps5_fan_slew(unsigned int wanted,
+					unsigned int previous)
+{
+	if (wanted > previous && wanted - previous > 26)
+		return previous + 26;
+	if (wanted < previous && previous - wanted > 13)
+		return previous - 13;
+	return wanted;
+}
+
+static inline unsigned int ps5_pwm_to_duty(unsigned int pwm)
+{
+	return (pwm * 1024 + 127) / 255;
+}
+
+static inline unsigned int ps5_duty_to_pwm(unsigned int duty)
+{
+	return (duty * 255 + 512) / 1024;
+}
+
+#define PS5_SERVO_SIZE 0x6ae
+#define PS5_CONTROL_INTERVAL msecs_to_jiffies(500)
+#define PS5_PWM_FULL 0
+#define PS5_PWM_MANUAL 1
+#define PS5_PWM_AUTO 2
+
+struct ps5_fan_data {
+	struct device *dev;
+
+	struct mutex lock;
+	struct delayed_work work;
+	struct ps5_fan_curve curve;
+	struct ps5_fan_curve default_curve;
+	u8 original[PS5_SERVO_SIZE];
+	u8 backup[PS5_SERVO_SIZE];
+	int temp[4];
+	int temp_error[4];
+	int filtered_temp;
+	unsigned int enable;
+	unsigned int manual_pwm;
+	unsigned int requested_pwm;
+	int wire_mode;
+	bool running;
+	bool filtered_valid;
+	bool fault;
+	bool emergency;
+	bool suspended;
+};
+
+static int ps5_fan_message(u8 service, u16 type, u16 length,
+			   const void *request, size_t request_size,
+			   void *reply, size_t reply_size)
+{
+	u8 *buf = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	struct icc_msg *msg;
+	int ret;
+
+	if (!buf)
+		return -ENOMEM;
+	msg = (struct icc_msg *)buf;
+	msg->service_id = service;
+	msg->msg_type = type;
+	msg->length = length;
+	if (request_size)
+		memcpy(msg->data, request, request_size);
+	ret = icc_query(buf, buf);
+	if (ret)
+		pr_warn_ratelimited("ps5_fan: icc svc 0x%x type 0x%x query failed: %d\n",
+				    service, type, ret);
+	if (!ret && (msg->length < 0x10 || msg->length > ICC_MSG_MAX_SIZE)) {
+		pr_warn_ratelimited("ps5_fan: icc svc 0x%x type 0x%x bad reply length 0x%x\n",
+				    service, type, msg->length);
+		ret = -EPROTO;
+	}
+	if (!ret && get_unaligned_le16(msg->data)) {
+		pr_warn_ratelimited("ps5_fan: icc svc 0x%x type 0x%x status 0x%x\n",
+				    service, type, get_unaligned_le16(msg->data));
+		ret = -EIO;
+	}
+	if (!ret && reply_size) {
+		if (msg->length < 0xc + reply_size) {
+			pr_warn_ratelimited("ps5_fan: icc svc 0x%x type 0x%x short reply 0x%x < 0x%zx\n",
+					    service, type, msg->length,
+					    0xc + reply_size);
+			ret = -EPROTO;
+		} else {
+			memcpy(reply, msg->data, reply_size);
+		}
+	}
+	kfree(buf);
+	return ret;
+}
+
+static int ps5_fan_read_temp(unsigned int zone, int *temp)
+{
+	u8 request[4] = { zone };
+	u8 reply[4];
+	int raw, ret;
+
+	ret = ps5_fan_message(0xb, 1, 0x20, request, sizeof(request), reply,
+			      sizeof(reply));
+	if (ret)
+		return ret;
+	raw = (s16)get_unaligned_le16(reply + 2);
+	if (raw < 0 || raw >= 125 * 256)
+		return -ENODATA;
+	*temp = DIV_ROUND_CLOSEST(raw * 1000, 256);
+	return 0;
+}
+
+static int ps5_fan_read_duty(unsigned int *duty)
+{
+	u8 reply[4];
+	int ret = ps5_fan_message(0xa, 1, 0x20, NULL, 0, reply, sizeof(reply));
+
+	if (ret)
+		return ret;
+	*duty = get_unaligned_le16(reply + 2);
+	return *duty <= 1024 ? 0 : -EPROTO;
+}
+
+static int ps5_fan_set_mode(struct ps5_fan_data *data, int mode)
+{
+	u8 request[4] = { 0, mode };
+	int ret;
+
+	if (data->wire_mode == mode)
+		return 0;
+	ret = ps5_fan_message(0xa, 2, 0x20, request, sizeof(request), NULL, 0);
+	if (!ret)
+		data->wire_mode = mode;
+	return ret;
+}
+
+static int ps5_fan_write_pwm(struct ps5_fan_data *data, unsigned int pwm)
+{
+	u8 request[4] = {};
+	int ret = ps5_fan_set_mode(data, PS5_FAN_MODE_MANUAL);
+
+	if (ret)
+		return ret;
+	put_unaligned_le16(ps5_pwm_to_duty(pwm), request + 2);
+	ret = ps5_fan_message(0xa, 4, 0x20, request, sizeof(request), NULL, 0);
+	if (!ret)
+		data->requested_pwm = pwm;
+	return ret;
+}
+
+static void ps5_fan_prepare_backup(struct ps5_fan_data *data)
+{
+	int block, zone, field;
+
+	memcpy(data->backup, data->original, PS5_SERVO_SIZE);
+	for (block = 0; block < 4; block++) {
+		u8 *head = data->backup + block * 0x160;
+		u8 *record = head + 0x20;
+
+		for (zone = 1; zone < 4; zone++)
+			put_unaligned_le16(0, head + zone * 4 + 2);
+
+		put_unaligned_le16(1024, head);
+		if (get_unaligned_le16(head + 2) < 103)
+			put_unaligned_le16(103, head + 2);
+		put_unaligned_le16(1024, head + 0x10);
+		for (field = 0; field < ARRAY_SIZE(ps5_fan_quiet_servo);
+		     field++)
+			put_unaligned_le32(
+				ps5_fan_quiet_servo[field].value,
+				record + ps5_fan_quiet_servo[field].offset);
+	}
+
+	put_unaligned_le16(0, data->backup + 0x583);
+}
+
+static bool ps5_fan_on_viola(void)
+{
+	struct pci_dev *pdev = NULL;
+
+	while ((pdev = pci_get_device(PCI_VENDOR_ID_ATI, PCI_ANY_ID, pdev))) {
+		if (ps5_is_viola(pdev->device)) {
+			pci_dev_put(pdev);
+			return true;
+		}
+	}
+	return false;
+}
+
+/*
+ * The PS5 Pro hands over with the MainSoC zone in manual mode. Nothing else
+ * drives the fan, so return it to firmware auto.
+ */
+static int ps5_fan_reclaim_mainsoc(struct ps5_fan_data *data, u8 mode)
+{
+	u8 request[4] = { PS5_ZONE_MAINSOC };
+	u8 reply[4];
+	int ret;
+
+	dev_info(data->dev,
+		 "MainSoC fan zone left in mode %u, returning it to auto\n",
+		 mode);
+	data->wire_mode = -1;
+	ret = ps5_fan_set_mode(data, PS5_FAN_MODE_AUTO);
+	if (!ret)
+		ret = ps5_fan_message(0xa, 3, 0x20, request, sizeof(request),
+				      reply, sizeof(reply));
+	if (!ret && reply[2] != PS5_FAN_MODE_AUTO)
+		ret = -EBUSY;
+	if (ret)
+		dev_err(data->dev,
+			"cannot return MainSoC fan zone to auto: %d\n", ret);
+	return ret;
+}
+
+static int ps5_fan_snapshot(struct ps5_fan_data *data)
+{
+	u8 *reply = kzalloc(PS5_SERVO_SIZE + 4, GFP_KERNEL);
+	u8 request[4] = {};
+	u8 mode[4];
+	int ret, zone;
+
+	if (!reply)
+		return -ENOMEM;
+	ret = ps5_fan_message(0xa, 0xf, 0x20, NULL, 0, reply,
+			      PS5_SERVO_SIZE + 4);
+	if (!ret)
+		memcpy(data->original, reply + 4, PS5_SERVO_SIZE);
+	kfree(reply);
+	dev_info(data->dev, "servo table read: %d\n", ret);
+	for (zone = 0; !ret && zone < 4; zone++) {
+		request[0] = zone;
+		ret = ps5_fan_message(0xa, 3, 0x20, request, sizeof(request),
+				      mode, sizeof(mode));
+		dev_info(data->dev, "zone %d mode %u ret %d\n", zone,
+			 ret ? 0 : mode[2], ret);
+		if (ret || mode[2] == PS5_FAN_MODE_AUTO)
+			continue;
+		if (zone == PS5_ZONE_MAINSOC && ps5_fan_on_viola())
+			ret = ps5_fan_reclaim_mainsoc(data, mode[2]);
+		else
+			ret = -EBUSY;
+	}
+	if (ret)
+		dev_err(data->dev, "snapshot failed: %d\n", ret);
+	return ret;
+}
+
+static void ps5_fan_fallback(struct ps5_fan_data *data)
+{
+	int ret;
+
+	data->fault = true;
+	data->wire_mode = -1;
+	ret = ps5_fan_set_mode(data, PS5_FAN_MODE_AUTO);
+	if (ret)
+		dev_err_ratelimited(data->dev,
+				    "cannot restore firmware auto mode: %d\n",
+				    ret);
+}
+
+static int ps5_fan_update_locked(struct ps5_fan_data *data)
+{
+	unsigned int pwm;
+	int ret;
+
+	data->temp_error[0] = ps5_fan_read_temp(0, &data->temp[0]);
+	ret = data->temp_error[0];
+	if (ret && data->enable == PS5_PWM_FULL) {
+		data->fault = true;
+		return ps5_fan_set_mode(data, PS5_FAN_MODE_MAXIMUM);
+	}
+	if (ret)
+		goto failed;
+	if (!data->filtered_valid) {
+		data->filtered_temp = data->temp[0];
+		data->filtered_valid = true;
+	} else {
+		data->filtered_temp =
+			(3 * data->filtered_temp + data->temp[0]) / 4;
+	}
+	if (data->temp[0] >= PS5_FAN_EMERGENCY_MC) {
+		data->emergency = true;
+		data->enable = PS5_PWM_AUTO;
+	} else if (data->temp[0] < PS5_FAN_EMERGENCY_MC - 5000) {
+		data->emergency = false;
+	}
+	if (data->enable == PS5_PWM_FULL || data->emergency) {
+		ret = ps5_fan_set_mode(data, PS5_FAN_MODE_MAXIMUM);
+		if (ret)
+			goto failed;
+		data->requested_pwm = 255;
+	} else {
+		if (data->enable == PS5_PWM_MANUAL) {
+			pwm = data->manual_pwm;
+		} else {
+
+			pwm = ps5_fan_auto_pwm(&data->curve, data->temp[0],
+					       data->temp[0] >= 80000 ?
+						       data->temp[0] :
+						       data->filtered_temp,
+					       &data->running);
+			pwm = ps5_fan_slew(pwm, data->requested_pwm);
+		}
+		ret = ps5_fan_write_pwm(data, pwm);
+		if (ret)
+			goto failed;
+	}
+	data->fault = false;
+	return 0;
+failed:
+	dev_warn_ratelimited(data->dev,
+			     "fan control failed (%d); using firmware auto\n",
+			     ret);
+	ps5_fan_fallback(data);
+	return ret;
+}
+
+static void ps5_fan_control_work(struct work_struct *work)
+{
+	struct ps5_fan_data *data =
+		container_of(to_delayed_work(work), struct ps5_fan_data, work);
+
+	mutex_lock(&data->lock);
+	if (!data->suspended) {
+		ps5_fan_update_locked(data);
+		schedule_delayed_work(&data->work, PS5_CONTROL_INTERVAL);
+	}
+	mutex_unlock(&data->lock);
+}
+
+static umode_t ps5_fan_hwmon_visible(const void *drvdata,
+				     enum hwmon_sensor_types type, u32 attr,
+				     int channel)
+{
+	if (type == hwmon_pwm)
+		return 0644;
+	if (type == hwmon_temp)
+		return 0444;
+	return 0;
+}
+
+static int ps5_fan_hwmon_read(struct device *dev, enum hwmon_sensor_types type,
+			      u32 attr, int channel, long *value)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	unsigned int duty;
+	int ret = 0;
+
+	mutex_lock(&data->lock);
+	if (type == hwmon_pwm && attr == hwmon_pwm_enable) {
+		*value = data->enable;
+	} else if (type == hwmon_pwm && attr == hwmon_pwm_input) {
+		ret = ps5_fan_read_duty(&duty);
+		if (!ret)
+			*value = ps5_duty_to_pwm(duty);
+	} else if (type == hwmon_temp && attr == hwmon_temp_input) {
+		ret = ps5_fan_read_temp(channel, &data->temp[channel]);
+		data->temp_error[channel] = ret;
+		if (!ret)
+			*value = data->temp[channel];
+	} else if (type == hwmon_temp && attr == hwmon_temp_fault) {
+		*value = !!data->temp_error[channel];
+	} else {
+		ret = -EOPNOTSUPP;
+	}
+	mutex_unlock(&data->lock);
+	return ret;
+}
+
+static int ps5_fan_hwmon_read_string(struct device *dev,
+				     enum hwmon_sensor_types type, u32 attr,
+				     int channel, const char **value)
+{
+	static const char *const labels[] = { "MainSoC", "Local1", "Local2",
+					      "Local3" };
+
+	if (type != hwmon_temp || attr != hwmon_temp_label)
+		return -EOPNOTSUPP;
+	*value = labels[channel];
+	return 0;
+}
+
+static int ps5_fan_hwmon_write(struct device *dev, enum hwmon_sensor_types type,
+			       u32 attr, int channel, long value)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	unsigned int duty;
+	int ret = 0;
+
+	if (type != hwmon_pwm)
+		return -EOPNOTSUPP;
+	mutex_lock(&data->lock);
+	if (data->suspended) {
+		ret = -EBUSY;
+		goto out;
+	}
+	if (attr == hwmon_pwm_enable) {
+		if (value < 0 || value > PS5_PWM_AUTO) {
+			ret = -EINVAL;
+			goto out;
+		}
+		if (data->emergency && value == PS5_PWM_MANUAL) {
+			ret = -EBUSY;
+			goto out;
+		}
+		if (value == PS5_PWM_MANUAL) {
+			ret = ps5_fan_read_duty(&duty);
+			if (ret)
+				goto out;
+			data->manual_pwm = ps5_duty_to_pwm(duty);
+		}
+		data->enable = value;
+	} else if (attr == hwmon_pwm_input) {
+		if (value < 0 || value > 255) {
+			ret = -EINVAL;
+			goto out;
+		}
+		if (data->enable != PS5_PWM_MANUAL) {
+			ret = -EBUSY;
+			goto out;
+		}
+		data->manual_pwm = value;
+	} else {
+		ret = -EOPNOTSUPP;
+		goto out;
+	}
+	ret = ps5_fan_update_locked(data);
+out:
+	mutex_unlock(&data->lock);
+	return ret;
+}
+
+static const struct hwmon_ops ps5_fan_hwmon_ops = {
+	.is_visible = ps5_fan_hwmon_visible,
+	.read = ps5_fan_hwmon_read,
+	.read_string = ps5_fan_hwmon_read_string,
+	.write = ps5_fan_hwmon_write,
+};
+
+static const struct hwmon_channel_info *const ps5_fan_hwmon_channels[] = {
+	HWMON_CHANNEL_INFO(pwm, HWMON_PWM_INPUT | HWMON_PWM_ENABLE),
+	HWMON_CHANNEL_INFO(temp, HWMON_T_INPUT | HWMON_T_LABEL | HWMON_T_FAULT,
+			   HWMON_T_INPUT | HWMON_T_LABEL | HWMON_T_FAULT,
+			   HWMON_T_INPUT | HWMON_T_LABEL | HWMON_T_FAULT,
+			   HWMON_T_INPUT | HWMON_T_LABEL | HWMON_T_FAULT),
+	NULL,
+};
+
+static const struct hwmon_chip_info ps5_fan_chip_info = {
+	.ops = &ps5_fan_hwmon_ops,
+	.info = ps5_fan_hwmon_channels,
+};
+
+static ssize_t ps5_curve_show(struct device *dev, struct device_attribute *attr,
+			      char *buf)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	struct sensor_device_attribute_2 *point = to_sensor_dev_attr_2(attr);
+	unsigned int value;
+
+	mutex_lock(&data->lock);
+	if (point->nr == 0)
+		value = data->curve.temp[point->index];
+	else if (point->nr == 1)
+		value = data->curve.pwm[point->index];
+	else
+		value = data->curve.stop_temp;
+	mutex_unlock(&data->lock);
+	return sysfs_emit(buf, "%u\n", value);
+}
+
+static ssize_t ps5_curve_store(struct device *dev,
+			       struct device_attribute *attr, const char *buf,
+			       size_t count)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	struct sensor_device_attribute_2 *point = to_sensor_dev_attr_2(attr);
+	struct ps5_fan_curve candidate;
+	unsigned int value;
+	int ret;
+
+	if (kstrtouint(buf, 10, &value))
+		return -EINVAL;
+	if (value > PS5_FAN_EMERGENCY_MC)
+		return -ERANGE;
+	mutex_lock(&data->lock);
+	candidate = data->curve;
+	if (point->nr == 0)
+		candidate.temp[point->index] = value;
+	else if (point->nr == 1)
+		candidate.pwm[point->index] = value;
+	else
+		candidate.stop_temp = value;
+	ret = ps5_fan_curve_valid(&candidate);
+	if (!ret)
+		data->curve = candidate;
+	mutex_unlock(&data->lock);
+	return ret ? ret : count;
+}
+
+static ssize_t curve_reset_store(struct device *dev,
+				 struct device_attribute *attr, const char *buf,
+				 size_t count)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	unsigned int value;
+
+	if (kstrtouint(buf, 10, &value) || value != 1)
+		return -EINVAL;
+	mutex_lock(&data->lock);
+	data->curve = data->default_curve;
+	data->running = data->temp[0] >= data->curve.temp[0];
+	data->filtered_valid = false;
+	mutex_unlock(&data->lock);
+	return count;
+}
+static DEVICE_ATTR_WO(curve_reset);
+
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point1_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 0);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point1_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 0);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point2_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 1);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point2_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 1);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point3_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 2);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point3_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 2);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point4_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 3);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point4_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 3);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point5_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 4);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point5_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 4);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point6_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 5);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point6_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 5);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point7_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 6);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point7_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 6);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point8_temp, 0644, ps5_curve_show,
+			    ps5_curve_store, 0, 7);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point8_pwm, 0644, ps5_curve_show,
+			    ps5_curve_store, 1, 7);
+static SENSOR_DEVICE_ATTR_2(pwm1_auto_point1_temp_hyst, 0644, ps5_curve_show,
+			    ps5_curve_store, 2, 0);
+
+#define PS5_CURVE_ATTRS(n)                                        \
+	&sensor_dev_attr_pwm1_auto_point##n##_temp.dev_attr.attr, \
+		&sensor_dev_attr_pwm1_auto_point##n##_pwm.dev_attr.attr
+static struct attribute *ps5_curve_attrs[] = {
+	PS5_CURVE_ATTRS(1),
+	PS5_CURVE_ATTRS(2),
+	PS5_CURVE_ATTRS(3),
+	PS5_CURVE_ATTRS(4),
+	PS5_CURVE_ATTRS(5),
+	PS5_CURVE_ATTRS(6),
+	PS5_CURVE_ATTRS(7),
+	PS5_CURVE_ATTRS(8),
+	&sensor_dev_attr_pwm1_auto_point1_temp_hyst.dev_attr.attr,
+	&dev_attr_curve_reset.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(ps5_curve);
+
+static void ps5_fan_hwmon_cleanup(void *arg)
+{
+	struct ps5_fan_data *data = arg;
+	int ret;
+
+	mutex_lock(&data->lock);
+	data->suspended = true;
+	mutex_unlock(&data->lock);
+	cancel_delayed_work_sync(&data->work);
+	ret = icc_fan_update_param(data->original);
+	data->wire_mode = -1;
+	if (ps5_fan_set_mode(data, PS5_FAN_MODE_AUTO) || ret)
+		dev_err(data->dev,
+			"original fan state could not be fully restored\n");
+}
+
+static int ps5_fan_hwmon_probe(struct platform_device *pdev)
+{
+	struct ps5_fan_data *data;
+	struct device *hwmon;
+	unsigned int duty;
+	int ret;
+
+	data = devm_kzalloc(&pdev->dev, sizeof(*data), GFP_KERNEL);
+	if (!data)
+		return -ENOMEM;
+	data->dev = &pdev->dev;
+	data->curve = ps5_fan_default_curve();
+	data->enable = PS5_PWM_AUTO;
+	data->wire_mode = -1;
+	mutex_init(&data->lock);
+	INIT_DELAYED_WORK(&data->work, ps5_fan_control_work);
+	dev_info(&pdev->dev, "probe: viola %d\n", ps5_fan_on_viola());
+	ret = ps5_fan_read_temp(0, &data->temp[0]);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "MainSoC temperature unavailable\n");
+	dev_info(&pdev->dev, "MainSoC temp %d mC\n", data->temp[0]);
+	ret = ps5_fan_snapshot(data);
+	if (ret)
+		return ret;
+	duty = get_unaligned_le16(data->original + 2);
+	data->default_curve = ps5_fan_board_curve(ps5_duty_to_pwm(duty));
+	data->curve = data->default_curve;
+	dev_info(&pdev->dev, "servo duty 0x%04x pwm %u\n", duty,
+		 ps5_duty_to_pwm(duty));
+	ps5_fan_prepare_backup(data);
+	ret = icc_fan_update_param(data->backup);
+	dev_info(&pdev->dev, "quiet servo table upload: %d\n", ret);
+	if (ret) {
+		icc_fan_update_param(data->original);
+		return ret;
+	}
+	ret = devm_add_action_or_reset(&pdev->dev, ps5_fan_hwmon_cleanup, data);
+	if (ret)
+		return ret;
+	platform_set_drvdata(pdev, data);
+	ret = ps5_fan_read_duty(&duty);
+	dev_info(&pdev->dev, "current duty 0x%04x ret %d\n", duty, ret);
+	if (ret)
+		return ret;
+	data->requested_pwm = ps5_duty_to_pwm(duty);
+	ret = ps5_fan_update_locked(data);
+	if (ret) {
+		dev_err(&pdev->dev, "first fan update failed: %d\n", ret);
+		return ret;
+	}
+	hwmon = devm_hwmon_device_register_with_info(&pdev->dev, "ps5_fan",
+						     data, &ps5_fan_chip_info,
+						     ps5_curve_groups);
+	if (IS_ERR(hwmon))
+		return PTR_ERR(hwmon);
+	schedule_delayed_work(&data->work, PS5_CONTROL_INTERVAL);
+	dev_info(&pdev->dev, "quiet fan curve enabled; configure through %s\n",
+		 dev_name(hwmon));
+	return 0;
+}
+
+static int ps5_fan_hwmon_suspend(struct device *dev)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&data->lock);
+	data->suspended = true;
+	mutex_unlock(&data->lock);
+	cancel_delayed_work_sync(&data->work);
+	mutex_lock(&data->lock);
+	data->wire_mode = -1;
+	ret = ps5_fan_set_mode(data, PS5_FAN_MODE_AUTO);
+	mutex_unlock(&data->lock);
+	if (ret) {
+		mutex_lock(&data->lock);
+		data->suspended = false;
+		mutex_unlock(&data->lock);
+		schedule_delayed_work(&data->work, PS5_CONTROL_INTERVAL);
+	}
+	return ret;
+}
+
+static int ps5_fan_hwmon_resume(struct device *dev)
+{
+	struct ps5_fan_data *data = dev_get_drvdata(dev);
+	int ret;
+
+	mutex_lock(&data->lock);
+	ret = icc_fan_update_param(data->backup);
+	data->wire_mode = -1;
+	data->filtered_valid = false;
+	data->suspended = false;
+	if (!ret)
+		ret = ps5_fan_update_locked(data);
+	else
+		ps5_fan_fallback(data);
+	mutex_unlock(&data->lock);
+	schedule_delayed_work(&data->work, PS5_CONTROL_INTERVAL);
+	return ret;
+}
+
+static const struct dev_pm_ops ps5_fan_hwmon_pm_ops = {
+	.suspend = ps5_fan_hwmon_suspend,
+	.resume = ps5_fan_hwmon_resume,
+	.freeze = ps5_fan_hwmon_suspend,
+	.thaw = ps5_fan_hwmon_resume,
+	.poweroff = ps5_fan_hwmon_suspend,
+	.restore = ps5_fan_hwmon_resume,
+};
+
+static void ps5_fan_hwmon_shutdown(struct platform_device *pdev)
+{
+	struct ps5_fan_data *data = platform_get_drvdata(pdev);
+
+	mutex_lock(&data->lock);
+	data->suspended = true;
+	mutex_unlock(&data->lock);
+	cancel_delayed_work_sync(&data->work);
+	mutex_lock(&data->lock);
+	data->wire_mode = -1;
+	if (ps5_fan_set_mode(data, PS5_FAN_MODE_AUTO))
+		dev_warn(data->dev,
+			 "firmware auto handoff failed during shutdown\n");
+	mutex_unlock(&data->lock);
+}
+
+static int ps5_fan_probe(struct platform_device *pdev)
+{
+	int ret = icc_fan_update_autoservo_param();
+
+	dev_info(&pdev->dev, "autoservo param load: %d\n", ret);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret,
+				     "autoservo param load failed\n");
+	return ps5_fan_hwmon_probe(pdev);
+}
+
+static struct platform_driver ps5_fan_driver = {
+	.probe  = ps5_fan_probe,
+	.shutdown = ps5_fan_hwmon_shutdown,
+	.driver = {
+		.name = "ps5-fan",
+		.pm = &ps5_fan_hwmon_pm_ops,
+	},
+};
+
+static struct platform_device *ps5_fan_pdev;
+
+static int __init ps5_fan_init(void)
+{
+	int ret = platform_driver_register(&ps5_fan_driver);
+
+	if (ret)
+		return ret;
+
+	ps5_fan_pdev = platform_device_register_simple("ps5-fan", -1, NULL, 0);
+	if (IS_ERR(ps5_fan_pdev)) {
+		ret = PTR_ERR(ps5_fan_pdev);
+		platform_driver_unregister(&ps5_fan_driver);
+		ps5_fan_pdev = NULL;
+		return ret;
+	}
+	return 0;
+}
+
+static void __exit ps5_fan_exit(void)
+{
+	if (ps5_fan_pdev)
+		platform_device_unregister(ps5_fan_pdev);
+	platform_driver_unregister(&ps5_fan_driver);
+}
+
+module_init(ps5_fan_init);
+module_exit(ps5_fan_exit);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("PS5 fan hwmon driver");
+MODULE_ALIAS("platform:ps5-fan");
diff --git a/drivers/ps5/frl-detect.inc b/drivers/ps5/frl-detect.inc
new file mode 100644
index 000000000000..e7f1b56d404a
--- /dev/null
+++ b/drivers/ps5/frl-detect.inc
@@ -0,0 +1,224 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * EDID inputs for the 4K120 decision, and the decision itself. No IC access.
+ */
+
+/* YCbCr 4:2:2 in any CTA block. DRM keeps only the last block's flags. */
+static bool edid_cta_ycbcr422(const u8 *edid, size_t size)
+{
+	size_t off;
+
+	for (off = EDID_LENGTH; off + EDID_LENGTH <= size; off += EDID_LENGTH)
+		if (edid[off] == 0x02 && edid[off + 3] & 0x10)
+			return true;
+	return false;
+}
+
+static bool edid_cta_ycbcr444(const u8 *edid, size_t size)
+{
+	size_t off;
+
+	for (off = EDID_LENGTH; off + EDID_LENGTH <= size; off += EDID_LENGTH)
+		if (edid[off] == 0x02 && edid[off + 3] & 0x20)
+			return true;
+	return false;
+}
+
+#define Y420_ONLY BIT(0)
+#define Y420_ALSO BIT(1)
+#define Y420_NORMAL BIT(2)
+
+static u8 edid_svd_vic(u8 svd)
+{
+	return (svd <= 64 || (svd >= 129 && svd <= 192)) ? svd & 127 : svd;
+}
+
+/* A capability map indexes the VDBs in its own CTA extension. */
+static void edid_cta_y420(const u8 *edid, size_t size, u8 modes[256])
+{
+	size_t off, i, j;
+
+	memset(modes, 0, 256);
+	if (size < EDID_LENGTH)
+		return;
+	size = min(size, (size_t)(edid[126] + 1) * EDID_LENGTH);
+	for (off = EDID_LENGTH; off + EDID_LENGTH <= size; off += EDID_LENGTH) {
+		const u8 *blk = edid + off;
+		u8 vics[123], count = 0, sum = 0, end = blk[2];
+
+		if (blk[0] != 2 || blk[1] < 3 || end < 4 || end > 127)
+			continue;
+		for (i = 0; i < EDID_LENGTH; i++)
+			sum += blk[i];
+		if (sum)
+			continue;
+		/* Validate the complete collection before granting any capabilities. */
+		for (i = 4; i < end; i += 1 + (blk[i] & 31))
+			if (i + 1 + (blk[i] & 31) > end)
+				break;
+		if (i != end)
+			continue;
+		for (i = 4; i < end; i += 1 + (blk[i] & 31)) {
+			u8 tag = blk[i] >> 5, len = blk[i] & 31;
+
+			if (tag == 2)
+				for (j = 1; j <= len; j++) {
+					u8 vic = edid_svd_vic(blk[i + j]);
+
+					vics[count++] = vic;
+					modes[vic] |= Y420_NORMAL;
+				}
+			if (tag == 7 && len >= 1 && blk[i + 1] == 0x0e)
+				for (j = 2; j <= len; j++)
+					modes[edid_svd_vic(blk[i + j])] |= Y420_ONLY;
+		}
+		for (i = 4; i < end; i += 1 + (blk[i] & 31)) {
+			u8 len = blk[i] & 31;
+
+			if (blk[i] >> 5 != 7 || len < 1 || blk[i + 1] != 0x0f)
+				continue;
+			for (j = 0; j < count; j++)
+				if (len == 1 || (j / 8 < len - 1 &&
+						blk[i + 2 + j / 8] & BIT(j % 8)))
+					modes[vics[j]] |= Y420_ALSO;
+		}
+	}
+	for (i = 0; i < 256; i++) {
+		if (modes[i] & Y420_ONLY && modes[i] & Y420_NORMAL)
+			modes[i] |= Y420_ALSO;
+		modes[i] &= modes[i] & Y420_NORMAL ? Y420_ALSO : Y420_ONLY | Y420_ALSO;
+	}
+	modes[0] = 0;
+}
+
+/* Max_FRL_Rate and DSC_Max_FRL_Rate of the HF-VSDB or HF-SCDB, for the log. */
+static void edid_hf_frl(const u8 *edid, size_t size, u8 *max_frl, u8 *dsc_frl)
+{
+	size_t off, i;
+
+	*max_frl = *dsc_frl = 0;
+	for (off = EDID_LENGTH; off + EDID_LENGTH <= size; off += EDID_LENGTH) {
+		const u8 *blk = edid + off;
+		u8 end = blk[2];
+
+		if (blk[0] != 0x02 || end > EDID_LENGTH - 1)
+			continue;
+		for (i = 4; i < end; i += 1 + (blk[i] & 0x1f)) {
+			u8 tag = blk[i] >> 5, len = blk[i] & 0x1f;
+			bool vsdb, scdb;
+
+			if (i + 1 + len > end)
+				break;
+			if (len < 7)
+				continue;
+			vsdb = tag == 3 && blk[i + 1] == 0xd8 && blk[i + 2] == 0x5d && blk[i + 3] == 0xc4;
+			scdb = tag == 7 && blk[i + 1] == 0x79;
+			if (!vsdb && !scdb)
+				continue;
+			/* Version is at +4 and Max_FRL_Rate at +7 in either block. */
+			*max_frl = blk[i + 7] >> 4;
+			if (len >= 12)
+				*dsc_frl = blk[i + 12] >> 4;
+			return;
+		}
+	}
+}
+
+/* ALLM in the HF-VSDB or HF-SCDB: bit 1 of the byte at +8 in either block. */
+static bool edid_hf_allm(const u8 *edid, size_t size)
+{
+	size_t off, i;
+	bool found = false;
+
+	if (size < EDID_LENGTH)
+		return false;
+	size = min(size, (size_t)(edid[126] + 1) * EDID_LENGTH);
+	for (off = EDID_LENGTH; off + EDID_LENGTH <= size; off += EDID_LENGTH) {
+		const u8 *blk = edid + off;
+		u8 end = blk[2], sum = 0;
+
+		if (blk[0] != 2 || blk[1] < 3 || end < 4 || end > 127)
+			continue;
+		for (i = 0; i < EDID_LENGTH; i++)
+			sum += blk[i];
+		if (sum)
+			continue;
+		/* Validate the whole collection before trusting any capability in it. */
+		for (i = 4; i < end; i += 1 + (blk[i] & 31))
+			if (i + 1 + (blk[i] & 31) > end)
+				break;
+		if (i != end)
+			continue;
+		for (i = 4; i < end; i += 1 + (blk[i] & 31)) {
+			u8 tag = blk[i] >> 5, len = blk[i] & 31;
+
+			if ((tag == 3 && len >= 3 && blk[i + 1] == 0xd8 &&
+			     blk[i + 2] == 0x5d && blk[i + 3] == 0xc4) ||
+			    (tag == 7 && len >= 1 && blk[i + 1] == 0x79)) {
+				if (len < 8 || !(blk[i + 8] & BIT(1)))
+					return false;
+				found = true;
+			}
+		}
+	}
+	return found;
+}
+
+/* Manufacturer ID and product code, for the log. */
+static void edid_vendor(const u8 *edid, char id[4], u16 *product)
+{
+	u16 v = edid[8] << 8 | edid[9];
+
+	id[0] = '@' + (v >> 10 & 0x1f);
+	id[1] = '@' + (v >> 5 & 0x1f);
+	id[2] = '@' + (v & 0x1f);
+	id[3] = '\0';
+	*product = edid[10] | edid[11] << 8;
+}
+
+enum frl_reason {
+	FRL_OK,
+	FRL_NO_LANES,
+	FRL_NO_422,
+	FRL_FAILED,
+	FRL_LOW_RATE,
+};
+
+static const char *const frl_reasons[] = {
+	[FRL_OK] = "offered",
+	[FRL_NO_LANES] = "withheld: the EDID has no FRL at 4 lanes x 8 Gbps",
+	[FRL_NO_422] = "withheld: the EDID has no YCbCr 4:2:2",
+	[FRL_FAILED] = "withheld: FRL setup failed on this connection (frl_failed)",
+	[FRL_LOW_RATE] = "withheld: the IC reports an FRL rate below 4",
+};
+
+struct frl_inputs {
+	u8 lanes, rate_per_lane;	/* from the EDID, as DRM parses it */
+	bool ycbcr422, failed;
+	u8 rate, rate_max;		/* EDID notification byte 0 bits 3:1, now and on this connection */
+	u8 min_rate;		/* Zero keeps the original uncompressed rate-4 requirement. */
+};
+
+/*
+ * The IC's reported FRL rate for this sink must be 4 or
+ * more. Failed connections are withheld until unplug or an explicit reset
+ * through frl_failed.
+ */
+static enum frl_reason frl_4k120_reason(const struct frl_inputs *in)
+{
+	static const u8 lanes[] = {0, 3, 3, 4, 4, 4, 4};
+	static const u8 gbps[] = {0, 3, 6, 6, 8, 10, 12};
+	u8 minimum = in->min_rate ?: 4;
+
+	/* FLAVA3's uncompressed path is currently limited to FRL rate 4. */
+	if (minimum > 4 || in->lanes > 4 || in->lanes < lanes[minimum] ||
+	    in->rate_per_lane < gbps[minimum])
+		return FRL_NO_LANES;
+	if (!in->ycbcr422)
+		return FRL_NO_422;
+	if (in->failed)
+		return FRL_FAILED;
+	if (in->rate < minimum)
+		return FRL_LOW_RATE;
+	return FRL_OK;
+}
