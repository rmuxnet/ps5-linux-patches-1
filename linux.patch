+void ps5_hdmi_allm_request(bool game)
+{
+	WRITE_ONCE(allm_game, game);
+}
+EXPORT_SYMBOL(ps5_hdmi_allm_request);
+
+/* Apply a changed ALLM decision to the running output without a modeset. */
+int ps5_hdmi_allm_update(void)
+{
+	unsigned int generation;
+	bool on, ready, valid, active;
+	int ret = 0;
+
+	if (hdmi_ic_type != HDMI_IC_TYPE_FLAVA3)
+		return 0;
+	mutex_lock(&frl_setup_lock);
+	mutex_lock(&frl_state_lock);
+	generation = frl_sink_generation;
+	ready = allm_ready && frl_edid_valid;
+	valid = allm_valid;
+	active = allm_active;
+	on = allm_wanted();
+	mutex_unlock(&frl_state_lock);
+	if (ready && (!valid || on != active)) {
+		ret = setAllmFlava3(on);
+		if (!allm_record(generation, on, !ret))
+			ret = -ENODEV;
+		if (ret)
+			pr_warn("ALLM %s failed: %d\n", on ? "on" : "off", ret);
+		else
+			pr_debug("ALLM %s\n", on ? "on" : "off");
+	}
+	mutex_unlock(&frl_setup_lock);
+	return ret;
+}
+EXPORT_SYMBOL(ps5_hdmi_allm_update);
+
+static void allm_update_work_func(struct work_struct *work)
+{
+	ps5_hdmi_allm_update();
+}
+static DECLARE_WORK(allm_update_work, allm_update_work_func);
+
+/* amdgpu: the HF-VSIF write waits on the IC, so keep it out of the commit. */
+void ps5_hdmi_allm_queue_update(void)
+{
+	queue_work(system_dfl_wq, &allm_update_work);
+}
+EXPORT_SYMBOL(ps5_hdmi_allm_queue_update);
+
+static int allm_set(const char *val, const struct kernel_param *kp)
+{
+	unsigned int policy;
+	int ret = kstrtouint(val, 0, &policy);
+
+	if (ret)
+		return ret;
+	if (policy > 2)
+		return -EINVAL;
+	WRITE_ONCE(allm, policy);
+	/* Before HDMI init the IC type is unknown, and the first setup applies it. */
+	return ps5_hdmi_allm_update();
+}
+
+static const struct kernel_param_ops allm_ops = {
+	.set = allm_set,
+	.get = param_get_uint,
+};
+module_param_cb(allm, &allm_ops, &allm, 0644);
+MODULE_PARM_DESC(allm, "Experimental ALLM on FLAVA3 for sinks that support it: 0 = off (default), 1 = while the content type is Game, 2 = always; applies to the running output");
+
+void sceHdmiInitVideoConfig(void)
+{
+	int mode = READ_ONCE(hdcp_mode);
+
+	mutex_lock(&frl_setup_lock);
+	allm_reset();
+	/* As in the FRL setup, 5/1 comes first and applies at the next start. */
+	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && mode >= 0 && frl_send_hdcp_mode(mode))
+		pr_warn("5/1=%02x failed\n", mode);
+	stopHdcpHw();
+	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3) {
+		sceDisableEncode();
+		if (READ_ONCE(frl_output_active)) {
+			if (frl_scdc_write_stopped(0x31, 0x00))
+				pr_err("failed to clear sink FRL rate during modeset\n");
+			else
+				WRITE_ONCE(frl_output_active, false);
+		}
+		initIsrForFlava3();
+		initDpForFlava3(2);
+		configVSyncSettingFlava3();
+	} else {
+		initVerde();
+	}
+	mutex_unlock(&frl_setup_lock);
+}
+EXPORT_SYMBOL(sceHdmiInitVideoConfig);
