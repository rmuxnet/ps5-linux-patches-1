+enum ps5_hdmi_plan_status
+dm_ps5_select_frl_plan(const struct drm_display_mode *mode,
+		       const struct drm_connector_state *state,
+		       unsigned int requested_bpc, struct ps5_hdmi_plan *plan)
+{
+	struct amdgpu_dm_connector *aconnector = to_amdgpu_dm_connector(state->connector);
+	struct dc_link *link = aconnector->dc_link;
+	struct hdmi_drm_infoframe frame, *metadata = NULL;
+	u32 dp_kbps = 0;
+	u32 edid_crc;
+	bool bt2020, y420;
+
+	if (state->colorspace != DRM_MODE_COLORIMETRY_DEFAULT &&
+	    state->colorspace != DRM_MODE_COLORIMETRY_BT709_YCC &&
+	    state->colorspace != DRM_MODE_COLORIMETRY_BT2020_RGB &&
+	    state->colorspace != DRM_MODE_COLORIMETRY_BT2020_YCC)
+		return PS5_HDMI_PLAN_FORMAT;
+	if (!aconnector->dc_sink ||
+	    !aconnector->dc_sink->dc_edid.length ||
+	    aconnector->dc_sink->dc_edid.length > sizeof(aconnector->dc_sink->dc_edid.raw_edid))
+		return PS5_HDMI_PLAN_SINK;
+	edid_crc = crc32_le(~0, aconnector->dc_sink->dc_edid.raw_edid,
+			    aconnector->dc_sink->dc_edid.length);
+	if (link)
+		dp_kbps = dc_link_bandwidth_kbps(link, dc_link_get_link_cap(link));
+	if (state->hdr_output_metadata) {
+		if (drm_hdmi_infoframe_set_hdr_metadata(&frame, state))
+			return PS5_HDMI_PLAN_DEPTH;
+		metadata = &frame;
+	}
+	bt2020 = state->colorspace == DRM_MODE_COLORIMETRY_BT2020_RGB ||
+		 state->colorspace == DRM_MODE_COLORIMETRY_BT2020_YCC;
+	/* DP signals 4:2:0 in the VSC SDP; use DC's own condition for sending it. */
+	y420 = link && link->dpcd_caps.dpcd_rev.raw >= 0x14 &&
+	       link->dpcd_caps.dprx_feature.bits.VSC_SDP_COLORIMETRY_SUPPORTED &&
+	       !aconnector->dc_sink->edid_caps.panel_patch.disable_colorimetry;
+	return ps5_hdmi_select_plan(mode, &state->connector->display_info, requested_bpc,
+				    metadata, bt2020, dp_kbps, edid_crc,
+				    state->colorspace == DRM_MODE_COLORIMETRY_BT709_YCC ||
+				    state->colorspace == DRM_MODE_COLORIMETRY_BT2020_YCC ?
+				    PS5_HDMI_444 : PS5_HDMI_RGB,
+				    state->hdmi.broadcast_rgb == DRM_HDMI_BROADCAST_RGB_LIMITED,
+				    y420, plan);
+}
+
+/* Validate once per atomic request; duplicates own their plan by value. */
+static bool dm_ps5_frl_config_valid(const struct drm_display_mode *mode,
+				    struct drm_connector_state *state)
+{
+	struct dm_connector_state *dm_state = to_dm_connector_state(state);
+	struct ps5_hdmi_plan plan;
+	enum ps5_hdmi_plan_status status;
+
+	dm_state->ps5_hdmi_plan_valid = false;
+	if (!dm_ps5_is_hdmi_connector(state->connector))
+		return true;
+	if (!isHdmiFrlTiming(mode) && drm_match_cea_mode(mode) != 97)
+		return true;
+	status = dm_ps5_select_frl_plan(mode, state, state->max_requested_bpc, &plan);
+	if (status != PS5_HDMI_PLAN_OK) {
+		drm_dbg_kms(state->connector->dev, "PS5 HDMI plan rejected: %s\n",
+			    ps5_hdmi_plan_reason(status));
+		/* Preserve the established TMDS backend when FRL is unavailable. */
+		return !isHdmiFrlTiming(mode) && status == PS5_HDMI_PLAN_BACKEND;
+	}
+	dm_state->ps5_hdmi_plan = plan;
+	dm_state->ps5_hdmi_plan_valid = true;
+	return true;
+}
