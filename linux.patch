+
+int getHdmiConfiguration(void)
+{
+	u8 buf[ICC_MSG_MAX_SIZE] = {};
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	msg->service_id = ICC_SERVICE_ID_GENERAL;
+	msg->msg_type = 0x16;
+	msg->length = ICC_MSG_MIN_SIZE;
+	msg->data[0] = 0x10;
+
+	ret = icc_query(buf, buf);
+	if (ret)
+		return ret;
+
+	hdmi_ic_type = (msg->data[0x3] == 1) | 2;
+	tmds_polarity = msg->data[0x4] == 1;
+	tmds_ch_swap = msg->data[0x5] == 1;
+	dp_polarity = msg->data[0x6];
+	dp_ch_swap = msg->data[0x7];
+
+	pr_info("HDMI IC Type [%s]\n", hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 ? "FLAVA3" : "VERDE");
+	pr_info("TMDS Polarity [%s]\n", tmds_polarity ? "Reverse" : "Normal");
+	pr_info("TMDS Ch Swap [%s]\n", tmds_ch_swap ? "Swap" : "Normal");
+	pr_info("DP Polarity [0x%x]\n", dp_polarity);
+	pr_info("DP Ch Swap [0x%x]\n", dp_ch_swap);
+
+	return 0;
+}
+EXPORT_SYMBOL(getHdmiConfiguration);
+
+/* FLAVA3 audio is choppy with the default Naud, Maud is too coarse. */
+u32 getHdmiDpAudioN(u32 default_n)
+{
+	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3)
+		return 0x80000;
+
+	return default_n;
+}
+EXPORT_SYMBOL(getHdmiDpAudioN);
+
+bool isHdmiModeStock(const struct drm_display_mode *mode)
+{
+	u8 vic = drm_match_cea_mode(mode);
+
+	/* 1440p */
+	if (mode->hdisplay == 2560 && mode->vdisplay == 1440)
+		return mode->clock == 241500 || mode->clock == 241700;
+
+	switch (vic) {
+	case 16: /* 1080p60 */
+	case 63: /* 1080p120 */
+	case 97: /* 2160p60 */
+		return true;
+	}
+
+	return false;
+}
+EXPORT_SYMBOL(isHdmiModeStock);
+
+/* Include 4:2:2 capability from every CTA block. */
+bool isHdmiSink422(const struct drm_display_info *info)
+{
+	return info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422) ||
+	       READ_ONCE(sink_cta_422);
+}
+EXPORT_SYMBOL(isHdmiSink422);
+
+static bool frl_config_allowed(const struct ps5_hdmi_frl_config *config,
+			       const struct drm_display_info *info)
+{
+	struct frl_inputs in = {
+		.lanes = info->hdmi.max_lanes,
+		.rate_per_lane = info->hdmi.max_frl_rate_per_lane,
+		.ycbcr422 = isHdmiSink422(info),
+		.failed = frl_sink_failed(),
+		.rate = READ_ONCE(frl_trained_rate),
+		.rate_max = READ_ONCE(frl_rate_max),
+		.min_rate = config->min_rate,
+	};
+	enum frl_reason reason = frl_4k120_reason(&in);
+
+	/* Mode validation runs per mode and per probe; log each change once. */
+	if (xchg(&frl_decision_logged, reason) != reason)
+		pr_info("FRL %s (FRL rate %u, %u on this connection, EDID %u lanes x %u Gbps, 4:2:2 %s)\n",
+			frl_reasons[reason], in.rate, in.rate_max, in.lanes,
+			in.rate_per_lane, in.ycbcr422 ? "yes" : "no");
+	return reason == FRL_OK;
+}
+
+enum ps5_hdmi_plan_status
+ps5_hdmi_select_plan(const struct drm_display_mode *mode,
+		     const struct drm_display_info *info, unsigned int max_bpc,
+		     const struct hdmi_drm_infoframe *metadata, bool bt2020,
+		     u32 dp_capacity_kbps, u32 edid_crc, u8 preferred_format,
+		     bool limited, bool y420_allowed, struct ps5_hdmi_plan *plan)
+{
+	unsigned int yuv420 = READ_ONCE(frl_yuv420);
+	struct ps5_hdmi_plan candidate;
+	struct frl_caps caps = {
+		.dp_kbps = min(dp_capacity_kbps, 25920000U),
+		.converter_rate = 4,
+		.tmds_khz = info->max_tmds_clock ?: 165000,
+		.scrambling = info->hdmi.scdc.supported && info->hdmi.scdc.scrambling.supported,
+		.preferred_format = preferred_format,
+		.limited = limited,
+		.rgb_depths = BIT(8) |
+			(info->edid_hdmi_rgb444_dc_modes & DRM_EDID_HDMI_DC_30 ? BIT(10) : 0) |
+			(info->edid_hdmi_rgb444_dc_modes & DRM_EDID_HDMI_DC_36 ? BIT(12) : 0),
+		.y420_depths = BIT(8) |
+			(info->hdmi.y420_dc_modes & DRM_EDID_YCBCR420_DC_30 ? BIT(10) : 0) |
+			(info->hdmi.y420_dc_modes & DRM_EDID_YCBCR420_DC_36 ? BIT(12) : 0),
+		.prefer420 = yuv420 == 2,
+		.y444_depths = BIT(8) |
+			(info->edid_hdmi_ycbcr444_dc_modes & DRM_EDID_HDMI_DC_30 ? BIT(10) : 0) |
+			(info->edid_hdmi_ycbcr444_dc_modes & DRM_EDID_HDMI_DC_36 ? BIT(12) : 0),
+		.enabled = READ_ONCE(frl_4k120) && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 &&
+			   frl_wiring_valid(),
+	};
+	enum ps5_hdmi_plan_status status;
+	u8 rate, y420_mode, vic = drm_match_cea_mode(mode);
+	enum frl_reason policy_reason;
+	struct frl_inputs in = {
+		.lanes = info->hdmi.max_lanes,
+		.rate_per_lane = info->hdmi.max_frl_rate_per_lane,
+		.min_rate = 4,
+	};
+
+	if (!caps.enabled)
+		return PS5_HDMI_PLAN_BACKEND;
+	if (drm_mode_is_420_only(info, mode) && !yuv420)
+		return PS5_HDMI_PLAN_FORMAT;
+	if (metadata && metadata->eotf != HDMI_EOTF_SMPTE_ST2084)
+		return PS5_HDMI_PLAN_DEPTH;
+	if (metadata && !(info->hdr_sink_metadata.hdmi_type1.eotf & BIT(metadata->eotf)))
+		return PS5_HDMI_PLAN_SINK;
+	/* Pair the connection generation with its admission state. */
+	mutex_lock(&frl_state_lock);
+	if (edid_crc != frl_edid_crc) {
+		mutex_unlock(&frl_state_lock);
+		return PS5_HDMI_PLAN_STALE;
+	}
+	caps.generation = frl_sink_generation;
+	if (READ_ONCE(frl_recovery))
+		caps.failed_candidates = frl_failure_mask(&frl_failures, mode,
+							  metadata, bt2020, limited);
+	in.failed = frl_failed;
+	in.rate = frl_trained_rate;
+	in.rate_max = frl_rate_max;
+	caps.formats = BIT(PS5_HDMI_RGB);
+	if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR422) || sink_cta_422)
+		caps.formats |= BIT(PS5_HDMI_422);
+	if (info->color_formats & BIT(DRM_OUTPUT_COLOR_FORMAT_YCBCR444) || sink_cta_444)
+		caps.formats |= BIT(PS5_HDMI_444);
+	y420_mode = sink_y420_modes[vic];
+	/* The extension-local map and DRM's must both permit 4:2:0 here. */
+	if (y420_allowed && (yuv420 == 1 || yuv420 == 2) &&
+	    (y420_mode & (Y420_ONLY | Y420_ALSO)) &&
+	    (drm_mode_is_420_only(info, mode) || drm_mode_is_420_also(info, mode)))
+		caps.formats |= BIT(PS5_HDMI_420);
+	if (drm_mode_is_420_only(info, mode) || y420_mode & Y420_ONLY)
+		caps.formats &= BIT(PS5_HDMI_420);
+	in.ycbcr422 = true;
+	policy_reason = frl_4k120_reason(&in);
+	if (!frl_edid_valid) {
+		mutex_unlock(&frl_state_lock);
+		return PS5_HDMI_PLAN_SINK;
+	}
+	mutex_unlock(&frl_state_lock);
+	if (policy_reason != FRL_OK)
+		caps.converter_rate = 0;
+	for (rate = 1; rate <= 6; rate++) {
+		static const u8 lanes[] = { 0, 3, 3, 4, 4, 4, 4 };
+		static const u8 gbps[] = { 0, 3, 6, 6, 8, 10, 12 };
+
+		if (in.lanes >= lanes[rate] && in.rate_per_lane >= gbps[rate])
+			caps.sink_rate = rate;
+	}
+	status = frl_select_plan(mode, &caps, max_bpc, metadata, bt2020, &candidate);
+	if (status != PS5_HDMI_PLAN_OK)
+		return status;
+	/* HDCP off with the HDCP 2.2 bit set; the IC picks the FRL rate. */
+	candidate.hdcp = 3;
+	candidate.start = 0x02;
+	candidate.verify_ms = 2000;
+	if (candidate.generation != frl_get_sink_generation())
+		return PS5_HDMI_PLAN_STALE;
+	*plan = candidate;
+	return PS5_HDMI_PLAN_OK;
+}
+EXPORT_SYMBOL(ps5_hdmi_select_plan);
+
+int getHdmiExtendedModes(void)
+{
+	return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 ? extended_modes : 0;
+}
+EXPORT_SYMBOL(getHdmiExtendedModes);
+
+bool isHdmiModeValid(const struct drm_display_mode *mode,
+		     const struct drm_display_info *info, int force_1080p)
+{
+	struct ps5_hdmi_frl_config config;
+	struct ps5_hdmi_plan plan;
+
+	if (force_1080p)
+		return drm_match_cea_mode(mode) == 16; /* 1080p60 */
+
+	/* Native 4:2:0 needs FRL, VERDE keeps the stock check. */
+	if (drm_mode_is_420_only(info, mode) && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3)
+		return ps5_hdmi_select_plan(mode, info, 10, NULL, false, 25920000,
+				    READ_ONCE(frl_edid_crc), PS5_HDMI_RGB, false, true,
+				    &plan) == PS5_HDMI_PLAN_OK;
+
+	if (isHdmiModeStock(mode))
+		return true;
+
+	/* The plan supplies the required FRL rate for this converter timing. */
+	if (getHdmiFrlConfig(mode, 10, &config))
+		return (READ_ONCE(frl_yuv420) || frl_config_allowed(&config, info)) &&
+		       ps5_hdmi_select_plan(mode, info, 10, NULL, false, 25920000,
+					    READ_ONCE(frl_edid_crc), PS5_HDMI_RGB, false, true,
+					    &plan) == PS5_HDMI_PLAN_OK;
+
+	if (!getHdmiExtendedModes())
+		return false;
+
+	/* Use the stock 1440p setup up to 297 MHz. */
+	if (mode->hdisplay == 2560 && mode->vdisplay == 1440 &&
+	    mode->clock <= 297000) {
+		if (!isManualTiming(mode))
+			return false;
+	} else if (!isManualMode(mode)) {
+		return false;
+	}
+
+	/* Default to 165 MHz when the EDID has no HDMI VSDB. */
+	if (mode->clock > (info->max_tmds_clock ?: 165000))
+		return false;
+
+	return mode->clock <= 340000 ||
+	       (info->hdmi.scdc.supported && info->hdmi.scdc.scrambling.supported);
+}
+EXPORT_SYMBOL(isHdmiModeValid);
+
+bool isHdmiHdrSupported(void)
+{
+	return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+}
+EXPORT_SYMBOL(isHdmiHdrSupported);
+
+bool isHdmiNative420Supported(void)
+{
+	return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3;
+}
+EXPORT_SYMBOL(isHdmiNative420Supported);
+
+static DEFINE_MUTEX(hdmi_edid_lock);
+static const struct drm_edid *real_edid;
+static struct drm_connector *hdmi_connector;
+
+void ps5_hdmi_set_connector(struct drm_connector *connector)
+{
+	guard(mutex)(&hdmi_edid_lock);
+	hdmi_connector = connector;
+}
+EXPORT_SYMBOL_GPL(ps5_hdmi_set_connector);
+
+void ps5_hdmi_clear_connector(struct drm_connector *connector)
+{
+	guard(mutex)(&hdmi_edid_lock);
+	if (connector == hdmi_connector)
+		hdmi_connector = NULL;
+}
+EXPORT_SYMBOL_GPL(ps5_hdmi_clear_connector);
+
+const struct drm_edid *ps5_hdmi_get_edid(struct drm_connector *connector)
+{
+	guard(mutex)(&hdmi_edid_lock);
+	if (hdmi_connector && connector == hdmi_connector && real_edid)
+		return drm_edid_dup(real_edid);
+	return NULL;
+}
+EXPORT_SYMBOL_GPL(ps5_hdmi_get_edid);
+static u8 last_edid[ICC_MSG_MAX_SIZE - sizeof(struct icc_msg) - 4];
+static u16 last_edid_size;
+
+static void fix_edid(u8 *edid)
+{
+	int i;
+	u32 sum = 0;
+
+	/* For some reason, PS5 sets 0x01. */
+	edid[0] = 0x00;
+	for (i = 0; i < 0x7f; i++)
+		sum += edid[i];
+	edid[0x7f] = -sum & 0xff;
+}
+
+static DEFINE_MUTEX(hotplug_lock);
+static void (*hotplug_handler)(void *data);
+static void *hotplug_data;
+
+void hdmi_set_hotplug_handler(void (*handler)(void *data), void *data)
+{
+	mutex_lock(&hotplug_lock);
+	hotplug_handler = handler;
+	hotplug_data = data;
+	mutex_unlock(&hotplug_lock);
+}
+EXPORT_SYMBOL(hdmi_set_hotplug_handler);
+
+/* amdgpu detects the sink again and userspace re-probes its modes. */
+static void hdmi_request_hotplug(void)
+{
+	mutex_lock(&hotplug_lock);
+	if (hotplug_handler)
+		hotplug_handler(hotplug_data);
+	mutex_unlock(&hotplug_lock);
+}
+
+static DEFINE_MUTEX(cec_lock);
+static void (*cec_handler)(void *data, const struct icc_msg *msg);
+static void *cec_data;
+
+void hdmi_set_cec_handler(void (*handler)(void *data, const struct icc_msg *msg),
+			  void *data)
+{
+	mutex_lock(&cec_lock);
+	cec_handler = handler;
+	cec_data = data;
+	mutex_unlock(&cec_lock);
+}
+EXPORT_SYMBOL(hdmi_set_cec_handler);
+
+/* Log the notification header and a bounded payload. */
+static void hdmi_log_notification(const struct icc_msg *msg)
+{
+	unsigned int len = 4 + (msg->data[2] | msg->data[3] << 8);
+
+	len = min_t(unsigned int, len, msg->length - sizeof(*msg));
+	if (msg->data[1] != 0x02)
+		pr_debug("notification %*ph\n", min(len, 48U), msg->data);
+}
+
+void hdmi_notification_handler(struct icc_msg *msg)
+{
+	if (msg->length < sizeof(*msg) + 4 || msg->length > ICC_MSG_MAX_SIZE) {
+		pr_warn_ratelimited("short or oversized HDMI notification\n");
+		return;
+	}
+	hdmi_log_notification(msg);
+	if (msg->data[1] == 0x01) {
+		mutex_lock(&frl_state_lock);
+		frl_sink_generation++;
+		memset(&frl_failures, 0, sizeof(frl_failures));
+		frl_failed = false;
+		frl_edid_valid = false;
+		WRITE_ONCE(sink_allm, false);
+		allm_reset_locked();
+		mutex_unlock(&frl_state_lock);
+		last_edid_size = 0;
+		WRITE_ONCE(hdcp_abort_until, jiffies);
+	}
+
+	/* Event 4: HDCP failed after the start and the IC muted the video. */
+	if (msg->data[1] == 0x04 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 &&
+	    time_before(jiffies, READ_ONCE(hdcp_abort_until))) {
+		int ret = stopHdcpHw();
+
+		sceHdmiDeviceSetVideoMute(0);
+		sceHdmiSetAudioMute(0);
+		pr_info("HDCP failed (event 4): stopped HDCP (%d) and unmuted\n", ret);
+	}
+
+	if (msg->data[1] == 0x02) {
+		u16 size = get_unaligned_le16(msg->data + 2);
+		const struct drm_edid *edid = NULL;
+		u8 byte0 = 0, frl_rate = 0, rate_max, max_frl = 0, dsc_frl = 0;
+		bool same, ycbcr422 = false, ycbcr444 = false, allm_cap = false;
+		char vendor[4] = "";
+		u16 product = 0;
+		u32 crc = 0;
+		u8 y420_modes[256] = {};
+
+		if (size < EDID_LENGTH || size > msg->length - sizeof(*msg) - 4) {
+			pr_warn("bad EDID size %u\n", size);
+		} else {
+			/* Byte 0: HDCP 2.2 in bit 0, trained FRL rate in bits 3:1. */
+			byte0 = msg->data[4];
+			frl_rate = (byte0 >> 1) & 7;
+			fix_edid(&msg->data[4]);
+			edid = drm_edid_alloc(&msg->data[4], size);
+			crc = crc32_le(~0, &msg->data[4], size);
+			ycbcr422 = edid_cta_ycbcr422(&msg->data[4], size);
+			ycbcr444 = edid_cta_ycbcr444(&msg->data[4], size);
+			edid_cta_y420(&msg->data[4], size, y420_modes);
+			allm_cap = edid_hf_allm(&msg->data[4], size);
+			edid_hf_frl(&msg->data[4], size, &max_frl, &dsc_frl);
+			edid_vendor(&msg->data[4], vendor, &product);
+		}
+		/* A new rate changes the modes, so it needs the hotplug path. */
+		same = edid && size == last_edid_size &&
+		       frl_rate == READ_ONCE(frl_trained_rate) &&
+		       !memcmp(last_edid, &msg->data[4], size);
+
+		/* The IC checks the sink again on every plug; keep its best rate. */
+		if (!edid) {
+			frl_rate = 0;
+			ycbcr422 = false;
+			ycbcr444 = false;
+			allm_cap = false;
+		}
+		mutex_lock(&frl_state_lock);
+		if (!edid || !frl_edid_valid || crc != frl_edid_crc) {
+			frl_sink_generation++;
+			memset(&frl_failures, 0, sizeof(frl_failures));
+			allm_reset_locked();
+			frl_failed = false;
+			WRITE_ONCE(frl_rate_max, frl_rate);
+		} else if (frl_rate > frl_rate_max) {
+			WRITE_ONCE(frl_rate_max, frl_rate);
+		}
+		frl_edid_valid = edid;
+		frl_edid_crc = crc;
+		rate_max = frl_rate_max;
+		memcpy(sink_y420_modes, y420_modes, sizeof(sink_y420_modes));
+		WRITE_ONCE(sink_cta_422, ycbcr422);
+		WRITE_ONCE(sink_cta_444, ycbcr444);
+		WRITE_ONCE(sink_allm, allm_cap);
+		WRITE_ONCE(frl_trained_rate, frl_rate);
+		mutex_unlock(&frl_state_lock);
+		WRITE_ONCE(frl_decision_logged, -1);
+
+		last_edid_size = edid && size <= sizeof(last_edid) ? size : 0;
+		memcpy(last_edid, &msg->data[4], last_edid_size);
+		mutex_lock(&hdmi_edid_lock);
+		swap(real_edid, edid);
+		mutex_unlock(&hdmi_edid_lock);
+		if (real_edid) {
+			pr_info("got real HDMI EDID, FRL rate %u\n", frl_rate);
+			pr_debug("EDID notification: %u bytes, byte0 %02x (HDCP 2.2 %u, FRL rate %u, %u on this connection), %s %04x crc %08x, EDID FRL rate %u DSC %u, 4:2:2 %s\n",
+				 size, byte0, byte0 & 1, frl_rate, rate_max, vendor, product,
+				 crc, max_frl, dsc_frl, ycbcr422 ? "yes" : "no");
+		}
+		drm_edid_free(edid);
+		sceHdmiOutputMode();
+
+		/* An HDCP abort mutes video without changing the sink. */
+		if (same && time_before(jiffies, READ_ONCE(hdcp_abort_until))) {
+			WRITE_ONCE(hdcp_abort_until, jiffies);
+			pr_info("HDCP failed, unmuting video\n");
+			sceHdmiDeviceSetVideoMute(0);
+		} else {
+			hdmi_request_hotplug();
+		}
+	}
+
+	mutex_lock(&cec_lock);
+	if (cec_handler)
+		cec_handler(cec_data, msg);
+	mutex_unlock(&cec_lock);
+}
+EXPORT_SYMBOL(hdmi_notification_handler);
