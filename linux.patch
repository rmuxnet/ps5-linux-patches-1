+/* Keep a stock mode preferred when one passes validation. */
+static void dm_ps5_set_preferred_mode(struct drm_connector *connector)
+{
+	struct drm_display_mode *mode, *best = NULL;
+	bool preferred = false;
+
+	if (getHdmiExtendedModes() != 1)
+		return;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		if (!isHdmiModeStock(mode) ||
+		    amdgpu_dm_connector_mode_valid(connector, mode) != MODE_OK)
+			continue;
+		if (mode->type & DRM_MODE_TYPE_PREFERRED)
+			preferred = true;
+		if (!best || dm_ps5_mode_larger(mode, best))
+			best = mode;
+	}
+
+	if (!best)
+		return;
+
+	list_for_each_entry(mode, &connector->probed_modes, head) {
+		if (!isHdmiModeStock(mode))
+			mode->type &= ~DRM_MODE_TYPE_PREFERRED;
+	}
+
+	if (!preferred)
+		best->type |= DRM_MODE_TYPE_PREFERRED;
+}
