+const char *ps5_hdmi_plan_reason(enum ps5_hdmi_plan_status status)
+{
+	static const char * const reasons[] = {
+		[PS5_HDMI_PLAN_OK] = "accepted",
+		[PS5_HDMI_PLAN_BACKEND] = "FRL disabled or unsupported converter/wiring",
+		[PS5_HDMI_PLAN_TIMING] = "unsupported converter timing",
+		[PS5_HDMI_PLAN_FORMAT] = "unsupported sink or converter format",
+		[PS5_HDMI_PLAN_DEPTH] = "depth ceiling or HDR metadata conflict",
+		[PS5_HDMI_PLAN_DP] = "internal DP capacity exceeded",
+		[PS5_HDMI_PLAN_HDMI] = "HDMI capacity or FRL rate unavailable",
+		[PS5_HDMI_PLAN_SINK] = "sink capability, policy or failed connection",
+		[PS5_HDMI_PLAN_STALE] = "connection changed during planning",
+	};
+
+	return status < ARRAY_SIZE(reasons) ? reasons[status] : "invalid plan status";
+}
+EXPORT_SYMBOL(ps5_hdmi_plan_reason);
