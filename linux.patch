+int sceHdmiDeviceSetVideoMute(int mute)
+{
+	int ret;
+
+	i2c_init(4);
+	if (hdmi_ic_type == HDMI_IC_TYPE_FLAVA3) {
+		i2c_write(0x705f, (mute == 1) << 7);
+	} else {
+		i2c_mask(0x105, mute != 1, 0x03);
+	}
+	ret = i2c_exec();
+	/* The reply format is only known on FLAVA3. */
+	if (hdmi_ic_type != HDMI_IC_TYPE_FLAVA3)
+		return 0;
+	if (ret)
+		allm_reset();
+	return ret;
+}
