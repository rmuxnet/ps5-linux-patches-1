diff --git a/drivers/ps5/frl-native.inc b/drivers/ps5/frl-native.inc
new file mode 100644
index 000000000000..85fcc7c94de9
--- /dev/null
+++ b/drivers/ps5/frl-native.inc
@@ -0,0 +1,373 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Native FRL setup for FLAVA3. */
+#include "frl-native-msgs.h"
+
+static DEFINE_MUTEX(frl_setup_lock);
+
+static int frl_query(const u8 *body, size_t len, u8 *reply, size_t reply_len)
+{
+	struct icc_msg *msg;
+	int ret;
+
+	if (len > ICC_MSG_MAX_SIZE - sizeof(*msg) ||
+	    reply_len > ICC_MSG_MAX_SIZE - sizeof(*msg))
+		return -EINVAL;
+	msg = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->length = sizeof(*msg) + len;
+	memcpy(msg->data, body, len);
+	ret = icc_query((u8 *)msg, (u8 *)msg);
+	if (!ret && (msg->service_id != ICC_SERVICE_ID_HDMI || msg->msg_type != 0x4000 ||
+		     msg->length < sizeof(*msg) + max_t(size_t, reply_len, 2) ||
+		     msg->length > ICC_MSG_MAX_SIZE))
+		ret = -EPROTO;
+	if (!ret && (msg->data[0] || msg->data[1]))
+		ret = -EIO;
+	if (!ret && reply)
+		memcpy(reply, msg->data, reply_len);
+	kfree(msg);
+	return ret;
+}
+
+#define FRL_SEND(name) frl_query(msg_##name, sizeof(msg_##name), NULL, 0)
+#define FRL_STEP(expr) do { ret = (expr); if (ret) goto fail; } while (0)
+
+static int frl_stop_hdcp(void)
+{
+	struct icc_msg *msg;
+	int ret;
+
+	msg = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+	msg->service_id = ICC_SERVICE_ID_GENERAL;
+	msg->msg_type = 0x1f;
+	msg->length = ICC_MSG_MIN_SIZE;
+	ret = icc_query((u8 *)msg, (u8 *)msg);
+	kfree(msg);
+	return ret;
+}
+
+/* Read converter registers without taking the sink DDC bus. */
+static int frl_reg_read(u16 reg, u8 count, u8 *out)
+{
+	const u8 body[] = {
+		0x04, 0x0c, 0x00, 0x01,
+		0x01, 0x08, 0x01, 0x01, count, reg >> 8, reg & 0xff, 0x00,
+	};
+	u8 reply[8 + 32];
+	int ret;
+
+	if (!count || count > 32)
+		return -EINVAL;
+	ret = frl_query(body, sizeof(body), reply, 8 + count);
+	if (!ret)
+		memcpy(out, reply + 8, count);
+	return ret;
+}
+
+static int frl_read_tmds_config(u8 *value)
+{
+	return frl_reg_read(0x7c00, 1, value);
+}
+
+/* Write SCDC while the converter output is stopped. */
+static int frl_scdc_write_stopped(u8 offset, u8 value)
+{
+	const u8 body[] = {
+		0x04, 0x53, 0x00, 0x08,
+		0x02, 0x0c, 0x02, 0x02, 0x01, 0x74, 0x19, 0x05, 0x01, 0x74, 0x0a, 0xff,
+		0x03, 0x08, 0x03, 0x01, 0x00, 0x74, 0x0a, 0xff,
+		0x02, 0x0c, 0x02, 0x02, 0x01, 0x74, 0x04, 0x00, 0x01, 0x7a, 0x88, 0xff,
+		0x03, 0x08, 0x03, 0x01, 0x00, 0x7a, 0x84, 0x01,
+		0x02, 0x08, 0x02, 0x01, 0x01, 0x7a, 0x8b, 0x05,
+		0x03, 0x08, 0x01, 0x01, 0x00, 0x14, 0x00, 0x00,
+		0x02, 0x0f, 0x02, 0x02, 0x01, 0x7c, 0x00, value,
+		0x04, 0x7a, 0x80, 0xa8, offset, 0x00, 0x80,
+		0x03, 0x08, 0x03, 0x01, 0x00, 0x7a, 0x84, 0x01,
+	};
+
+	BUILD_BUG_ON(sizeof(body) != 0x53);
+	return frl_query(body, sizeof(body), NULL, 0);
+}
+
+/* 5/1 controls HDCP: bit 0 HDCP off, bit 1 HDCP 2.2. */
+static int frl_send_hdcp_mode(u8 value)
+{
+	u8 body[sizeof(msg_hdcp_mode)];
+
+	memcpy(body, msg_hdcp_mode, sizeof(body));
+	/* msg_hdcp_mode is the 5/1 command with its value at byte 8. */
+	if (memcmp(body + 4, (u8[]){0x05, 0x05, 0x01, 0x01}, 4))
+		return -EINVAL;
+	body[8] = value;
+	return frl_query(body, sizeof(body), NULL, 0);
+}
+
+/* 5/3 = 02 lets the IC pick the FRL rate; a nonzero high nibble selects a rate. */
+static int frl_send_start(u8 value)
+{
+	u8 body[sizeof(msg_frl_start)];
+	size_t n = sizeof(body);
+
+	memcpy(body, msg_frl_start, n);
+	/* msg_frl_start ends with the 5/3 command. */
+	if (memcmp(body + n - 5, (u8[]){0x05, 0x05, 0x03, 0x01}, 4))
+		return -EINVAL;
+	body[n - 1] = value;
+	return frl_query(body, n, NULL, 0);
+}
+
+/*
+ * 0x7019 bit 6 is set while the IC sends FRL: 43 on a trained link, 00 or 01
+ * after a fallback to TMDS.
+ * Returns the ms waited, or -ETIMEDOUT.
+ */
+static int frl_wait_link(unsigned int timeout_ms, u8 *value)
+{
+	unsigned int waited = 0;
+	int ret;
+
+	for (;;) {
+		ret = frl_reg_read(0x7019, 1, value);
+		if (ret)
+			return ret;
+		if (*value & 0x40)
+			return waited;
+		if (waited >= timeout_ms)
+			return -ETIMEDOUT;
+		msleep(100);
+		waited += 100;
+	}
+}
+
+/* Stop and mute the output and clear the sink's FRL_Rate. */
+static int frl_cleanup(void)
+{
+	int ret, first;
+
+	allm_reset();
+	first = frl_stop_hdcp();
+	ret = FRL_SEND(disable_encode);
+	if (!first)
+		first = ret;
+	if (READ_ONCE(frl_output_active)) {
+		ret = frl_scdc_write_stopped(0x31, 0);
+		if (!ret)
+			WRITE_ONCE(frl_output_active, false);
+		if (!first)
+			first = ret;
+	}
+	WRITE_ONCE(hdcp_abort_until, jiffies);
+	return first;
+}
+
+/* Passive IC status reads after startup. */
+static int frl_verify_output(const struct ps5_hdmi_plan *plan)
+{
+	unsigned int i, good = 0, bad = 0;
+	u8 link, mute;
+	int ret;
+
+	if (!frl_reported_rate_valid(READ_ONCE(frl_trained_rate), plan->rate_mask))
+		return -EIO;
+	for (i = 0; i < 5; i++) {
+		if (plan->generation != frl_get_sink_generation())
+			return -ENODEV;
+		ret = frl_reg_read(0x7019, 1, &link);
+		if (ret)
+			return ret;
+		ret = frl_reg_read(0x705f, 1, &mute);
+		if (ret)
+			return ret;
+		if (plan->generation != frl_get_sink_generation())
+			return -ENODEV;
+		if (link & 0x40 && !(mute & 0x80)) {
+			bad = 0;
+			if (++good == 2)
+				return 0;
+		} else {
+			good = 0;
+			if (++bad == 2)
+				return -EIO;
+		}
+		msleep(100);
+	}
+	return -ETIMEDOUT;
+}
+
+/* Register the video-latch sequence that firmware runs after FRL training. */
+static int frl_set_video_sequence(const struct ps5_hdmi_frl_config *config, bool bt2020,
+				  bool allm)
+{
+	u8 seq[128];
+	size_t len;
+
+	i2c_init(0);
+	i2c_write(0x7011, 0x07);
+	i2c_waitclear(0x7011, 0xff);
+	/* With ALLM, latch and resend the HF-VSIF after training. */
+	i2c_begin_block();
+	i2c_write(0x7204, allm ? 0xe0 : 0x60);
+	i2c_write(0x7011, allm ? 0x0f : 0x07);
+	i2c_end_block();
+	i2c_waitclear(0x7011, 0xff);
+	i2c_begin_block();
+	i2c_write(0x7204, allm ? 0xe0 : 0x60);
+	i2c_write_data(0x7231, (u8[]){0, 0}, 2);
+	i2c_write(0x7227, config->vic);
+	i2c_end_block();
+	i2c_mask(0x7226, 0x00, 0x80);
+	i2c_mask(0x7228, 0x00, 0x30);
+	i2c_mask(0x7225, bt2020 ? 0xc0 : config->format == PS5_HDMI_RGB ? 0x00 : 0x80,
+		 0xc0);
+	i2c_mask(0x7226, bt2020 ? 0x60 : 0x00, 0x70);
+	if (config->format == PS5_HDMI_RGB) {
+		i2c_mask(0x7226, config->limited ? 0x04 : 0x08, 0x0c);
+		i2c_mask(0x7228, config->limited ? 0x00 : 0x40, 0xc0);
+	}
+	i2c_write(0x7204, allm ? 0xc1 : 0x41);
+	i2c_waitclear(0x7204, 0x41);
+	len = i2c_ctx.msg_cur - i2c_ctx.msg_buf;
+	if (len > sizeof(seq)) {
+		mutex_unlock(&i2c_lock);
+		return -E2BIG;
+	}
+	/* A registered sequence has an 8-bit length and its own header layout. */
+	seq[0] = 0x30;
+	seq[1] = len;
+	seq[2] = i2c_ctx.msg_hdr->count;
+	seq[3] = 0;
+	memcpy(seq + 4, i2c_ctx.msg_buf + 4, len - 4);
+	i2c_ctx.msg_cur = i2c_ctx.msg_buf + sizeof(*i2c_ctx.msg_hdr);
+	i2c_ctx.msg_hdr->count = 0;
+	i2c_cmd_4_16(seq, len);
+	return i2c_exec();
+}
+
+int ps5_hdmi_apply_plan(const struct ps5_hdmi_plan *plan)
+{
+	const struct drm_display_mode *mode = &plan->mode;
+	struct ps5_hdmi_frl_config config = plan->config;
+	const struct hdmi_drm_infoframe *frame = plan->hdr ? &plan->metadata : NULL;
+	bool bt2020 = plan->bt2020;
+	u8 tmds_config, link = 0, hdcp, start;
+	u8 hdr_data[HDMI_INFOFRAME_SIZE(DRM)];
+	struct hdmi_drm_infoframe sdr;
+	unsigned int verify_ms = plan->verify_ms, generation = plan->generation;
+	bool allm;
+	int ret;
+
+	if (!plan->frl || !frl_plan_valid(plan) ||
+	    plan->rate_mask != BIT(4) || plan->hdcp < 1 || plan->hdcp > 3 ||
+	    (plan->start != 0x02 && plan->start != 0x42) || plan->verify_ms > 10000)
+		return -EINVAL;
+	mutex_lock(&frl_setup_lock);
+	if (generation != frl_get_sink_generation()) {
+		mutex_unlock(&frl_setup_lock);
+		return -ENODEV;
+	}
+	/* A hotplug recommit must not retrain a sink that already failed. */
+	if (frl_sink_failed()) {
+		pr_info("native FRL: not started, training failed earlier for this sink\n");
+		mutex_unlock(&frl_setup_lock);
+		return -EIO;
+	}
+	allm = allm_wanted();
+	/* The basic setup rewrites 7203, which stops any ALLM packet. */
+	allm_reset();
+	hdcp = plan->hdcp;
+	start = plan->start;
+	pr_debug("native FRL: 5/1=%02x 5/3=%02x\n", hdcp, start);
+	FRL_STEP(FRL_SEND(audio_mute));
+	FRL_STEP(frl_send_hdcp_mode(hdcp));
+	FRL_STEP(frl_stop_hdcp());
+	FRL_STEP(FRL_SEND(disable_encode));
+	/* Share the initialization that applies the firmware's lane configuration. */
+	FRL_STEP(initIsrForFlava3());
+	FRL_STEP(initDpForFlava3(10));
+	FRL_STEP(FRL_SEND(vsync));
+	FRL_STEP(FRL_SEND(audio_mute));
+	FRL_STEP(FRL_SEND(scdc_read_prep));
+	FRL_STEP(frl_read_tmds_config(&tmds_config));
+	if (tmds_config)
+		FRL_STEP(frl_scdc_write_stopped(0x20, 0x00));
+	FRL_STEP(FRL_SEND(pre));
+	FRL_STEP(FRL_SEND(link_training));
+	FRL_STEP(setHdmiBasicVideoConfigFlava3(mode, config.bpc, config.format == PS5_HDMI_422, &config, bt2020));
+	FRL_STEP(FRL_SEND(phy_1st));
+	FRL_STEP(FRL_SEND(phy_2nd));
+	/* Upload metadata before startup; latch waits require live output. */
+	if (!frame) {
+		hdmi_drm_infoframe_init(&sdr);
+		ret = hdmi_drm_infoframe_pack_only(&sdr, hdr_data, sizeof(hdr_data));
+	} else {
+		ret = hdmi_drm_infoframe_pack_only(frame, hdr_data, sizeof(hdr_data));
+	}
+	if (ret != (int)sizeof(hdr_data)) {
+		ret = -EINVAL;
+		goto fail;
+	}
+	i2c_init(1);
+	i2c_write_data(0x7e40, hdr_data, sizeof(hdr_data));
+	FRL_STEP(i2c_exec());
+	FRL_STEP(FRL_SEND(spd));
+	FRL_STEP(frl_set_video_sequence(&config, bt2020, allm));
+	FRL_STEP(allm ? setAllmFlava3(true) : FRL_SEND(mask_7203));
+	/* Keep cleanup armed even if start partially succeeds. */
+	WRITE_ONCE(frl_output_active, true);
+	FRL_STEP(frl_send_start(start));
+	WRITE_ONCE(hdcp_abort_until, jiffies + msecs_to_jiffies(HDCP_ABORT_MS));
+	FRL_STEP(FRL_SEND(spd));
+	msleep(1000);
+	if (verify_ms) {
+		ret = frl_wait_link(verify_ms, &link);
+		if (ret == -ETIMEDOUT) {
+			pr_warn("native FRL: no FRL link, 7019 = %02x %u ms after the start; withholding FRL for this sink\n",
+				link, 1000 + verify_ms);
+			/* amdgpu then falls back to a mode that is still offered. */
+			ret = -EIO;
+			goto fail;
+		}
+		if (ret < 0)
+			goto fail;
+		pr_debug("native FRL: link up, 7019 = %02x %d ms after the start\n", link, 1000 + ret);
+	}
+	if (generation != frl_get_sink_generation()) {
+		ret = -ENODEV;
+		goto fail;
+	}
+	/* An unmute error must take the same recovery path as training errors. */
+	FRL_STEP(sceHdmiDeviceSetVideoMute(0));
+	if (READ_ONCE(frl_recovery))
+		FRL_STEP(frl_verify_output(plan));
+	if (generation != frl_get_sink_generation()) {
+		ret = -ENODEV;
+		goto fail;
+	}
+	hdr_enabled = frame != NULL;
+	bt2020_enabled = bt2020;
+	if (!allm_record(generation, allm, true)) {
+		ret = -ENODEV;
+		goto fail;
+	}
+	if (allm)
+		pr_debug("native FRL: ALLM on\n");
+	pr_info("native FRL: VIC %u, format %u, %u-bit, DP %u kbps, minimum FRL rate %u\n",
+		config.vic, config.format, config.bpc, config.dp_kbps, config.min_rate);
+	mutex_unlock(&frl_setup_lock);
+	return 0;
+
+fail:
+	pr_err("native FRL setup failed: %d; leaving video muted\n", ret);
+	/* A failed stop must not permit another FRL candidate to start. */
+	frl_record_failure(plan, frl_cleanup() != 0);
+	mutex_unlock(&frl_setup_lock);
+	return ret;
+}
+EXPORT_SYMBOL(ps5_hdmi_apply_plan);
+
+#undef FRL_STEP
+#undef FRL_SEND
diff --git a/drivers/ps5/frl-plan.inc b/drivers/ps5/frl-plan.inc
new file mode 100644
index 000000000000..060b4e15e194
--- /dev/null
+++ b/drivers/ps5/frl-plan.inc
@@ -0,0 +1,238 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+
+struct frl_caps {
+	u32 dp_kbps;
+	u32 generation;
+	u32 tmds_khz;
+	u8 sink_rate;
+	u8 converter_rate;
+	u8 formats;
+	u16 rgb_depths;
+	u16 y444_depths;
+	u16 y420_depths;
+	u16 failed_candidates;
+	bool prefer420;
+	u8 preferred_format;
+	bool limited;
+	bool scrambling;
+	bool enabled;
+};
+
+/* Character/line accounting follows AMD's uncompressed FRL capacity model. */
+static bool frl_capacity(const struct drm_display_mode *mode, u8 format, u8 bpc,
+			 u8 rate, u32 *required_kbps, u32 *capacity_kbps)
+{
+	static const u8 lanes[] = { 0, 3, 3, 4, 4, 4, 4 };
+	static const u8 gbps[] = { 0, 3, 6, 6, 8, 10, 12 };
+	u64 clock, chars, available, overhead, audio, blank, active, free, savings;
+	u64 capacity, active_ps, blank_ps, reference_ps, borrowed, average;
+	u32 numerator, denominator;
+
+	if (!rate || rate > 6 || mode->clock <= 0 || mode->clock > 2000000 ||
+	    mode->hdisplay <= 0 || mode->htotal <= mode->hdisplay ||
+	    mode->htotal > 65535 || (bpc != 8 && bpc != 10 && bpc != 12))
+		return false;
+	switch (format) {
+	case PS5_HDMI_RGB:
+	case PS5_HDMI_444:
+		numerator = bpc;
+		denominator = 8;
+		break;
+	case PS5_HDMI_422:
+		/* HDMI packs 4:2:2 in 12-bit containers even at 8/10 bpc. */
+		numerator = denominator = 1;
+		break;
+	case PS5_HDMI_420:
+		numerator = bpc;
+		denominator = 16;
+		break;
+	default:
+		return false;
+	}
+	/* Pixel +0.5%, link -300 ppm, superblock/FEC/map overhead +0.3%. */
+	clock = DIV_ROUND_UP_ULL((u64)mode->clock * 1005, 1000);
+	overhead = DIV_ROUND_UP_ULL((u64)(lanes[rate] * 10 + 345) * 1000000,
+				   10 * (2040 + lanes[rate])) + 3000;
+	chars = (u64)gbps[rate] * 1000000 * lanes[rate] * 9997;
+	capacity = div64_u64(chars * (1000000 - overhead), 180000000000ULL);
+	chars = div64_u64(chars * mode->htotal, clock * 180000);
+	available = div64_u64(chars * (1000000 - overhead), 1000000);
+	/* Reserve eight-channel 192 kHz LPCM plus ACR and audio tolerance. */
+	audio = DIV_ROUND_UP_ULL(195195ULL * mode->htotal, clock * 1000);
+	blank = DIV_ROUND_UP_ULL((u64)(mode->htotal - mode->hdisplay) * numerator,
+				 denominator);
+	active = DIV_ROUND_UP_ULL((u64)mode->hdisplay * numerator, denominator);
+	if (blank < 32 * (1 + audio))
+		return false;
+	free = blank > 32 * (1 + audio) + 7 ? blank - 32 * (1 + audio) - 7 : 0;
+	savings = free * 7 / 8;
+	savings = savings > 4 ? savings - 4 : 0;
+	chars = DIV_ROUND_UP_ULL(active * 3, 2) + blank - savings;
+	if (!capacity || chars > available)
+		return false;
+	/* Check scheduling against the 400-tribyte borrowing limit. */
+	active_ps = DIV_ROUND_UP_ULL(DIV_ROUND_UP_ULL(active * 3, 2) * 1000000000,
+				    capacity);
+	blank_ps = DIV_ROUND_UP_ULL(blank * 1000000000, capacity);
+	reference_ps = div64_u64((u64)(mode->htotal - mode->hdisplay) * 1000000000, clock);
+	if (blank_ps > reference_ps)
+		return false;
+	reference_ps = div64_u64((u64)mode->hdisplay * 1000000000, clock);
+	average = DIV_ROUND_UP_ULL(clock * (active + blank), mode->htotal);
+	borrowed = active_ps > reference_ps ? active_ps - reference_ps : 0;
+	if (DIV_ROUND_UP_ULL(borrowed * average, 1000000000) > 400)
+		return false;
+	*required_kbps = DIV_ROUND_UP_ULL(chars * 16 * clock, mode->htotal);
+	*capacity_kbps = capacity * 16;
+	return true;
+}
+
+static bool frl_profile_config(const struct drm_display_mode *mode,
+			       struct ps5_hdmi_frl_config *config)
+{
+	if (drm_match_cea_mode(mode) == 97) {
+		*config = (struct ps5_hdmi_frl_config) {
+			.vic = 97, .selector = 6, .min_rate = 4,
+		};
+		return true;
+	}
+	return frl_mode_config(mode, 10, config);
+}
+
+/* 4:2:0 carries one chroma pair for each 2x2 pixel block. */
+static bool frl_420_aligned(const struct drm_display_mode *mode)
+{
+	return !(mode->hdisplay & 1) && !(mode->hsync_start & 1) &&
+	       !(mode->hsync_end & 1) && !(mode->htotal & 1) &&
+	       !(mode->vdisplay & 1);
+}
+
+static u64 frl_dp_kbps(const struct drm_display_mode *mode, u8 format, u8 bpc)
+{
+	u64 bits = (u64)mode->clock * bpc;
+
+	if (format == PS5_HDMI_420)
+		return DIV_ROUND_UP_ULL(bits * 3, 2);
+	return bits * (format == PS5_HDMI_422 ? 2 : 3);
+}
+
+static bool frl_plan_valid(const struct ps5_hdmi_plan *plan)
+{
+	struct ps5_hdmi_frl_config profile;
+	const struct ps5_hdmi_frl_config *config = &plan->config;
+	u64 dp;
+
+	if (plan->mode.clock <= 0 || !frl_profile_config(&plan->mode, &profile) ||
+	    config->vic != profile.vic || config->selector != profile.selector ||
+	    config->min_rate != profile.min_rate || config->format > PS5_HDMI_420 ||
+	    plan->input_format != config->format || plan->output_format != config->format ||
+	    (config->bpc != 8 && config->bpc != 10 && config->bpc != 12) ||
+	    (plan->hdr && (config->bpc < 10 ||
+			   plan->metadata.eotf != HDMI_EOTF_SMPTE_ST2084)) ||
+	    (config->format != PS5_HDMI_RGB && !config->limited))
+		return false;
+	if (config->format == PS5_HDMI_420 && !frl_420_aligned(&plan->mode))
+		return false;
+	if (config->vic != 97 && config->format != PS5_HDMI_420 &&
+	    (config->format != PS5_HDMI_422 || config->bpc > 10))
+		return false;
+	dp = frl_dp_kbps(&plan->mode, config->format, config->bpc);
+	return dp <= 25920000 && dp == config->dp_kbps;
+}
+
+/* Prefer full chroma and depth, retaining the existing legal TMDS paths. */
+static enum ps5_hdmi_plan_status
+frl_select_plan(const struct drm_display_mode *mode, const struct frl_caps *caps,
+		unsigned int max_bpc, const struct hdmi_drm_infoframe *metadata,
+		bool bt2020, struct ps5_hdmi_plan *plan)
+{
+	struct ps5_hdmi_plan candidate = { .mode = *mode };
+	enum ps5_hdmi_plan_status reason = PS5_HDMI_PLAN_FORMAT;
+	u64 dp;
+	u8 rate, bpc, format, index, minimum = metadata ? 10 : 8;
+	u8 order[4] = { PS5_HDMI_RGB, PS5_HDMI_444, PS5_HDMI_422, PS5_HDMI_420 };
+
+	if (!caps->enabled)
+		return PS5_HDMI_PLAN_BACKEND;
+	if (caps->sink_rate > 6 || caps->converter_rate > 4)
+		return PS5_HDMI_PLAN_HDMI;
+	if (mode->clock <= 0 || !frl_profile_config(mode, &candidate.config))
+		return PS5_HDMI_PLAN_TIMING;
+	if (max_bpc < minimum || (metadata && metadata->eotf != HDMI_EOTF_SMPTE_ST2084))
+		return PS5_HDMI_PLAN_DEPTH;
+	if (caps->preferred_format == PS5_HDMI_444) {
+		order[0] = PS5_HDMI_444;
+		order[1] = PS5_HDMI_422;
+		order[2] = PS5_HDMI_RGB;
+	}
+	if (caps->prefer420) {
+		memmove(order + 1, order, 3);
+		order[0] = PS5_HDMI_420;
+	}
+	for (index = 0; index < ARRAY_SIZE(order); index++) {
+		format = order[index];
+		if (candidate.config.vic != 97 && format != PS5_HDMI_422 && format != PS5_HDMI_420)
+			continue;
+		if (format == PS5_HDMI_420 && !frl_420_aligned(mode))
+			continue;
+		if (!(caps->formats & BIT(format)))
+			continue;
+		reason = PS5_HDMI_PLAN_DEPTH;
+		for (bpc = max_bpc >= 12 ? 12 : max_bpc >= 10 ? 10 : 8;
+		     bpc >= minimum; bpc -= 2) {
+			if (caps->failed_candidates & frl_failure_bit(format, bpc))
+				continue;
+			if (candidate.config.vic != 97 && format != PS5_HDMI_420 && bpc > 10)
+				continue;
+			if (format == PS5_HDMI_RGB && !(caps->rgb_depths & BIT(bpc)))
+				continue;
+			if (format == PS5_HDMI_444 && !(caps->y444_depths & BIT(bpc)))
+				continue;
+			if (format == PS5_HDMI_420 && !(caps->y420_depths & BIT(bpc)))
+				continue;
+			dp = frl_dp_kbps(mode, format, bpc);
+			if (dp > caps->dp_kbps) {
+				reason = PS5_HDMI_PLAN_DP;
+				continue;
+			}
+			candidate.rate_mask = 0;
+			candidate.frl = format == PS5_HDMI_420 || candidate.config.vic != 97 ||
+					(format != PS5_HDMI_422 && (format != PS5_HDMI_RGB || bpc > 8));
+			if ((u32)mode->clock > caps->tmds_khz || (mode->clock > 340000 && !caps->scrambling))
+				candidate.frl = true;
+			if (!candidate.frl)
+				goto selected;
+			for (rate = candidate.config.min_rate;
+			     rate <= min(caps->sink_rate, caps->converter_rate); rate++) {
+				u32 required, capacity;
+
+				if (!frl_capacity(mode, format, bpc, rate, &required, &capacity))
+					continue;
+				if (!candidate.rate_mask) {
+					candidate.hdmi_kbps = required;
+					candidate.hdmi_capacity_kbps = capacity;
+				}
+				candidate.rate_mask |= BIT(rate);
+			}
+			if (!candidate.rate_mask) {
+				reason = PS5_HDMI_PLAN_HDMI;
+				continue;
+			}
+selected:
+			candidate.config.bpc = bpc;
+			candidate.config.format = format;
+			candidate.config.limited = format == PS5_HDMI_RGB ? caps->limited : true;
+			candidate.config.dp_kbps = dp;
+			candidate.input_format = format;
+			candidate.output_format = format;
+			candidate.generation = caps->generation;
+			candidate.hdr = metadata != NULL;
+			candidate.bt2020 = bt2020;
+			if (metadata)
+				candidate.metadata = *metadata;
+			*plan = candidate;
+			return PS5_HDMI_PLAN_OK;
+		}
+	}
+	return reason;
+}
diff --git a/drivers/ps5/frl-recovery.inc b/drivers/ps5/frl-recovery.inc
new file mode 100644
index 000000000000..a2b12d65a71f
--- /dev/null
+++ b/drivers/ps5/frl-recovery.inc
@@ -0,0 +1,78 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Pure candidate accounting; callers hold the connection-state lock. */
+#define FRL_RECOVERY_LIMIT 16
+
+struct frl_failed_candidate {
+	struct drm_display_mode mode;
+	u8 format;
+	u8 bpc;
+	u8 flags;
+};
+
+struct frl_failure_cache {
+	struct frl_failed_candidate candidates[FRL_RECOVERY_LIMIT];
+	u8 count;
+};
+
+static u16 frl_failure_bit(u8 format, u8 bpc)
+{
+	if (format > PS5_HDMI_420 || (bpc != 8 && bpc != 10 && bpc != 12))
+		return 0;
+	return BIT(format * 3 + (bpc - 8) / 2);
+}
+
+static bool frl_recovery_same_mode(const struct drm_display_mode *a,
+				  const struct drm_display_mode *b)
+{
+	return a->clock == b->clock && a->hdisplay == b->hdisplay &&
+	       a->hsync_start == b->hsync_start && a->hsync_end == b->hsync_end &&
+	       a->htotal == b->htotal && a->vdisplay == b->vdisplay &&
+	       a->vsync_start == b->vsync_start && a->vsync_end == b->vsync_end &&
+	       a->vtotal == b->vtotal && a->flags == b->flags &&
+	       a->picture_aspect_ratio == b->picture_aspect_ratio;
+}
+
+static u16 frl_failure_mask(const struct frl_failure_cache *cache,
+			    const struct drm_display_mode *mode, bool hdr,
+			    bool bt2020, bool rgb_limited)
+{
+	u16 mask = 0;
+	unsigned int i;
+
+	for (i = 0; i < cache->count; i++) {
+		const struct frl_failed_candidate *failed = &cache->candidates[i];
+		u8 flags = hdr | bt2020 << 1 |
+			   (failed->format == PS5_HDMI_RGB ? rgb_limited : true) << 2;
+
+		if (failed->flags == flags && frl_recovery_same_mode(mode, &failed->mode))
+			mask |= frl_failure_bit(failed->format, failed->bpc);
+	}
+	return mask;
+}
+
+static bool frl_failure_add(struct frl_failure_cache *cache,
+			    const struct ps5_hdmi_plan *plan)
+{
+	u16 bit = frl_failure_bit(plan->config.format, plan->config.bpc);
+	struct frl_failed_candidate *failed;
+
+	if (!bit)
+		return false;
+	if (frl_failure_mask(cache, &plan->mode, plan->hdr, plan->bt2020,
+			     plan->config.limited) & bit)
+		return true;
+	if (cache->count == FRL_RECOVERY_LIMIT)
+		return false;
+	failed = &cache->candidates[cache->count++];
+	failed->mode = plan->mode;
+	failed->format = plan->config.format;
+	failed->bpc = plan->config.bpc;
+	failed->flags = plan->hdr | plan->bt2020 << 1 | plan->config.limited << 2;
+	return true;
+}
+
+/* Zero means no current rate report; a positive report must fit the plan. */
+static bool frl_reported_rate_valid(u8 rate, u8 permitted)
+{
+	return !rate || (rate <= 4 && permitted & BIT(rate));
+}
diff --git a/drivers/ps5/hdmi.c b/drivers/ps5/hdmi.c
new file mode 100755
index 000000000000..5480fa02f749
--- /dev/null
+++ b/drivers/ps5/hdmi.c
@@ -0,0 +1,2355 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
+
+#include <linux/crc32.h>
+#include <linux/delay.h>
+#include <linux/hdmi.h>
+#include <linux/math64.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/ps5.h>
+#include <linux/sched.h>
+#include <linux/workqueue.h>
+#include <drm/drm_connector.h>
+#include <drm/drm_edid.h>
+#include <linux/unaligned.h>
+
+#define HDMI_IC_TYPE_FLAVA3	2
+#define HDMI_IC_TYPE_VERDE	3
+
+/* Allow for HDCP failing after output startup: event 4, or an abort about 3.2 s later. */
+#define HDCP_ABORT_MS		5000
+
+static int extended_modes = 1;
+module_param(extended_modes, int, 0444);
+MODULE_PARM_DESC(extended_modes, "Extended modes (0 = disabled, 1 = enabled (default), 2 = enabled and preferred)");
+
+static bool frl_4k120;
+module_param(frl_4k120, bool, 0644);
+MODULE_PARM_DESC(frl_4k120, "Enable experimental native FRL on FLAVA3, including 4K100/120 (default off)");
+
+static unsigned int frl_yuv420;
+module_param(frl_yuv420, uint, 0644);
+MODULE_PARM_DESC(frl_yuv420, "Experimental native FRL 4:2:0: 0 = disabled (default), 1 = fallback, 2 = prefer when the mode permits it");
+
+static bool frl_recovery;
+module_param(frl_recovery, bool, 0644);
+MODULE_PARM_DESC(frl_recovery, "Experimental bounded format/depth recovery after a native FRL failure (default off)");
+
+/* ALLM policy; the "allm" parameter is defined with its setter below. */
+static unsigned int allm;
+
+/*
+ * TMDS AVI content signalling. Clear IT content and content type when ALLM
+ * controls game mode; native FRL already uses this policy.
+ */
+static unsigned int allm_avi = 1;
+module_param(allm_avi, uint, 0644);
+MODULE_PARM_DESC(allm_avi, "TMDS AVI content from the next modeset: 0 = IT content Game, 1 = clear IT content/type while ALLM is enabled (default), 2 = always clear IT content/type");
+
+struct icc_i2c_msg {
+	u8 code;
+	u16 length;
+	u8 count;
+	u8 data[];
+} __packed;
+
+struct i2c_cmd_hdr {
+	u8 major;
+	u8 length;
+	u8 minor;
+	u8 count;
+	u8 data[];
+} __packed;
+
+struct i2c_cmd_2_1 {
+	u8 length;
+	u8 reg_high;
+	u8 reg_low;
+	u8 data[];
+} __packed;
+
+struct i2c_cmd_write {
+	u8 length;
+	u8 reg_high;
+	u8 reg_low;
+	u8 data[];
+} __packed;
+
+struct i2c_cmd_mask {
+	u8 length;
+	u8 reg_high;
+	u8 reg_low;
+	u8 value;
+	u8 mask[];
+} __packed;
+
+struct i2c_cmd_delay {
+	u8 length;
+	u8 time_low;
+	u8 time_high;
+	u8 unk_03;
+} __packed;
+
+struct i2c_cmd_waitset {
+	u8 length;
+	u8 reg_high;
+	u8 reg_low;
+	u8 value;
+} __packed;
+
+struct i2c_cmd_waitclear {
+	u8 length;
+	u8 reg_high;
+	u8 reg_low;
+	u8 value;
+} __packed;
+
+struct i2c_cmd_3_5 {
+	u8 length;
+	u8 reg_high;
+	u8 reg_low;
+	u8 value;
+} __packed;
+
+struct i2c_cmd_5_3 {
+	u8 value;
+} __packed;
+
+struct i2c_cmd_5_4 {
+	u8 value;
+} __packed;
+
+struct i2c_cmd_5_5 {
+	u8 value;
+} __packed;
+
+struct i2c_block {
+	u8 length;
+	u16 reg;
+	u8 data[32];
+};
+
+struct i2c_context {
+	struct i2c_block blocks[128];
+	int block_index;
+	u8 msg_buf[ICC_MSG_MAX_SIZE - sizeof(struct icc_msg)];
+	u8 *msg_cur;
+	struct icc_i2c_msg *msg_hdr;
+};
+
+static struct i2c_context i2c_ctx;
+static DEFINE_MUTEX(i2c_lock);
+
+static u8 hdmi_ic_type;
+static u8 tmds_polarity;
+static u8 tmds_ch_swap;
+static u8 dp_polarity;
+static u8 dp_ch_swap;
+static bool scrambling;
+static bool manual_timing;
+static bool frl_output_active;
+/* The FRL rate the IC trained with the sink, from its EDID notification */
+static u8 frl_trained_rate;
+module_param_named(frl_rate, frl_trained_rate, byte, 0444);
+MODULE_PARM_DESC(frl_rate, "FRL rate in byte 0 of the last EDID notification (read only)");
+static bool hdr_enabled;
+static bool bt2020_enabled;
+static unsigned long hdcp_abort_until;
+
+/* Track FRL failures for the current physical connection. */
+static DEFINE_MUTEX(frl_state_lock);
+static bool frl_edid_valid;
+static u32 frl_edid_crc;
+static unsigned int frl_sink_generation;
+static bool frl_failed;
+static u8 frl_rate_max;
+module_param_named(frl_rate_max, frl_rate_max, byte, 0444);
+MODULE_PARM_DESC(frl_rate_max, "Highest FRL rate the IC reported for the current connection (read only)");
+static bool sink_cta_422;
+static bool sink_cta_444;
+static u8 sink_y420_modes[256];
+static bool sink_allm;
+module_param_named(allm_sink, sink_allm, bool, 0444);
+MODULE_PARM_DESC(allm_sink, "Y if the sink advertises ALLM in its HF-VSDB or HF-SCDB (read only)");
+/* The connector content type is Game */
+static bool allm_game;
+/* Confirmed-on state; meaningful only while allm_valid is true. */
+static bool allm_active;
+/* A partial ICC failure makes the packet state unknown until a checked retry. */
+static bool allm_valid;
+module_param(allm_valid, bool, 0444);
+MODULE_PARM_DESC(allm_valid, "Y if ALLM state is confirmed for the current output (read only)");
+static bool allm_ready;
+module_param(allm_active, bool, 0444);
+MODULE_PARM_DESC(allm_active, "Y if ALLM is confirmed on; check allm_valid for unknown state (read only)");
+/* The last logged 4K120 decision, reset by each EDID notification */
+static int frl_decision_logged = -1;
+
+/* Defined in frl-native.inc; also serializes TMDS setups and live ALLM updates. */
+static struct mutex frl_setup_lock;
+static int frl_send_hdcp_mode(u8 value);
+static bool frl_plan_valid(const struct ps5_hdmi_plan *plan);
+static bool frl_mode_config(const struct drm_display_mode *mode, unsigned int max_bpc,
+			    struct ps5_hdmi_frl_config *config);
+
+#include "frl-detect.inc"
+#include "frl-recovery.inc"
+
+static struct frl_failure_cache frl_failures;
+
+static bool frl_sink_failed(void)
+{
+	bool failed;
+
+	mutex_lock(&frl_state_lock);
+	failed = frl_edid_valid && frl_failed;
+	mutex_unlock(&frl_state_lock);
+	return failed;
+}
+
+static unsigned int frl_get_sink_generation(void)
+{
+	unsigned int generation;
+
+	mutex_lock(&frl_state_lock);
+	generation = frl_sink_generation;
+	mutex_unlock(&frl_state_lock);
+	return generation;
+}
+
+static void frl_mark_failed(unsigned int generation)
+{
+	mutex_lock(&frl_state_lock);
+	if (frl_edid_valid && generation == frl_sink_generation)
+		frl_failed = true;
+	mutex_unlock(&frl_state_lock);
+}
+
+static void frl_record_failure(const struct ps5_hdmi_plan *plan, bool fatal)
+{
+	mutex_lock(&frl_state_lock);
+	if (frl_edid_valid && plan->generation == frl_sink_generation &&
+	    (!READ_ONCE(frl_recovery) || fatal || !frl_failure_add(&frl_failures, plan)))
+		frl_failed = true;
+	mutex_unlock(&frl_state_lock);
+}
+
+bool ps5_hdmi_recovery_enabled(void)
+{
+	return READ_ONCE(frl_recovery);
+}
+EXPORT_SYMBOL(ps5_hdmi_recovery_enabled);
+
+static int frl_failed_set(const char *val, const struct kernel_param *kp)
+{
+	bool mark;
+	int ret = kstrtobool(val, &mark);
+
+	if (ret)
+		return ret;
+	/* Nothing to mark before HDMI init, e.g. from the command line. */
+	if (!hdmi_ic_type)
+		return 0;
+	if (mark) {
+		frl_mark_failed(frl_get_sink_generation());
+	} else {
+		mutex_lock(&frl_state_lock);
+		frl_failed = false;
+		memset(&frl_failures, 0, sizeof(frl_failures));
+		mutex_unlock(&frl_state_lock);
+	}
+	WRITE_ONCE(frl_decision_logged, -1);
+	pr_info("native FRL %s for this display; replug or re-probe it to apply\n",
+		mark ? "disabled" : "allowed again");
+	return 0;
+}
+
+static int frl_failed_get(char *buf, const struct kernel_param *kp)
+{
+	return scnprintf(buf, PAGE_SIZE, "%c\n", frl_sink_failed() ? 'Y' : 'N');
+}
+
+static const struct kernel_param_ops frl_failed_ops = {
+	.set = frl_failed_set,
+	.get = frl_failed_get,
+};
+module_param_cb(frl_failed, &frl_failed_ops, NULL, 0644);
+MODULE_PARM_DESC(frl_failed, "Y after native FRL failed on this display; write N or replug to try FRL again");
+
+/* HDCP is off by default: authentication failures can leave the output muted. */
+static int hdcp_mode = 3;
+
+static int hdcp_mode_set(const char *val, const struct kernel_param *kp)
+{
+	int mode, ret = kstrtoint(val, 0, &mode);
+
+	if (ret)
+		return ret;
+	if (mode < -1 || mode > 3)
+		return -EINVAL;
+	WRITE_ONCE(hdcp_mode, mode);
+	/* Before HDMI init, hdmiSystemResume() sends it. */
+	if (mode >= 0 && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3)
+		pr_info("HDCP mode %d sent: %d\n", mode, frl_send_hdcp_mode(mode));
+	return 0;
+}
+
+static const struct kernel_param_ops hdcp_mode_ops = {
+	.set = hdcp_mode_set,
+	.get = param_get_int,
+};
+module_param_cb(hdcp_mode, &hdcp_mode_ops, &hdcp_mode, 0644);
+MODULE_PARM_DESC(hdcp_mode, "HDCP mode for the HDMI output, applied at the next mode set: -1 = keep the existing setting, 0 = on, 1 = off, 2 = on with HDCP 2.2, 3 = off with the HDCP 2.2 bit set (default)");
+
+static void i2c_init(u8 code)
+{
+	mutex_lock(&i2c_lock);
+	i2c_ctx.msg_cur = i2c_ctx.msg_buf;
+	i2c_ctx.msg_hdr = (struct icc_i2c_msg *)i2c_ctx.msg_cur;
+
+	i2c_ctx.msg_hdr->code = code;
+	i2c_ctx.msg_hdr->length = 0;
+	i2c_ctx.msg_hdr->count = 0;
+	i2c_ctx.block_index = -1;
+
+	i2c_ctx.msg_cur += sizeof(*i2c_ctx.msg_hdr);
+}
+
+static int i2c_exec(void)
+{
+	u8 buf[ICC_MSG_MAX_SIZE] = {};
+	struct icc_msg *msg = (struct icc_msg *)buf;
+	int ret;
+
+	i2c_ctx.msg_hdr->length = i2c_ctx.msg_cur - i2c_ctx.msg_buf;
+
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->msg_type = 0;
+	msg->length = sizeof(*msg) + i2c_ctx.msg_hdr->length;
+	memcpy(msg->data, i2c_ctx.msg_hdr, i2c_ctx.msg_hdr->length);
+	mutex_unlock(&i2c_lock);
+
+	ret = icc_query(buf, buf);
+	if (ret)
+		return ret;
+	if (msg->service_id != ICC_SERVICE_ID_HDMI || msg->msg_type != 0x4000 ||
+	    msg->length < sizeof(*msg) + 2 || msg->length > ICC_MSG_MAX_SIZE)
+		return -EPROTO;
+	if (msg->data[0] || msg->data[1])
+		return -EIO;
+
+	return 0;
+}
+
+static void i2c_write_block(struct i2c_block *block, size_t count)
+{
+	struct i2c_cmd_hdr *hdr = (struct i2c_cmd_hdr *)i2c_ctx.msg_cur;
+	int i;
+
+	hdr->major = 2;
+	hdr->minor = 2;
+	hdr->count = count;
+	hdr->length = sizeof(*hdr);
+	i2c_ctx.msg_cur += sizeof(*hdr);
+
+	for (i = 0; i < count; i++) {
+		struct i2c_cmd_write *cmd = (struct i2c_cmd_write *)i2c_ctx.msg_cur;
+
+		cmd->length = block[i].length;
+		cmd->reg_low = block[i].reg & 0xff;
+		cmd->reg_high = block[i].reg >> 8;
+		memcpy(cmd->data, block[i].data, block[i].length);
+
+		i2c_ctx.msg_cur += sizeof(*cmd) + cmd->length;
+		hdr->length += sizeof(*cmd) + cmd->length;
+	}
+
+	i2c_ctx.msg_hdr->count++;
+}
+
+static void i2c_begin_block(void)
+{
+	i2c_ctx.block_index = 0;
+}
+
+static void i2c_end_block(void)
+{
+	if (i2c_ctx.block_index > 0)
+		i2c_write_block(i2c_ctx.blocks, i2c_ctx.block_index);
+	i2c_ctx.block_index = -1;
+}
+
+static void i2c_write_data(u16 reg, u8 value[], size_t count)
+{
+	struct i2c_block *block;
+	bool new_block = i2c_ctx.block_index == -1;
+
+	if (new_block)
+		i2c_begin_block();
+
+	block = &i2c_ctx.blocks[i2c_ctx.block_index++];
+	block->reg = reg;
+	block->length = count;
+	memcpy(block->data, value, count);
+
+	if (new_block)
+		i2c_end_block();
+}
+
+static void i2c_write(u16 reg, u8 value)
+{
+	i2c_write_data(reg, &value, 1);
+}
+
+static void i2c_cmd_2_1(u16 reg, u8 unk)
+{
+	struct i2c_cmd_hdr *hdr = (struct i2c_cmd_hdr *)i2c_ctx.msg_cur;
+	hdr->major = 2;
+	hdr->minor = 1;
+	hdr->count = 1;
+	hdr->length = sizeof(*hdr);
+	i2c_ctx.msg_cur += sizeof(*hdr);
+
+	struct i2c_cmd_2_1 *cmd = (struct i2c_cmd_2_1 *)i2c_ctx.msg_cur;
+	cmd->length = 1;
+	cmd->reg_low = reg & 0xff;
+	cmd->reg_high = reg >> 8;
+	cmd->data[0] = unk;
+	i2c_ctx.msg_cur += sizeof(*cmd) + cmd->length;
+	hdr->length += sizeof(*cmd) + cmd->length;
+
+	i2c_ctx.msg_hdr->count++;
+}
+
+static void i2c_delay(u16 time)
+{
+	struct i2c_cmd_hdr *hdr = (struct i2c_cmd_hdr *)i2c_ctx.msg_cur;
+	hdr->major = 3;
+	hdr->minor = 1;
+	hdr->count = 1;
+	hdr->length = sizeof(*hdr);
+	i2c_ctx.msg_cur += sizeof(*hdr);
+
+	struct i2c_cmd_delay *cmd = (struct i2c_cmd_delay *)i2c_ctx.msg_cur;
+	cmd->length = 0;
+	cmd->time_low = time & 0xff;
+	cmd->time_high = time >> 8;
+	cmd->unk_03 = 0;
+	i2c_ctx.msg_cur += sizeof(*cmd) + cmd->length;
+	hdr->length += sizeof(*cmd) + cmd->length;
+
+	i2c_ctx.msg_hdr->count++;
+}
+
+static void i2c_mask(u16 reg, u8 value, u8 mask)
+{
+	struct i2c_cmd_hdr *hdr = (struct i2c_cmd_hdr *)i2c_ctx.msg_cur;
+	hdr->major = 2;
+	hdr->minor = 3;
+	hdr->count = 1;
+	hdr->length = sizeof(*hdr);
+	i2c_ctx.msg_cur += sizeof(*hdr);
+
+	struct i2c_cmd_mask *cmd = (struct i2c_cmd_mask *)i2c_ctx.msg_cur;
+	cmd->length = 1;
+	cmd->reg_low = reg & 0xff;
+	cmd->reg_high = reg >> 8;
+	cmd->value = value;
+	cmd->mask[0] = mask;
+	i2c_ctx.msg_cur += sizeof(*cmd) + cmd->length;
+	hdr->length += sizeof(*cmd) + cmd->length;
+
+	i2c_ctx.msg_hdr->count++;
+}
+
+static void i2c_waitset(u16 reg, u8 value)
+{
+	struct i2c_cmd_hdr *hdr = (struct i2c_cmd_hdr *)i2c_ctx.msg_cur;
+	hdr->major = 3;
+	hdr->minor = 2;
+	hdr->count = 1;
+	hdr->length = sizeof(*hdr);
+	i2c_ctx.msg_cur += sizeof(*hdr);
+
+	struct i2c_cmd_waitset *cmd = (struct i2c_cmd_waitset *)i2c_ctx.msg_cur;
+	cmd->length = 0;
+	cmd->reg_low = reg & 0xff;
+	cmd->reg_high = reg >> 8;
+	cmd->value = value;
+	i2c_ctx.msg_cur += sizeof(*cmd) + cmd->length;
+	hdr->length += sizeof(*cmd) + cmd->length;
+
+	i2c_ctx.msg_hdr->count++;
+}
+
+static void i2c_waitclear(u16 reg, u8 value)
+{
+	struct i2c_cmd_hdr *hdr = (struct i2c_cmd_hdr *)i2c_ctx.msg_cur;
+	hdr->major = 3;
+	hdr->minor = 3;
+	hdr->count = 1;
+	hdr->length = sizeof(*hdr);
+	i2c_ctx.msg_cur += sizeof(*hdr);
+
+	struct i2c_cmd_waitclear *cmd = (struct i2c_cmd_waitclear *)i2c_ctx.msg_cur;
+	cmd->length = 0;
+	cmd->reg_low = reg & 0xff;
+	cmd->reg_high = reg >> 8;
+	cmd->value = value;
+	i2c_ctx.msg_cur += sizeof(*cmd) + cmd->length;
+	hdr->length += sizeof(*cmd) + cmd->length;
+
+	i2c_ctx.msg_hdr->count++;
+}
+
+static void i2c_cmd_3_5(u16 reg, u8 value)
+{
+	struct i2c_cmd_hdr *hdr = (struct i2c_cmd_hdr *)i2c_ctx.msg_cur;
+	hdr->major = 3;
+	hdr->minor = 5;
+	hdr->count = 1;
+	hdr->length = sizeof(*hdr);
+	i2c_ctx.msg_cur += sizeof(*hdr);
+
+	struct i2c_cmd_3_5 *cmd = (struct i2c_cmd_3_5 *)i2c_ctx.msg_cur;
+	cmd->length = 0;
+	cmd->reg_low = reg & 0xff;
+	cmd->reg_high = reg >> 8;
+	cmd->value = value;
+	i2c_ctx.msg_cur += sizeof(*cmd) + cmd->length;
+	hdr->length += sizeof(*cmd) + cmd->length;
+
+	i2c_ctx.msg_hdr->count++;
+}
