+static void dm_ps5_set_hdr_timing(struct dc_crtc_timing *timing,
+				  const struct drm_display_mode *mode,
+				  const struct drm_connector_state *state)
+{
+	const struct drm_display_info *info = &state->connector->display_info;
+	struct hdmi_drm_infoframe frame;
+	u8 vic = drm_match_cea_mode(mode);
+
+	if (!dm_ps5_is_hdmi_connector(state->connector) ||
+	    !isHdmiHdrSupported() || !state->hdr_output_metadata ||
+	    !isHdmiSink422(info) ||
+	    timing->pixel_encoding != PIXEL_ENCODING_RGB ||
+	    timing->display_color_depth < COLOR_DEPTH_121212)
+		return;
+	if (state->colorspace != DRM_MODE_COLORIMETRY_BT2020_RGB &&
+	    state->colorspace != DRM_MODE_COLORIMETRY_BT2020_YCC)
+		return;
+	/* Preserve the stock 1080p60 and 2160p60 HDR rule when disabled. */
+	if (!getHdmiExtendedModes() && vic != 16 && vic != 97)
+		return;
+	if (drm_hdmi_infoframe_set_hdr_metadata(&frame, state) ||
+	    frame.eotf != HDMI_EOTF_SMPTE_ST2084)
+		return;
+
+	/* 12 bpc YCbCr422 uses the same TMDS clock as 8 bpc RGB. */
+	timing->pixel_encoding = PIXEL_ENCODING_YCBCR422;
+	timing->display_color_depth = COLOR_DEPTH_121212;
+}
+
+/* Projection of the selected atomic plan into the GPU stream. */
+static void dm_ps5_apply_frl_timing(struct dc_crtc_timing *timing,
+				    const struct ps5_hdmi_plan *plan)
+{
+	timing->pixel_encoding = plan->config.format == PS5_HDMI_RGB ? PIXEL_ENCODING_RGB :
+		plan->config.format == PS5_HDMI_444 ? PIXEL_ENCODING_YCBCR444 :
+		plan->config.format == PS5_HDMI_420 ? PIXEL_ENCODING_YCBCR420 :
+		PIXEL_ENCODING_YCBCR422;
+	timing->display_color_depth = plan->config.bpc == 12 ? COLOR_DEPTH_121212 :
+		plan->config.bpc == 10 ? COLOR_DEPTH_101010 : COLOR_DEPTH_888;
+}
