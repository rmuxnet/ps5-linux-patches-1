+
+static int ps5_cec_command(u8 code, u8 major, u8 minor,
+			   const u8 *data, unsigned int len)
+{
+	struct icc_msg *msg;
+	int ret;
+
+	msg = kzalloc(ICC_MSG_MAX_SIZE, GFP_KERNEL);
+	if (!msg)
+		return -ENOMEM;
+
+	msg->service_id = ICC_SERVICE_ID_HDMI;
+	msg->length = max_t(u16, ICC_MSG_MIN_SIZE, sizeof(*msg) + 8 + len);
+	msg->data[0] = code;
+	put_unaligned_le16(8 + len, &msg->data[1]);
+	msg->data[3] = 1;
+	msg->data[4] = major;
+	msg->data[5] = (4 + len) & 0xff;
+	msg->data[6] = minor;
+	msg->data[7] = 1;
+	memcpy(&msg->data[8], data, len);
+
+	ret = icc_query((u8 *)msg, (u8 *)msg);
+	if (!ret && (msg->service_id != ICC_SERVICE_ID_HDMI ||
+		     msg->length < sizeof(*msg) + 2 ||
+		     msg->data[0] || msg->data[1]))
+		ret = -EIO;
+
+	kfree(msg);
+	return ret;
+}
+
+static int ps5_cec_set_enable(bool enable)
+{
+	u8 data = enable;
+
+	return ps5_cec_command(0x04, 0x05, 0x02, &data, 1);
+}
+
+/* Forward every opcode to the host. Without a table the bridge forwards nothing. */
+static int ps5_cec_set_opcode_table(void)
+{
+	u8 table[256];
+
+	memset(table, 0x01, sizeof(table));
+	return ps5_cec_command(0x00, 0x04, 0x06, table, sizeof(table));
+}
+
+static int ps5_cec_send_frame(const u8 *frame, unsigned int len)
+{
+	u8 data[4 + CEC_MAX_MSG_SIZE] = {};
+
+	data[0] = 1;
+	data[1] = len;
+	memcpy(&data[2], frame, len);
+	return ps5_cec_command(0x04, 0x06, 0x01, data, 4 + len);
+}
+
+static bool ps5_cec_is_power_off(const u8 *msg, unsigned int len)
+{
+	if (len < 2)
+		return false;
+	if (msg[1] == CEC_MSG_STANDBY)
+		return true;
+	if (msg[1] != CEC_MSG_USER_CONTROL_PRESSED || len < 3)
+		return false;
+
+	switch (msg[2]) {
+	case CEC_OP_UI_CMD_POWER:
+	case CEC_OP_UI_CMD_POWER_TOGGLE_FUNCTION:
+	case CEC_OP_UI_CMD_POWER_OFF_FUNCTION:
+	case CEC_OP_UI_CMD_POWER_ON_FUNCTION:
+		return true;
+	}
+	return false;
+}
+
+static void ps5_cec_request_query(struct ps5_cec *cec, unsigned int delay_ms)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&cec->addr_lock, flags);
+	cec->query_mark = cec->rx_count;
+	cec->query_retries = 0;
+	spin_unlock_irqrestore(&cec->addr_lock, flags);
+
+	mod_delayed_work(system_percpu_wq, &cec->query_work,
+			 msecs_to_jiffies(delay_ms));
+}
+
+static void ps5_cec_edid(struct ps5_cec *cec, const u8 *data, unsigned int len)
+{
+	unsigned int size = get_unaligned_le16(&data[2]);
+	unsigned long flags;
+	u16 pa;
+
+	if (size > len - 4)
+		return;
+	pa = cec_get_edid_phys_addr(&data[4], size, NULL);
+
+	spin_lock_irqsave(&cec->addr_lock, flags);
+	cec->edid_pa = pa;
+	spin_unlock_irqrestore(&cec->addr_lock, flags);
+
+	if (!READ_ONCE(cec->setup_done)) {
+		mod_delayed_work(system_percpu_wq, &cec->setup_work,
+				 msecs_to_jiffies(PS5_CEC_SETUP_DELAY_MS));
+		return;
+	}
+
+	schedule_work(&cec->config_work);
+	ps5_cec_request_query(cec, 1000);
+}
+
+static void ps5_cec_rx(struct ps5_cec *cec, const u8 *data, unsigned int len)
+{
+	struct ps5_cec_frame *frame;
+	unsigned long flags;
+	unsigned int flen;
+	bool changed = false;
+	u16 pa;
+	u8 la;
+
+	if (len < 10)
+		return;
+	flen = data[8];
+	if (!flen || flen > CEC_MAX_MSG_SIZE || 9 + flen > len)
+		return;
+
+	pa = get_unaligned_be16(&data[5]);
+	la = data[7];
+	if (la < CEC_LOG_ADDR_UNREGISTERED) {
+		spin_lock_irqsave(&cec->addr_lock, flags);
+		changed = cec->bridge_pa != pa || cec->bridge_la != la;
+		cec->bridge_pa = pa;
+		cec->bridge_la = la;
+		cec->rx_count++;
+		spin_unlock_irqrestore(&cec->addr_lock, flags);
+	}
+	if (changed)
+		schedule_work(&cec->config_work);
+
+	if (ps5_cec_is_power_off(&data[9], flen)) {
+		dev_info(cec->dev, "ignoring power off request %*ph\n",
+			 flen, &data[9]);
+		return;
+	}
+
+	spin_lock_irqsave(&cec->rx_lock, flags);
+	if (cec->rx_head - cec->rx_tail < PS5_CEC_RX_QUEUE_SIZE) {
+		frame = &cec->rx_queue[cec->rx_head++ % PS5_CEC_RX_QUEUE_SIZE];
+		frame->len = flen;
+		memcpy(frame->msg, &data[9], flen);
+	}
+	spin_unlock_irqrestore(&cec->rx_lock, flags);
+	schedule_work(&cec->rx_work);
+}
+
+static void ps5_cec_tx_result(struct ps5_cec *cec, const u8 *data,
+			      unsigned int len)
+{
+	unsigned long flags;
+	u8 status;
+
+	if (len < 7)
+		return;
+
+	switch (data[6]) {
+	case CEC_TX_RESULT_ACK:
+		status = CEC_TX_STATUS_OK;
+		break;
+	case CEC_TX_RESULT_NACK:
+		status = CEC_TX_STATUS_NACK;
+		break;
+	default:
+		status = CEC_TX_STATUS_ERROR;
+		break;
+	}
+
+	spin_lock_irqsave(&cec->tx_lock, flags);
+	if (cec->query_pending) {
+		complete(&cec->query_done);
+	} else if (cec->tx_pending && !cec->tx_done) {
+		cec->tx_status = status;
+		cec->tx_done = true;
+		schedule_work(&cec->tx_work);
+	}
+	spin_unlock_irqrestore(&cec->tx_lock, flags);
+}
+
+static void ps5_cec_notify(void *data, const struct icc_msg *msg)
+{
+	struct ps5_cec *cec = data;
+	unsigned int len;
+
+	if (msg->length < sizeof(*msg) + 4 || msg->length > ICC_MSG_MAX_SIZE)
+		return;
+	len = msg->length - sizeof(*msg);
+
+	switch (msg->data[1]) {
+	case HDMI_EVENT_EDID:
+		ps5_cec_edid(cec, msg->data, len);
+		break;
+	case HDMI_EVENT_CEC_RX:
+		ps5_cec_rx(cec, msg->data, len);
+		break;
+	case HDMI_EVENT_CEC_TX:
+		ps5_cec_tx_result(cec, msg->data, len);
+		break;
+	}
+}
+
+static void ps5_cec_tx_finish(struct ps5_cec *cec)
+{
+	unsigned long flags;
+	bool done;
+	u8 status;
+
+	spin_lock_irqsave(&cec->tx_lock, flags);
+	done = cec->tx_pending && cec->tx_done;
+	if (done)
+		cec->tx_pending = false;
+	status = cec->tx_status;
+	spin_unlock_irqrestore(&cec->tx_lock, flags);
+
+	if (done)
+		cec_transmit_attempt_done(cec->adap, status);
+}
+
+static void ps5_cec_tx_work(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(work, struct ps5_cec, tx_work);
+
+	cancel_delayed_work_sync(&cec->tx_timeout);
+	ps5_cec_tx_finish(cec);
+}
+
+static void ps5_cec_tx_timeout(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(to_delayed_work(work),
+					   struct ps5_cec, tx_timeout);
+	unsigned long flags;
+
+	spin_lock_irqsave(&cec->tx_lock, flags);
+	if (cec->tx_pending && !cec->tx_done) {
+		cec->tx_status = CEC_TX_STATUS_ERROR;
+		cec->tx_done = true;
+	}
+	spin_unlock_irqrestore(&cec->tx_lock, flags);
+
+	ps5_cec_tx_finish(cec);
+}
+
+static void ps5_cec_rx_work(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(work, struct ps5_cec, rx_work);
+	struct ps5_cec_frame *frame;
+	unsigned long flags;
+	struct cec_msg msg;
+
+	for (;;) {
+		memset(&msg, 0, sizeof(msg));
+
+		spin_lock_irqsave(&cec->rx_lock, flags);
+		if (cec->rx_tail == cec->rx_head) {
+			spin_unlock_irqrestore(&cec->rx_lock, flags);
+			break;
+		}
+		frame = &cec->rx_queue[cec->rx_tail++ % PS5_CEC_RX_QUEUE_SIZE];
+		msg.len = frame->len;
+		memcpy(msg.msg, frame->msg, frame->len);
+		spin_unlock_irqrestore(&cec->rx_lock, flags);
+
+		cec_received_msg(cec->adap, &msg);
+	}
+}
+
+static void ps5_cec_query_work(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(to_delayed_work(work),
+					   struct ps5_cec, query_work);
+	struct cec_adapter *adap = cec->adap;
+	u8 initiator = CEC_LOG_ADDR_SPECIFIC;
+	unsigned int retry;
+	unsigned long flags;
+	bool busy = true;
+	u8 query[2];
+
+	spin_lock_irqsave(&cec->addr_lock, flags);
+	if (cec->rx_count != cec->query_mark ||
+	    cec->query_retries >= PS5_CEC_QUERY_RETRIES) {
+		spin_unlock_irqrestore(&cec->addr_lock, flags);
+		return;
+	}
+	retry = cec->query_retries;
+	if (cec->bridge_la < CEC_LOG_ADDR_UNREGISTERED)
+		initiator = cec->bridge_la;
+	spin_unlock_irqrestore(&cec->addr_lock, flags);
+
+	mutex_lock(&adap->lock);
+	if (adap->is_configured)
+		initiator = adap->log_addrs.log_addr[0];
+	mutex_unlock(&adap->lock);
+
+	query[0] = initiator << 4 | CEC_LOG_ADDR_TV;
+	query[1] = CEC_MSG_GIVE_PHYSICAL_ADDR;
+
+	mutex_lock(&cec->lock);
+	if (!cec->enabled) {
+		mutex_unlock(&cec->lock);
+		return;
+	}
+
+	spin_lock_irqsave(&cec->tx_lock, flags);
+	if (!cec->tx_pending) {
+		busy = false;
+		cec->query_pending = true;
+		reinit_completion(&cec->query_done);
+	}
+	spin_unlock_irqrestore(&cec->tx_lock, flags);
+
+	if (!busy) {
+		unsigned long timeout = msecs_to_jiffies(PS5_CEC_TX_TIMEOUT_MS);
+
+		if (!ps5_cec_send_frame(query, sizeof(query)))
+			wait_for_completion_timeout(&cec->query_done, timeout);
+
+		spin_lock_irqsave(&cec->tx_lock, flags);
+		cec->query_pending = false;
+		spin_unlock_irqrestore(&cec->tx_lock, flags);
+	}
+	mutex_unlock(&cec->lock);
+
+	if (busy) {
+		schedule_delayed_work(&cec->query_work, msecs_to_jiffies(100));
+		return;
+	}
+
+	spin_lock_irqsave(&cec->addr_lock, flags);
+	cec->query_retries++;
+	spin_unlock_irqrestore(&cec->addr_lock, flags);
+	schedule_delayed_work(&cec->query_work, msecs_to_jiffies(1000 << retry));
+}
+
+static void ps5_cec_config_work(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(work, struct ps5_cec, config_work);
+	struct cec_adapter *adap = cec->adap;
+	unsigned long flags;
+	bool reclaim;
+	u16 pa;
+	u8 la;
+
+	spin_lock_irqsave(&cec->addr_lock, flags);
+	pa = cec->edid_pa != CEC_PHYS_ADDR_INVALID ? cec->edid_pa : cec->bridge_pa;
+	la = cec->bridge_la;
+	spin_unlock_irqrestore(&cec->addr_lock, flags);
+
+	if (pa == CEC_PHYS_ADDR_INVALID || la >= CEC_LOG_ADDR_UNREGISTERED)
+		return;
+
+	mutex_lock(&adap->lock);
+	reclaim = adap->phys_addr == pa && la != cec->claimed_la &&
+		  adap->log_addrs.num_log_addrs &&
+		  adap->log_addrs.log_addr[0] != la;
+	mutex_unlock(&adap->lock);
+
+	cec->claimed_la = la;
+	if (reclaim)
+		cec_phys_addr_invalidate(adap);
+	cec_s_phys_addr(adap, pa, false);
+}
+
+static void ps5_cec_key_release(struct ps5_cec *cec)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&cec->key_lock, flags);
+	if (cec->key) {
+		input_report_key(cec->input, cec->key, 0);
+		input_sync(cec->input);
+		cec->key = 0;
+	}
+	spin_unlock_irqrestore(&cec->key_lock, flags);
+}
+
+static void ps5_cec_key_press(struct ps5_cec *cec, u8 code)
+{
+	unsigned int key = 0;
+	unsigned long flags;
+
+	if (code < ARRAY_SIZE(ps5_cec_keymap))
+		key = ps5_cec_keymap[code];
+
+	spin_lock_irqsave(&cec->key_lock, flags);
+	if (cec->key && cec->key != key) {
+		input_report_key(cec->input, cec->key, 0);
+		input_sync(cec->input);
+		cec->key = 0;
+	}
+	if (key && !cec->key) {
+		input_report_key(cec->input, key, 1);
+		input_sync(cec->input);
+		cec->key = key;
+	}
+	spin_unlock_irqrestore(&cec->key_lock, flags);
+
+	if (key)
+		mod_delayed_work(system_percpu_wq, &cec->key_work,
+				 msecs_to_jiffies(PS5_CEC_KEY_TIMEOUT_MS));
+}
+
+static void ps5_cec_key_work(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(to_delayed_work(work),
+					   struct ps5_cec, key_work);
+
+	ps5_cec_key_release(cec);
+}
+
+static void ps5_cec_announce(struct ps5_cec *cec)
+{
+	struct cec_adapter *adap = cec->adap;
+	struct cec_msg msg = {};
+
+	cec_msg_init(&msg, adap->log_addrs.log_addr[0], CEC_LOG_ADDR_BROADCAST);
+	cec_msg_active_source(&msg, adap->phys_addr);
+	cec_transmit_msg(adap, &msg, false);
+}
+
+static void ps5_cec_otp_work(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(work, struct ps5_cec, otp_work);
+	struct cec_adapter *adap = cec->adap;
+	struct cec_msg msg = {};
+	u8 la = CEC_LOG_ADDR_INVALID;
+	int i;
+
+	if (cec->otp_done)
+		return;
+
+	mutex_lock(&adap->lock);
+	if (adap->is_configured)
+		la = adap->log_addrs.log_addr[0];
+	mutex_unlock(&adap->lock);
+	if (la >= CEC_LOG_ADDR_UNREGISTERED)
+		return;
+	cec->otp_done = true;
+
+	cec_msg_init(&msg, la, CEC_LOG_ADDR_TV);
+	cec_msg_image_view_on(&msg);
+	cec_transmit_msg(adap, &msg, true);
+
+	/* The TV restores its last input while it starts */
+	for (i = 0; i < PS5_CEC_OTP_POLLS; i++) {
+		cec_msg_init(&msg, la, CEC_LOG_ADDR_TV);
+		cec_msg_give_device_power_status(&msg, true);
+		if (cec_transmit_msg(adap, &msg, true) ||
+		    !(msg.rx_status & CEC_RX_STATUS_OK) ||
+		    msg.msg[1] != CEC_MSG_REPORT_POWER_STATUS ||
+		    msg.msg[2] == CEC_OP_POWER_STATUS_ON)
+			break;
+		msleep(500);
+	}
+
+	ps5_cec_announce(cec);
+}
+
+static void ps5_cec_route(struct ps5_cec *cec, u16 pa, bool announce)
+{
+	cec->active_source = pa == cec->adap->phys_addr;
+	if (cec->active_source && announce)
+		ps5_cec_announce(cec);
+}
+
+static int ps5_cec_received(struct cec_adapter *adap, struct cec_msg *msg)
+{
+	struct ps5_cec *cec = cec_get_drvdata(adap);
+	bool directed = !cec_msg_is_broadcast(msg) &&
+			cec_msg_initiator(msg) != CEC_LOG_ADDR_UNREGISTERED;
+	bool reply = !adap->cec_follower;
+	struct cec_msg tx = {};
+
+	switch (msg->msg[1]) {
+	case CEC_MSG_USER_CONTROL_PRESSED:
+		if (directed && reply && msg->len >= 3)
+			ps5_cec_key_press(cec, msg->msg[2]);
+		break;
+
+	case CEC_MSG_USER_CONTROL_RELEASED:
+		if (directed)
+			ps5_cec_key_release(cec);
+		break;
+
+	case CEC_MSG_GIVE_DEVICE_POWER_STATUS:
+		if (!directed || !reply)
+			break;
+		cec_msg_set_reply_to(&tx, msg);
+		cec_msg_report_power_status(&tx, CEC_OP_POWER_STATUS_ON);
+		cec_transmit_msg(adap, &tx, false);
+		return 0;
+
+	case CEC_MSG_MENU_REQUEST:
+		if (!directed || !reply)
+			break;
+		cec_msg_set_reply_to(&tx, msg);
+		cec_msg_menu_status(&tx, CEC_OP_MENU_STATE_ACTIVATED);
+		cec_transmit_msg(adap, &tx, false);
+		return 0;
+
+	case CEC_MSG_ACTIVE_SOURCE:
+		cec->active_source = false;
+		break;
+
+	case CEC_MSG_SET_STREAM_PATH:
+		if (msg->len >= 4)
+			ps5_cec_route(cec, get_unaligned_be16(&msg->msg[2]), reply);
+		break;
+
+	/* Not answered: another source re-claiming the TV would make it bounce */
+	case CEC_MSG_ROUTING_INFORMATION:
+		if (msg->len >= 4)
+			ps5_cec_route(cec, get_unaligned_be16(&msg->msg[2]), false);
+		break;
+
+	case CEC_MSG_ROUTING_CHANGE:
+		if (msg->len >= 6)
+			ps5_cec_route(cec, get_unaligned_be16(&msg->msg[4]), false);
+		break;
+
+	case CEC_MSG_REQUEST_ACTIVE_SOURCE:
+		if (cec->active_source && reply)
+			ps5_cec_announce(cec);
+		break;
+	}
+
+	return -ENOMSG;
+}
+
+static int ps5_cec_adap_enable(struct cec_adapter *adap, bool enable)
+{
+	struct ps5_cec *cec = cec_get_drvdata(adap);
+	int ret;
+
+	mutex_lock(&cec->lock);
+	ret = ps5_cec_set_enable(enable);
+	if (!ret && enable) {
+		ret = ps5_cec_set_opcode_table();
+		if (ret)
+			ps5_cec_set_enable(false);
+	}
+	if (!ret)
+		cec->enabled = enable;
+	mutex_unlock(&cec->lock);
+
+	if (ret)
+		dev_err(cec->dev, "failed to %s CEC: %d\n",
+			enable ? "enable" : "disable", ret);
+	else if (enable)
+		ps5_cec_request_query(cec, 0);
+	return ret;
+}
+
+static int ps5_cec_adap_log_addr(struct cec_adapter *adap, u8 logical_addr)
+{
+	return 0;
+}
+
+static int ps5_cec_adap_transmit(struct cec_adapter *adap, u8 attempts,
+				 u32 signal_free_time, struct cec_msg *msg)
+{
+	struct ps5_cec *cec = cec_get_drvdata(adap);
+	u8 dest = cec_msg_destination(msg);
+	u8 frame[CEC_MAX_MSG_SIZE];
+	unsigned long flags;
+	bool steer;
+	int ret;
+	u8 la;
+
+	spin_lock_irqsave(&cec->addr_lock, flags);
+	la = cec->bridge_la;
+	spin_unlock_irqrestore(&cec->addr_lock, flags);
+
+	/* The bridge only answers on its own logical address, so claim that one */
+	steer = msg->len == 1 && cec_msg_initiator(msg) == dest &&
+		la < CEC_LOG_ADDR_UNREGISTERED;
+
+	/* A frame from Unregistered stalls the bridge until the next hotplug */
+	memcpy(frame, msg->msg, msg->len);
+	if (cec_msg_initiator(msg) == CEC_LOG_ADDR_UNREGISTERED) {
+		if (la >= CEC_LOG_ADDR_UNREGISTERED)
+			return -EINVAL;
+		frame[0] = la << 4 | dest;
+	}
+
+	mutex_lock(&cec->lock);
+	if (!cec->enabled) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+
+	spin_lock_irqsave(&cec->tx_lock, flags);
+	cec->tx_pending = true;
+	cec->tx_done = steer;
+	if (steer)
+		cec->tx_status = dest == la ? CEC_TX_STATUS_NACK : CEC_TX_STATUS_OK;
+	else
+		cec->tx_status = CEC_TX_STATUS_ERROR;
+	spin_unlock_irqrestore(&cec->tx_lock, flags);
+
+	if (steer) {
+		schedule_work(&cec->tx_work);
+		ret = 0;
+		goto unlock;
+	}
+
+	schedule_delayed_work(&cec->tx_timeout,
+			      msecs_to_jiffies(PS5_CEC_TX_TIMEOUT_MS));
+	ret = ps5_cec_send_frame(frame, msg->len);
+	if (ret) {
+		spin_lock_irqsave(&cec->tx_lock, flags);
+		cec->tx_pending = false;
+		spin_unlock_irqrestore(&cec->tx_lock, flags);
+		cancel_delayed_work(&cec->tx_timeout);
+	} else if (msg->len == 4 && msg->msg[1] == CEC_MSG_ACTIVE_SOURCE) {
+		cec->active_source = true;
+	}
+unlock:
+	mutex_unlock(&cec->lock);
+	return ret;
+}
+
+static void ps5_cec_configured(struct cec_adapter *adap)
+{
+	struct ps5_cec *cec = cec_get_drvdata(adap);
+
+	if (one_touch_play)
+		schedule_work(&cec->otp_work);
+}
+
+static const struct cec_adap_ops ps5_cec_adap_ops = {
+	.adap_enable	= ps5_cec_adap_enable,
+	.adap_log_addr	= ps5_cec_adap_log_addr,
+	.adap_transmit	= ps5_cec_adap_transmit,
+	.configured	= ps5_cec_configured,
+	.received	= ps5_cec_received,
+};
+
+/* CEC traffic while the HDMI side starts up stalls the bridge */
+static void ps5_cec_setup_work(struct work_struct *work)
+{
+	struct ps5_cec *cec = container_of(to_delayed_work(work),
+					   struct ps5_cec, setup_work);
+	struct cec_log_addrs log_addrs = {
+		.cec_version = CEC_OP_CEC_VERSION_1_4,
+		.num_log_addrs = 1,
+		.vendor_id = PS5_CEC_VENDOR_ID,
+		.osd_name = "PS5",
+		.primary_device_type = { CEC_OP_PRIM_DEVTYPE_PLAYBACK },
+		.log_addr_type = { CEC_LOG_ADDR_TYPE_PLAYBACK },
+	};
+	int ret;
+
+	WRITE_ONCE(cec->setup_done, true);
+	ret = cec_s_log_addrs(cec->adap, &log_addrs, false);
+	if (ret)
+		dev_warn(cec->dev, "failed to set logical addresses: %d\n", ret);
+}
+
+static int ps5_cec_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct ps5_cec *cec;
+	int ret, i;
+
+	if (!spcie_is_initialized())
+		return -ENODEV;
+
+	cec = devm_kzalloc(dev, sizeof(*cec), GFP_KERNEL);
+	if (!cec)
+		return -ENOMEM;
+
+	cec->dev = dev;
+	mutex_init(&cec->lock);
+	spin_lock_init(&cec->tx_lock);
+	spin_lock_init(&cec->rx_lock);
+	spin_lock_init(&cec->addr_lock);
+	spin_lock_init(&cec->key_lock);
+	init_completion(&cec->query_done);
+	INIT_DELAYED_WORK(&cec->setup_work, ps5_cec_setup_work);
+	INIT_WORK(&cec->tx_work, ps5_cec_tx_work);
+	INIT_DELAYED_WORK(&cec->tx_timeout, ps5_cec_tx_timeout);
+	INIT_WORK(&cec->rx_work, ps5_cec_rx_work);
+	INIT_DELAYED_WORK(&cec->query_work, ps5_cec_query_work);
+	INIT_WORK(&cec->config_work, ps5_cec_config_work);
+	INIT_WORK(&cec->otp_work, ps5_cec_otp_work);
+	INIT_DELAYED_WORK(&cec->key_work, ps5_cec_key_work);
+	cec->bridge_pa = CEC_PHYS_ADDR_INVALID;
+	cec->edid_pa = CEC_PHYS_ADDR_INVALID;
+	cec->bridge_la = CEC_LOG_ADDR_INVALID;
+	cec->claimed_la = CEC_LOG_ADDR_INVALID;
+
+	cec->input = devm_input_allocate_device(dev);
+	if (!cec->input)
+		return -ENOMEM;
+	cec->input->name = "PS5 HDMI CEC";
+	cec->input->phys = "ps5-cec/input0";
+	cec->input->id.bustype = BUS_CEC;
+	cec->input->rep[REP_DELAY] = 600;
+	cec->input->rep[REP_PERIOD] = 125;
+	__set_bit(EV_KEY, cec->input->evbit);
+	__set_bit(EV_REP, cec->input->evbit);
+	for (i = 0; i < ARRAY_SIZE(ps5_cec_keymap); i++)
+		if (ps5_cec_keymap[i])
+			__set_bit(ps5_cec_keymap[i], cec->input->keybit);
+
+	ret = input_register_device(cec->input);
+	if (ret)
+		return ret;
+
+	cec->adap = cec_allocate_adapter(&ps5_cec_adap_ops, cec, "ps5-cec",
+					 CEC_CAP_DEFAULTS & ~CEC_CAP_RC, 1);
+	if (IS_ERR(cec->adap))
+		return PTR_ERR(cec->adap);
+
+	ret = cec_register_adapter(cec->adap, dev);
+	if (ret) {
+		cec_delete_adapter(cec->adap);
+		return ret;
+	}
+
+	platform_set_drvdata(pdev, cec);
+	hdmi_set_cec_handler(ps5_cec_notify, cec);
+	schedule_delayed_work(&cec->setup_work,
+			      msecs_to_jiffies(PS5_CEC_SETUP_DELAY_MS));
+
+	return 0;
+}
+
+/* Stop forwarding frames to a host that is going away */
+static void ps5_cec_shutdown(struct platform_device *pdev)
+{
+	struct ps5_cec *cec = platform_get_drvdata(pdev);
+
+	WRITE_ONCE(cec->setup_done, true);
+	cancel_delayed_work_sync(&cec->setup_work);
+
+	mutex_lock(&cec->lock);
+	if (cec->enabled)
+		ps5_cec_set_enable(false);
+	cec->enabled = false;
+	mutex_unlock(&cec->lock);
+}
+
+static struct platform_driver ps5_cec_driver = {
+	.probe  = ps5_cec_probe,
+	.shutdown = ps5_cec_shutdown,
+	.driver = {
+		.name = "ps5-cec",
+		.suppress_bind_attrs = true,
+	},
+};
+
+static struct platform_device *ps5_cec_pdev;
+
+static int __init ps5_cec_init(void)
+{
+	int ret = platform_driver_register(&ps5_cec_driver);
+
+	if (ret)
+		return ret;
+
+	ps5_cec_pdev = platform_device_register_simple("ps5-cec", -1, NULL, 0);
+	if (IS_ERR(ps5_cec_pdev)) {
+		ret = PTR_ERR(ps5_cec_pdev);
+		platform_driver_unregister(&ps5_cec_driver);
+		ps5_cec_pdev = NULL;
+		return ret;
+	}
+	return 0;
+}
+
+module_init(ps5_cec_init);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("PS5 HDMI CEC driver");
+MODULE_ALIAS("platform:ps5-cec");
