+/* Caller holds frl_state_lock; notification callbacks must never take setup_lock. */
+static void allm_reset_locked(void)
+{
+	WRITE_ONCE(allm_ready, false);
+	WRITE_ONCE(allm_valid, false);
+	WRITE_ONCE(allm_active, false);
+}
+
+static void allm_reset(void)
+{
+	mutex_lock(&frl_state_lock);
+	allm_reset_locked();
+	mutex_unlock(&frl_state_lock);
+}
+
+/* Publish only against the connection that accepted the converter message. */
+static bool allm_record(unsigned int generation, bool on, bool valid)
+{
+	bool matches;
+
+	mutex_lock(&frl_state_lock);
+	matches = generation == frl_sink_generation && frl_edid_valid;
+	if (matches) {
+		WRITE_ONCE(allm_ready, true);
+		WRITE_ONCE(allm_valid, valid);
+		WRITE_ONCE(allm_active, valid && on);
+	}
+	mutex_unlock(&frl_state_lock);
+	return matches;
+}
+
+static bool allm_wanted(void)
+{
+	unsigned int policy = READ_ONCE(allm);
+
+	return hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 && READ_ONCE(frl_edid_valid) &&
+	       READ_ONCE(sink_allm) &&
+	       (policy == 2 || (policy == 1 && READ_ONCE(allm_game)));
+}
+
+/* HF-VSIF with ALLM_Mode set; off clears 7203 bit 7 to stop the packet. */
+static int setAllmFlava3(bool on)
+{
+	/* PB1-PB28: OUI C4-5D-D8, version 1, ALLM_Mode (PB5 bit 1) */
+	u8 payload[28] = { 0xd8, 0x5d, 0xc4, 0x01, 0x02 };
+
+	i2c_init(1);
+	if (on) {
+		i2c_mask(0x7206, 0x80, 0x80);
+		i2c_mask(0x7203, 0x00, 0x04);
+		i2c_mask(0x7203, 0x80, 0x80);
+		i2c_mask(0x7214, 0x10, 0x10);
+		i2c_begin_block();
+		i2c_write_data(0x72c0, (u8[]){0x81, 0x01, 0x05}, 3);
+		i2c_write_data(0x72c4, payload, sizeof(payload));
+		i2c_end_block();
+		i2c_mask(0x7204, 0x80, 0x80);
+		i2c_waitclear(0x7204, 0x80);
+	} else {
+		i2c_mask(0x7203, 0x00, 0x80);
+	}
+	return i2c_exec();
+}
+
+static bool isTimingValid(const struct drm_display_mode *mode)
+{
+	if (mode->flags & ~(DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NHSYNC |
+			    DRM_MODE_FLAG_PVSYNC | DRM_MODE_FLAG_NVSYNC))
+		return false;
+
+	if (mode->hdisplay < 640 || mode->hdisplay > 3840 ||
+	    mode->vdisplay < 480 || mode->vdisplay > 2160 ||
+	    mode->clock < 25000 || mode->clock > 600000)
+		return false;
+
+	if (mode->hsync_start < mode->hdisplay ||
+	    mode->hsync_end <= mode->hsync_start ||
+	    mode->htotal < mode->hsync_end || mode->htotal > 65535 ||
+	    mode->htotal - mode->hsync_start < 2 ||
+	    mode->vsync_start < mode->vdisplay ||
+	    mode->vsync_end <= mode->vsync_start ||
+	    mode->vtotal < mode->vsync_end || mode->vtotal > 65535)
+		return false;
+
+	return (u64)mode->htotal * mode->vtotal <= 0x100000000ULL &&
+	       (u64)mode->htotal * (mode->vsync_end - mode->vsync_start) <= 0x1000000ULL;
+}
+
+static bool isManualTiming(const struct drm_display_mode *mode)
+{
+	return mode->flags == (DRM_MODE_FLAG_PHSYNC | DRM_MODE_FLAG_NVSYNC) &&
+	       isTimingValid(mode);
+}
+
+static bool isManualMode(const struct drm_display_mode *mode)
+{
+	if (!isManualTiming(mode))
+		return false;
+
+	/* 1440p */
+	if (mode->hdisplay == 2560 && mode->vdisplay == 1440)
+		return mode->clock > 340000;
+
+	return mode->clock <= 297000 && !drm_match_cea_mode(mode);
+}
+
+static void setManualTimingFlava3(const struct drm_display_mode *mode)
+{
+	u16 hstart = mode->htotal - mode->hsync_start - 2;
+	u16 vstart = mode->vtotal - mode->vsync_start + 1;
+	u16 width = mode->hdisplay - 1;
+	u16 height = mode->vdisplay - 1;
+	u16 htotal = mode->htotal - 1;
+	u16 hsync = mode->hsync_end - mode->hsync_start - 1;
+	u32 frame = (u32)mode->htotal * mode->vtotal - 1;
+	u32 vsync = (u32)mode->htotal * (mode->vsync_end - mode->vsync_start) - 1;
+	u16 clock = mode->clock / 1000;
+
+	i2c_write_data(0x7042, (u8[]){hstart, hstart >> 8, vstart, vstart >> 8,
+		       width, width >> 8, height, height >> 8}, 8);
+	i2c_write(0x704f, 0x12);
+	i2c_write_data(0x7063, (u8[]){htotal, htotal >> 8, hsync, hsync >> 8,
+		       frame, frame >> 8, frame >> 16, frame >> 24,
+		       vsync, vsync >> 8, vsync >> 16}, 11);
+	i2c_write_data(0x7078, (u8[]){clock, 0x80 | ((clock >> 8) & 0x07)}, 2);
+}
+
+static int setHdmiBasicVideoConfigFlava3(const struct drm_display_mode *mode,
+					 unsigned int bpc, bool yuv422,
+					 const struct ps5_hdmi_frl_config *config, bool bt2020)
+{
+	u8 vic = drm_match_cea_mode(mode);
+	bool manual = isManualMode(mode);
+	bool frl = config;
+	int ret;
+
+	if (frl && (config->bpc != bpc || config->format > PS5_HDMI_420 ||
+		    yuv422 != (bool)(config->format == PS5_HDMI_422)))
+		return -EINVAL;
+
+	i2c_init(1);
+	i2c_mask(0x7021, 0x00, 0xf0);
+	i2c_delay(frl ? 300 : 500);
+	i2c_begin_block();
+	i2c_write(0x100c, 0x01);
+	i2c_write_data(0x68a0, (u8[]){0x96, 0x04}, 2);
+	i2c_write(0x7005, 0x80);
+	i2c_write(0x7019, 0x00);
+	i2c_write(0x100c, 0x01);
+	i2c_write(0x7005, 0x80);
+	i2c_write(0x7009, frl && !yuv422 && bpc > 8 ? 0xc0 | (bpc - 8) / 2 : 0x00);
+	i2c_write(0x7040, 0x42);
+	i2c_write(0x7225, 0x28);
+	if (frl) {
+		i2c_write_data(0x7227, (u8[]){config->selector, 0x00}, 2);
+		i2c_write_data(0x7070, (u8[]){0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 6);
+	} else if (manual) {
+		/* Set manual timing */
+		i2c_write_data(0x7227, (u8[]){0x05, 0x00}, 2);
+		i2c_write_data(0x7070, (u8[]){0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 6);
+	} else if (vic == 16 || vic == 63) {
+		/* Set VIC and content type */
+		i2c_write_data(0x7227, (u8[]){vic, 0x00}, 2);
+		i2c_write_data(0x7070, (u8[]){vic, vic, 0x00, 0x00, 0x00, 0x00}, 6);
+	} else if (mode->hdisplay == 2560 && mode->vdisplay == 1440) {
+		/* Set VIC and content type */
+		i2c_write_data(0x7227, (u8[]){0x04, 0x00}, 2);
+		i2c_write_data(0x7070, (u8[]){0x00, 0x00, 0x00, 0x00, 0x00, 0xfb}, 6);
+	} else if (vic == 97) {
+		/* Set VIC and content type */
+		i2c_write_data(0x7227, (u8[]){0x06, 0x00}, 2);
+		i2c_write_data(0x7070, (u8[]){0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 6);
+	} else {
+		pr_warn("unsupported mode " DRM_MODE_FMT "\n", DRM_MODE_ARG(mode));
+	}
+	i2c_write(0x70c0, frl && config->format == PS5_HDMI_420 ? 0xc0 : 0xdc);
+	i2c_write(0x621b, frl && config->format == PS5_HDMI_420 ? 0x01 : 0x00);
+	i2c_write(0x629a, frl && config->format == PS5_HDMI_420 ? 0x08 : 0x00);
+	/* Set color format */
+	/* Formats 32/33 unpack native DP 4:2:0 at the receiver. */
+	if (frl && config->format == PS5_HDMI_420) {
+		u8 code = bt2020 ? 0x0e : 0x04;
+
+		i2c_write_data(0x70c4, (u8[]){code, code}, 2);
+	} else if (frl && config->format == PS5_HDMI_444) {
+		i2c_write_data(0x70c4, (u8[]){0x06, 0x06}, 2);
+	} else if (frl && config->format == PS5_HDMI_RGB && config->limited) {
+		i2c_write_data(0x70c4, (u8[]){0x0a, 0x0a}, 2);
+	} else if (yuv422) {
+		i2c_write_data(0x70c4, (u8[]){0x04, 0x04}, 2);
+	} else {
+		i2c_write_data(0x70c4, (u8[]){0x08, 0x08}, 2);
+	}
+	i2c_write(0x70c2, frl && config->format == PS5_HDMI_420 ? 0x03 : 0x00);
+	i2c_write(0x70fe, 0x02);
+	/* Set color depth */
+	i2c_write(0x70c3, (frl || yuv422 ? (bpc - 8) / 2 : 0x00) |
+		  (frl && config->format == PS5_HDMI_RGB && config->limited ? 0x10 : 0));
+	i2c_write(0x7018, (tmds_polarity == 1) << 1);
+	if (tmds_ch_swap == 1) {
+		i2c_end_block();
+		i2c_mask(0x701a, 0xb1, 0xff);
+		i2c_begin_block();
+	}
+	i2c_write(0x10e7, 0xff);
+	i2c_write(0x7202, 0x20);
+	/* Refresh the 1440p counters after a manual timing has been used. */
+	if (manual || (manual_timing && mode->hdisplay == 2560 &&
+		       mode->vdisplay == 1440 && isTimingValid(mode)))
+		setManualTimingFlava3(mode);
+	if (frl) {
+		i2c_write_data(0x7070, (u8[]){vic, vic}, 2);
+		i2c_write(0x7072, 0x00);
+		i2c_write(0x7074, 0x00);
+		i2c_write(0x7206, 0x80);
+		i2c_write(0x7203, 0x61);
+		i2c_write(0x7011, 0xff);
+	} else if (vic == 97) {
+		i2c_write(0x7072, 0x01);
+		i2c_write(0x7074, 0x07);
+		i2c_write(0x7206, 0x80);
+		i2c_write(0x7203, 0x60);
+		i2c_write(0x7011, 0xff);
+	} else {
+		i2c_write(0x7203, 0x60);
+		i2c_write(0x7011, 0xd5);
+	}
+	i2c_end_block();
+	i2c_waitclear(0x7011, 0xff);
+	ret = i2c_exec();
+
+	if (manual)
+		manual_timing = true;
+	return ret;
+}
+
+/* Clear IT content and content type; ALLM carries game mode. */
+static bool avi_stock_content(void)
+{
+	unsigned int mode = READ_ONCE(allm_avi);
+	unsigned int policy = READ_ONCE(allm);
+
+	return mode == 2 || (mode == 1 && READ_ONCE(sink_allm) &&
+			     (policy == 1 || policy == 2));
+}
+
+static int setVideoAdditionalConfigFlava3(const struct drm_display_mode *mode)
+{
+	u8 vic = drm_match_cea_mode(mode);
+	bool manual = isManualMode(mode);
+	bool scramble = mode->clock > 340000;
+	int ret;
+
+	i2c_init(1);
+	i2c_waitset(0x10e7, 0x80);
+	if (vic == 97) {
+		/* Set VIC */
+		i2c_mask(0x7227, vic, 0xff);
+	}
+	if (manual) {
+		i2c_cmd_2_1(0x7231, 0x00);
+		i2c_cmd_2_1(0x7232, 0x00);
+		i2c_mask(0x7226, 0x00, 0x80);
+		i2c_mask(0x7228, 0x00, 0x30);
+		i2c_write(0x7204, 0x41);
+		i2c_waitclear(0x7204, 0x41);
+	} else if (avi_stock_content()) {
+		/* Clear IT content and content type for TMDS. */
+		i2c_cmd_2_1(0x7231, 0x00);
+		i2c_cmd_2_1(0x7232, 0x00);
+		i2c_mask(0x7226, 0x00, 0x80);
+		i2c_mask(0x7228, 0x00, 0x30);
+		i2c_write(0x7204, 0x40);
+		i2c_waitclear(0x7204, 0x40);
+		pr_debug("AVI IT content/type cleared, ALLM policy %u\n", READ_ONCE(allm));
+	} else {
+		/* Enable IT content */
+		i2c_mask(0x7226, 1 << 7, 0x80);
+		/* Set content type (game) */
+		i2c_mask(0x7228, 3 << 4, 0x30);
+		i2c_write(0x7204, 0x40);
+		i2c_waitclear(0x7204, 0x40);
+	}
+	i2c_delay(10);
+	i2c_begin_block();
+	if (scramble) {
+		i2c_write(0x7019, 0x01);
+	} else {
+		i2c_write(0x7019, 0x00);
+	}
+	i2c_write(0x7419, 0x05);
+	i2c_write(0x740a, 0xff);
+	i2c_end_block();
+	i2c_waitclear(0x740a, 0xff);
+	i2c_begin_block();
+	i2c_write(0x7404, 0x00);
+	i2c_write(0x7a88, 0xff);
+	i2c_end_block();
+	i2c_waitclear(0x7a84, 0x01);
+	i2c_begin_block();
+	i2c_write(0x7a8b, 0x05);
+	if (scramble || scrambling) {
+		i2c_write(0x7c00, scramble ? 0x03 : 0x00);
+		i2c_write_data(0x7a80, (u8[]){0xa8, 0x20, 0x00, 0x80}, 4);
+	}
+	i2c_end_block();
+	if (scramble || scrambling)
+		i2c_waitclear(0x7a84, 0x01);
+	scrambling = scramble;
+	i2c_begin_block();
+	i2c_write(0x7021, 0xff);
+	i2c_write(0x700a, 0x02);
+	i2c_write(0x705f, 0x80);
+	i2c_end_block();
+	i2c_delay(700);
+	i2c_write(0x7a8b, 0x00);
+	/* Start TMDS output, and HDCP unless 5/1 turned it off */
+	i2c_cmd_5_3(0x01);
+	ret = i2c_exec();
+
+	WRITE_ONCE(hdcp_abort_until, jiffies + msecs_to_jiffies(HDCP_ABORT_MS));
+	return ret;
+}
+
+static int setHdmiVideoConfigFlava3(const struct drm_display_mode *mode,
+				    unsigned int bpc, bool yuv422)
+{
+	unsigned int generation;
+	bool allm;
+	int ret, packet_ret;
+
+	mutex_lock(&frl_setup_lock);
+	generation = frl_get_sink_generation();
+	allm = allm_wanted();
+	allm_reset();
+	ret = configParamFlava3Pre();
+	if (ret)
+		goto out;
+	ret = configLinkTrainingFlava3();
+	if (ret)
+		goto out;
+	ret = setHdmiBasicVideoConfigFlava3(mode, bpc, yuv422, NULL, false);
+	if (ret)
+		goto out;
+	ret = initHdmiPhyForFlava3_1st();
+	if (ret)
+		goto out;
+	ret = initHdmiPhyForFlava3_2nd();
+	if (ret)
+		goto out;
+	packet_ret = setAllmFlava3(allm);
+	ret = setVideoAdditionalConfigFlava3(mode);
+	if (ret)
+		goto out;
+	if (!allm_record(generation, allm, !packet_ret))
+		ret = -ENODEV;
+	if (packet_ret)
+		pr_warn("ALLM setup failed: %d\n", packet_ret);
+out:
+	if (ret)
+		allm_reset();
+	mutex_unlock(&frl_setup_lock);
+	return ret;
+}
+
+static void setHdrConfigFlava3(const struct hdmi_drm_infoframe *frame, bool bt2020)
+{
+	struct hdmi_drm_infoframe sdr;
+	u8 data[HDMI_INFOFRAME_SIZE(DRM)];
+	bool hdr = frame != NULL;
+	int ret;
+
+	/* Sinks keep the last InfoFrame, send EOTF 0 when leaving HDR. */
+	if (!frame && hdr_enabled) {
+		hdmi_drm_infoframe_init(&sdr);
+		frame = &sdr;
+	}
+	if (!frame && bt2020 == bt2020_enabled)
+		return;
+	if (frame && hdmi_drm_infoframe_pack_only(frame, data, sizeof(data)) != sizeof(data))
+		return;
+
+	i2c_init(1);
+	if (frame) {
+		/* Send DRM InfoFrame */
+		i2c_write_data(0x7e40, data, sizeof(data));
+		i2c_mask(0x7203, 0x01, 0x01);
+		i2c_write(0x7204, 0x01);
+		i2c_waitclear(0x7204, 0x01);
+	}
+	if (bt2020 || bt2020_enabled) {
+		/* Set colorimetry */
+		i2c_mask(0x7225, bt2020 ? 0xc0 : 0x00, 0xc0);
+		i2c_mask(0x7226, bt2020 ? 0x60 : 0x00, 0x70);
+		i2c_write(0x7204, 0x40);
+		i2c_waitclear(0x7204, 0x40);
+	}
+	ret = i2c_exec();
+	if (ret) {
+		pr_err("failed to set HDR configuration: %d\n", ret);
+		return;
+	}
+	hdr_enabled = hdr;
+	bt2020_enabled = bt2020;
+}
+
+static void setRgbRangeFlava3(bool limited)
+{
+	i2c_init(1);
+	/* Set RGB and YCC quantization range */
+	i2c_mask(0x7226, limited ? 0x04 : 0x08, 0x0c);
+	i2c_mask(0x7228, limited ? 0x00 : 0x40, 0xc0);
+	i2c_write(0x7204, 0x40);
+	i2c_waitclear(0x7204, 0x40);
+	i2c_exec();
+}
+
+static void setHdmiAudioConfigBasic(int channels)
+{
+	i2c_init(2);
+	i2c_begin_block();
+	i2c_write(0x62a0, 0x06);
+	i2c_write(0x62a7, 0x13);
+	i2c_write(0x62ac, 0x82);
+	i2c_write(0x62cb, 0x02);
+	i2c_write(0x62cb, 0x03);
+	i2c_write(0x62cb, 0x00);
+	i2c_write(0x70ad, 0x00);
+	i2c_write(0x70af, 0x07);
+	i2c_write(0x70a9, 0x5e);
+	i2c_end_block();
+	i2c_mask(0x70af, 0x06, 0x06);
+	i2c_mask(0x70b3, 0x02, 0x0f);
+	i2c_mask(0x70ae, 0x80, 0xe0);
+	i2c_mask(0x70ae, max(1, channels - 1), 0x07);
+	i2c_mask(0x70ac, 0x01, 0x21);
+	i2c_mask(0x70ab, 0x81, 0x89);
+	i2c_mask(0x70a9, 0x08, 0x08);
+	i2c_exec();
+}
+
+static void setAudioConfigAdditional(int channels)
+{
+	u8 val = 0x00;
+	switch (channels) {
+	case 3: val = 0x02; break;
+	case 4: val = 0x03; break;
+	case 5: val = 0x09; break;
+	case 6: val = 0x0b; break;
+	case 7: val = 0x11; break;
+	case 8: val = 0x13; break;
+	}
+	i2c_init(2);
+	i2c_mask(0x70b0, 0x00, 0xff);
+	i2c_mask(0x70b1, 0x79, 0xff);
+	i2c_mask(0x70b2, 0x00, 0xff);
+	i2c_mask(0x70b3, 0x02, 0xff);
+	i2c_mask(0x70b4, 0x0b, 0x0f);
+	i2c_mask(0x70b5, 0x00, 0xff);
+	i2c_mask(0x70b6, 0x00, 0xff);
+	i2c_begin_block();
+	i2c_write(0x10e7, 0xff);
+	i2c_write(0x7011, 0xa2);
+	i2c_end_block();
+	i2c_waitset(0x10e7, 0xa2);
+	i2c_mask(0x7267, val, 0xff);
+	i2c_write(0x7204, 0x10);
+	i2c_waitclear(0x7204, 0x10);
+	i2c_write(0x10e7, 0xff);
+	i2c_mask(0x7203, 0x10, 0x10);
+	i2c_delay(30);
+	i2c_write(0x70a8, 0xc0);
+	i2c_exec();
+}
+
+static void sceHdmiSetAudioConfigFlava3(int channels)
+{
+	setHdmiAudioConfigBasic(channels);
+	setAudioConfigAdditional(channels);
+}
+
+static void initVerde(void)
+{
+	i2c_init(0);
+	i2c_mask(0x105, 0x00, 0x03);
+	i2c_mask(0x104, 0x00, 0x02);
+	i2c_cmd_2_1(0x400, 0x00);
+	i2c_cmd_2_1(0x3261, 0x02);
+	i2c_begin_block();
+	i2c_write(0x11, 0x03);
+	i2c_write(0x13, 0xff);
+	i2c_write_data(0x8000, (u8[]){0x00, 0x01, 0x07, 0x00}, 4);
+	i2c_write(0x108, 0x80);
+	i2c_write(0x9000, 0x01);
+	i2c_end_block();
+	i2c_cmd_5_3(0x00);
+	i2c_exec();
+}
+
+static void linkConfigVerde(const struct drm_display_mode *mode)
+{
+	i2c_init(0);
+	i2c_mask(0x105, 0x00, 0x40);
+	if (mode->hdisplay == 2560 && mode->vdisplay == 1440) {
+		i2c_cmd_2_1(0x400, 0x03);
+	}
+	i2c_begin_block();
+	i2c_write_data(0x9003, (u8[]){0x1e, 0x04, 0x01, 0x01, 0x00, 0x00, 0x00}, 7);
+	i2c_write(0x4002, 0x03);
+	i2c_end_block();
+	i2c_exec();
+}
+
+static void configDpLinkTrainingVerde(void)
+{
+	i2c_init(0);
+	i2c_cmd_2_1(0x9002, 0x01);
+	i2c_waitset(0x4001, 0x02);
+	i2c_cmd_2_1(0x11, 0x01);
+	i2c_exec();
+}
+
+static void setTmdsConfigVerde(void)
+{
+	i2c_init(0);
+	i2c_cmd_2_1(0x9200, 0x00);
+	i2c_begin_block();
+	i2c_write(0x9800, 0x00);
+	i2c_write(0x33b3, 0x1a);
+	i2c_write(0x9831, 0x80);
+	i2c_write_data(0x9810, (u8[]){0x00, 0x79, 0x00, 0x02, 0x0b, 0x00, 0x00}, 7);
+	i2c_end_block();
+	i2c_waitclear(0x9830, 0x80);
+	i2c_cmd_2_1(0x9830, 0x80);
+	i2c_waitclear(0x9830, 0x80);
+	i2c_cmd_2_1(0x9830, 0x81);
+	i2c_waitclear(0x9830, 0x80);
+	i2c_waitclear(0x108, 0x10);
+	i2c_mask(0x108, 0x11, 0x17);
+	i2c_waitset(0x13, 0x40);
+	i2c_cmd_2_1(0x13, 0x40);
+	i2c_cmd_3_5(0x4001, 0x03);
+	i2c_cmd_2_1(0x11, 0x01);
+	i2c_exec();
+}
+
+static void setHdmiBasicVideoConfigVerde(const struct drm_display_mode *mode)
+{
+	u8 vic = drm_match_cea_mode(mode);
+
+	i2c_init(0);
+	i2c_begin_block();
+	if (vic == 16) {
+		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0xef, 0x00, 0x28, 0x08, 0x10, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
+	} else if (mode->hdisplay == 2560 && mode->vdisplay == 1440) {
+		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0xff, 0x00, 0x28, 0x08, 0x00, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
+	} else if (vic == 97) {
+		i2c_write_data(0x3058, (u8[]){0x02, 0x0d, 0x9e, 0x00, 0x28, 0x08, 0x61, 0x40, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 18);
+	}
+	i2c_write_data(0x31d0, (u8[]){0x01, 0x19, 0x5f, 0x53, 0x43, 0x45, 0x49, 0x00, 0x00, 0x00, 0x00, 0x50, 0x53, 0x35, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x08}, 28);
+	i2c_end_block();
+	i2c_begin_block();
+	i2c_write_data(0x3033, (u8[]){0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}, 9);
+	i2c_write_data(0x307a, (u8[]){0x01, 0x0a, 0x70, 0x01, 0x00, 0x00, 0x00, 0x00}, 8);
+	i2c_write_data(0x3000, (u8[]){0x56, 0xaa, 0x00, 0x24, 0x00, 0xa8, 0x00, 0x00, 0x08, 0x80}, 10);
+	i2c_end_block();
+	i2c_cmd_2_1(0x300a, 0x01);
+	i2c_waitclear(0x300c, 0xf3);
+	i2c_waitclear(0x300d, 0xff);
+	i2c_waitclear(0x300e, 0xff);
+	i2c_waitclear(0x300f, 0xff);
+	i2c_waitclear(0x3010, 0xff);
+	i2c_waitclear(0x3011, 0xff);
+	i2c_waitset(0x13, 0x80);
+	i2c_cmd_2_1(0x13, 0x80);
+	i2c_mask(0x105, 0x01, 0x03);
+	i2c_delay(700);
+	i2c_cmd_5_3(0x01);
+	i2c_exec();
+}
+
+static void setHdmiVideoConfigVerde(const struct drm_display_mode *mode)
+{
+	linkConfigVerde(mode);
+	configDpLinkTrainingVerde();
+	setTmdsConfigVerde();
+	setHdmiBasicVideoConfigVerde(mode);
+}
+
+static void setAudioConfigForVerde(int channels)
+{
+	i2c_init(2);
+	i2c_waitclear(0x102, 0x80);
+	i2c_cmd_2_1(0xf1, 0x01);
+	i2c_waitset(0xf2, 0x01);
+	i2c_waitset(0x16, 0x08);
+	i2c_cmd_2_1(0x16, 0x08);
+	i2c_begin_block();
+	i2c_write(0x9800, 0x00);
+	i2c_write(0x33b3, 0x1a);
+	i2c_write(0x9831, 0x80);
+	i2c_write_data(0x9810, (u8[]){0x00, 0x79, 0x00, 0x02, 0x0b, 0x00, 0x00}, 7);
+	i2c_end_block();
+	i2c_waitclear(0x9830, 0x80);
+	i2c_cmd_2_1(0x9830, 0x80);
+	i2c_waitclear(0x9830, 0x80);
+	i2c_cmd_2_1(0x9830, 0x81);
+	i2c_waitclear(0x9830, 0x80);
+	i2c_waitclear(0x108, 0x10);
+	i2c_mask(0x108, 0x10, 0x10);
+	i2c_waitclear(0x108, 0x10);
+	i2c_write_data(0x307a, (u8[]){0x01, 0x0a, 0x70, 0x01, 0x00, 0x00, 0x00, 0x00}, 8);
+	i2c_mask(0x3000, 0x40, 0xc0);
+	i2c_mask(0x3005, 0x80, 0xc0);
+	i2c_cmd_2_1(0x300a, 0x01);
+	i2c_waitset(0x13, 0x80);
+	i2c_cmd_2_1(0x13, 0x80);
+	i2c_exec();
+}
+
+static void sceHdmiSetAudioConfigVerde(int channels)
+{
+	setAudioConfigForVerde(channels);
+}
