+bool ps5_hdmi_plan_connection_failed(const struct ps5_hdmi_plan *plan)
+{
+	bool failed;
+
+	mutex_lock(&frl_state_lock);
+	failed = frl_edid_valid && plan->generation == frl_sink_generation &&
+		 (frl_failed || (READ_ONCE(frl_recovery) &&
+		  frl_failure_mask(&frl_failures, &plan->mode, plan->hdr, plan->bt2020,
+				   plan->config.limited) &
+		  frl_failure_bit(plan->config.format, plan->config.bpc)));
+	mutex_unlock(&frl_state_lock);
+	return failed;
+}
+EXPORT_SYMBOL(ps5_hdmi_plan_connection_failed);
