diff --git a/drivers/devfreq/ps5-gpufreq.c b/drivers/devfreq/ps5-gpufreq.c
new file mode 100644
index 000000000000..c16346b339d7
--- /dev/null
+++ b/drivers/devfreq/ps5-gpufreq.c
@@ -0,0 +1,250 @@
+// SPDX-License-Identifier: GPL-2.0-only
+
+#include <linux/cleanup.h>
+#include <linux/devfreq.h>
+#include <linux/init.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/pci.h>
+#include <linux/platform_device.h>
+#include <linux/pm_opp.h>
+#include <linux/ps5.h>
+
+#define PS5_GFXCLK_MIN_MHZ		400UL
+#define PS5PRO_GFXCLK_MIN_MHZ		500UL
+#define PS5_GFXCLK_MAX_MHZ		2230UL
+#define PS5PRO_GFXCLK_MAX_MHZ		2350UL
+#define PS5_GFXCLK_DEFAULT_MHZ		2000UL
+
+typedef ktime_t (*ps5_gfx_busy_fn_t)(struct pci_dev *pdev);
+
+static struct pci_dev *ps5_gpu_pdev;
+static ps5_gfx_busy_fn_t ps5_gfx_busy_fn;
+static ktime_t ps5_gpu_last_busy_ns;
+static ktime_t ps5_gpu_last_sample;
+static unsigned long ps5_gfxclk_min_mhz = PS5_GFXCLK_MIN_MHZ;
+static unsigned long ps5_gfxclk_max_mhz = PS5_GFXCLK_MAX_MHZ;
+
+// TODO: manual pins here get overridden while ps5-cpufreq's boost is active
+// (SMU takes over GPU clock, snaps back to ceiling). idk what to do lol
+
+static int ps5_gpu_query_mhz(u32 *mhz)
+{
+	return ps5_mp1_query_gfxclk(mhz);
+}
+
+static int ps5_gpu_request_mhz(u32 mhz)
+{
+	return ps5_mp1_request_gfxclk(mhz);
+}
+
+static int ps5_gpufreq_target(struct device *dev, unsigned long *freq, u32 flags)
+{
+	struct dev_pm_opp *opp;
+	unsigned long mhz;
+	u32 cur;
+
+	opp = devfreq_recommended_opp(dev, freq, flags);
+	if (IS_ERR(opp))
+		return PTR_ERR(opp);
+	dev_pm_opp_put(opp);
+
+	mhz = *freq / 1000000UL;
+
+	if (mhz < ps5_gfxclk_min_mhz)
+		mhz = ps5_gfxclk_min_mhz;
+	if (mhz > ps5_gfxclk_max_mhz)
+		mhz = ps5_gfxclk_max_mhz;
+
+	if (ps5_gpu_query_mhz(&cur) || cur != mhz) {
+		if (ps5_gpu_request_mhz(mhz))
+			return -EIO;
+	}
+
+	*freq = mhz * 1000000UL;
+
+	return 0;
+}
+
+static int ps5_gpufreq_get_cur_freq(struct device *dev, unsigned long *freq)
+{
+	u32 mhz;
+
+	if (ps5_gpu_query_mhz(&mhz))
+		return -EIO;
+
+	*freq = (unsigned long)mhz * 1000000UL;
+
+	return 0;
+}
+
+static bool ps5_gpu_busy_source_ready(void)
+{
+	if (ps5_gfx_busy_fn)
+		return true;
+
+	if (!ps5_gpu_pdev) {
+		struct pci_dev *pdev = NULL;
+
+		while ((pdev = pci_get_class(PCI_CLASS_DISPLAY_VGA << 8, pdev))) {
+			if (pdev->vendor == PCI_VENDOR_ID_ATI) {
+				ps5_gpu_pdev = pdev;
+				break;
+			}
+		}
+		if (!ps5_gpu_pdev)
+			return false;
+	}
+
+	ps5_gfx_busy_fn = symbol_get(amdgpu_ps5_get_gfx_busy_ns);
+	if (!ps5_gfx_busy_fn)
+		return false;
+
+	ps5_gpu_last_busy_ns = ps5_gfx_busy_fn(ps5_gpu_pdev);
+	ps5_gpu_last_sample = ktime_get();
+
+	return true;
+}
+
+static int ps5_gpufreq_get_dev_status(struct device *dev,
+				       struct devfreq_dev_status *stat)
+{
+	ktime_t now_busy, now_sample;
+	unsigned long freq;
+	int ret;
+
+	ret = ps5_gpufreq_get_cur_freq(dev, &freq);
+	if (ret)
+		return ret;
+
+	stat->current_frequency = freq;
+
+	if (!ps5_gpu_busy_source_ready()) {
+		stat->busy_time = 0;
+		stat->total_time = 1;
+		return 0;
+	}
+
+	now_busy = ps5_gfx_busy_fn(ps5_gpu_pdev);
+	now_sample = ktime_get();
+
+	stat->busy_time = ktime_to_ns(ktime_sub(now_busy, ps5_gpu_last_busy_ns));
+	stat->total_time = ktime_to_ns(ktime_sub(now_sample, ps5_gpu_last_sample));
+
+	ps5_gpu_last_busy_ns = now_busy;
+	ps5_gpu_last_sample = now_sample;
+
+	if (stat->total_time <= 0) {
+		stat->busy_time = 0;
+		stat->total_time = 1;
+	} else if (stat->busy_time > stat->total_time) {
+		stat->busy_time = stat->total_time;
+	} else if (stat->busy_time < 0) {
+		stat->busy_time = 0;
+	}
+
+	return 0;
+}
+
+static unsigned long ps5_gpufreq_table[] = {
+	400000000UL,
+	800000000UL,
+	1200000000UL,
+	1600000000UL,
+	2000000000UL,
+	PS5_GFXCLK_MAX_MHZ * 1000000UL,
+};
+
+static struct devfreq_simple_ondemand_data ps5_gpufreq_ondemand_data = {
+	.upthreshold = 45,
+	.downdifferential = 10,
+};
+
+static struct devfreq_dev_profile ps5_gpufreq_profile = {
+	.initial_freq	= PS5_GFXCLK_DEFAULT_MHZ * 1000000UL,
+	.polling_ms	= 100,
+	.target		= ps5_gpufreq_target,
+	.get_cur_freq	= ps5_gpufreq_get_cur_freq,
+	.get_dev_status	= ps5_gpufreq_get_dev_status,
+	.freq_table	= ps5_gpufreq_table,
+	.max_state	= ARRAY_SIZE(ps5_gpufreq_table),
+};
+
+static int ps5_gpufreq_probe(struct platform_device *pdev)
+{
+	struct devfreq *df;
+	int ret, i;
+
+	if (dev_is_pci(pdev->dev.parent) &&
+	    ps5_is_viola(to_pci_dev(pdev->dev.parent)->device)) {
+		ps5_gfxclk_min_mhz = PS5PRO_GFXCLK_MIN_MHZ;
+		ps5_gfxclk_max_mhz = PS5PRO_GFXCLK_MAX_MHZ;
+	}
+	ps5_gpufreq_table[0] = ps5_gfxclk_min_mhz * 1000000UL;
+	ps5_gpufreq_table[ARRAY_SIZE(ps5_gpufreq_table) - 1] =
+		ps5_gfxclk_max_mhz * 1000000UL;
+
+	for (i = 0; i < ARRAY_SIZE(ps5_gpufreq_table); i++) {
+		struct dev_pm_opp_data data = { .freq = ps5_gpufreq_table[i] };
+
+		ret = dev_pm_opp_add_dynamic(&pdev->dev, &data);
+		if (ret)
+			goto err_remove_opp;
+	}
+
+	df = devm_devfreq_add_device(&pdev->dev, &ps5_gpufreq_profile,
+				      DEVFREQ_GOV_SIMPLE_ONDEMAND,
+				      &ps5_gpufreq_ondemand_data);
+	if (IS_ERR(df)) {
+		ret = PTR_ERR(df);
+		goto err_remove_opp;
+	}
+
+	platform_set_drvdata(pdev, df);
+
+	return 0;
+
+err_remove_opp:
+	for (i--; i >= 0; i--)
+		dev_pm_opp_remove(&pdev->dev, ps5_gpufreq_table[i]);
+
+	return ret;
+}
+
+static void ps5_gpufreq_remove(struct platform_device *pdev)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(ps5_gpufreq_table); i++)
+		dev_pm_opp_remove(&pdev->dev, ps5_gpufreq_table[i]);
+}
+
+static struct platform_driver ps5_gpufreq_driver = {
+	.driver = {
+		.name = "ps5-gpufreq",
+	},
+	.probe = ps5_gpufreq_probe,
+	.remove = ps5_gpufreq_remove,
+};
+
+static int __init ps5_gpufreq_init(void)
+{
+	pr_info("Strawberry was here\n");
+
+	return platform_driver_register(&ps5_gpufreq_driver);
+}
+module_init(ps5_gpufreq_init);
+
+static void __exit ps5_gpufreq_exit(void)
+{
+	platform_driver_unregister(&ps5_gpufreq_driver);
+	if (ps5_gfx_busy_fn)
+		symbol_put(amdgpu_ps5_get_gfx_busy_ns);
+	if (ps5_gpu_pdev)
+		pci_dev_put(ps5_gpu_pdev);
+}
+module_exit(ps5_gpufreq_exit);
+
+MODULE_DESCRIPTION("PlayStation 5 SMU GFXCLK devfreq driver");
+MODULE_AUTHOR("Armandas Kvietkus <armandas.kvietkus@proton.me>");
+MODULE_LICENSE("GPL");
