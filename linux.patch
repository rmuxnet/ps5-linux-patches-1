+/*
+ * Runs before the IP blocks are added.  On a PS5 Pro, switch to the Viola
+ * firmware if every file of it loads and has a valid header, along with the
+ * Viola SMU setup and thermal sensors.  Otherwise keep the Cyan Skillfish
+ * firmware.
+ */
+void amdgpu_ucode_ps5_viola_init(struct amdgpu_device *adev)
+{
+	const struct firmware *fw;
+	bool valid;
+	int i;
+
+	adev->ps5_viola_fw = false;
+	if (!ps5_viola_fw || !amdgpu_is_viola(adev))
+		return;
+
+	for (i = 0; i < ARRAY_SIZE(ps5_viola_fw_names); i++) {
+		if (firmware_request_nowarn(&fw, ps5_viola_fw_names[i], adev->dev)) {
+			dev_dbg(adev->dev, "PS5 Pro: %s not found\n",
+				ps5_viola_fw_names[i]);
+			return;
+		}
+		valid = fw->size >= sizeof(struct common_firmware_header) &&
+			!amdgpu_ucode_validate(fw);
+		release_firmware(fw);
+		if (!valid) {
+			dev_warn(adev->dev, "PS5 Pro: %s is invalid, using Cyan Skillfish firmware\n",
+				 ps5_viola_fw_names[i]);
+			return;
+		}
+	}
+
+	adev->ps5_viola_fw = true;
+	dev_info(adev->dev, "PS5 Pro: using Viola firmware\n");
+
+	ps5_mp1_viola_init();
+}
