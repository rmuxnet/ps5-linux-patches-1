+#ifdef CONFIG_X86_PS5
+/* Use the DP stream timing, including the native timing of scaled modes. */
+static void dm_ps5_mode_from_timing(const struct dc_crtc_timing *timing,
+				    struct drm_display_mode *mode)
+{
+	memset(mode, 0, sizeof(*mode));
+	mode->clock = timing->pix_clk_100hz / 10;
+	mode->hdisplay = timing->h_addressable;
+	mode->hsync_start = mode->hdisplay + timing->h_front_porch;
+	mode->hsync_end = mode->hsync_start + timing->h_sync_width;
+	mode->htotal = timing->h_total;
+	mode->vdisplay = timing->v_addressable;
+	mode->vsync_start = mode->vdisplay + timing->v_front_porch;
+	mode->vsync_end = mode->vsync_start + timing->v_sync_width;
+	mode->vtotal = timing->v_total;
+	mode->picture_aspect_ratio = (enum hdmi_picture_aspect)timing->aspect_ratio;
+	mode->flags = (timing->flags.HSYNC_POSITIVE_POLARITY ?
+		       DRM_MODE_FLAG_PHSYNC : DRM_MODE_FLAG_NHSYNC) |
+		      (timing->flags.VSYNC_POSITIVE_POLARITY ?
+		       DRM_MODE_FLAG_PVSYNC : DRM_MODE_FLAG_NVSYNC);
+}
+
+static bool dm_ps5_rgb_limited(const struct dc_stream_state *stream)
+{
+	return stream->timing.pixel_encoding == PIXEL_ENCODING_RGB &&
+	       (stream->output_color_space == COLOR_SPACE_SRGB_LIMITED ||
+		stream->output_color_space == COLOR_SPACE_2020_RGB_LIMITEDRANGE);
+}
+
+static bool dm_ps5_hdmi_enable(struct dc_stream_state *stream,
+			       const struct drm_connector_state *state)
+{
+	struct drm_display_mode mode;
+	bool frl;
+	int channels = 0, i;
+
+	dm_ps5_mode_from_timing(&stream->timing, &mode);
+	ps5_hdmi_allm_request(state && state->content_type == DRM_MODE_CONTENT_TYPE_GAME);
+
+	for (i = 0; i < stream->audio_info.mode_count; i++) {
+		if (stream->audio_info.modes[i].channel_count > channels)
+			channels = stream->audio_info.modes[i].channel_count;
+	}
+
+	/* Fallback to stereo if EDID has no audio modes */
+	if (channels == 0)
+		channels = 2;
+
+	frl = isHdmiFrlTiming(&mode) ||
+		(state && to_dm_connector_state(state)->ps5_hdmi_plan_valid &&
+		 to_dm_connector_state(state)->ps5_hdmi_plan.frl);
+	if (frl) {
+		const struct dm_connector_state *dm_state;
+		const struct ps5_hdmi_plan *plan;
+		unsigned int bpc;
+
+		if (!state)
+			return false;
+		dm_state = to_dm_connector_state(state);
+		plan = &dm_state->ps5_hdmi_plan;
+		bpc = amdgpu_dm_convert_dc_color_depth_into_bpc(stream->timing.display_color_depth);
+		if (!dm_state->ps5_hdmi_plan_valid ||
+		    !drm_mode_match(&plan->mode, &mode, DRM_MODE_MATCH_TIMINGS |
+				    DRM_MODE_MATCH_CLOCK | DRM_MODE_MATCH_FLAGS |
+				    DRM_MODE_MATCH_ASPECT_RATIO) ||
+		    stream->timing.pixel_encoding !=
+		    (plan->config.format == PS5_HDMI_RGB ? PIXEL_ENCODING_RGB :
+		     plan->config.format == PS5_HDMI_444 ? PIXEL_ENCODING_YCBCR444 :
+		plan->config.format == PS5_HDMI_420 ? PIXEL_ENCODING_YCBCR420 :
+		     PIXEL_ENCODING_YCBCR422) ||
