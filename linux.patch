+#ifdef CONFIG_X86_PS5
+/* Commit a replacement mode with all modeset locks held. */
+static int dm_ps5_commit_mode(struct drm_connector *connector,
+			      const struct drm_display_mode *mode)
+{
+	struct drm_device *ddev = connector->dev;
+	struct drm_atomic_commit *state = drm_atomic_commit_alloc(ddev);
+	struct drm_crtc *crtc = connector->state->crtc;
+	struct drm_connector_state *conn_state;
+	struct drm_crtc_state *crtc_state;
+	struct drm_plane_state *plane_state;
+	int ret;
+
+	if (!state)
+		return -ENOMEM;
+	state->acquire_ctx = ddev->mode_config.acquire_ctx;
+
+	conn_state = drm_atomic_get_connector_state(state, connector);
+	ret = PTR_ERR_OR_ZERO(conn_state);
+	if (ret)
+		goto out;
+	crtc_state = drm_atomic_get_crtc_state(state, crtc);
+	ret = PTR_ERR_OR_ZERO(crtc_state);
+	if (ret)
+		goto out;
+	ret = drm_atomic_set_mode_for_crtc(crtc_state, mode);
+	if (ret)
+		goto out;
+	crtc_state->mode_changed = true;
+	plane_state = drm_atomic_get_plane_state(state, crtc->primary);
+	ret = PTR_ERR_OR_ZERO(plane_state);
+	if (ret)
+		goto out;
+	ret = drm_atomic_commit(state);
+out:
+	drm_atomic_commit_put(state);
+	return ret;
+}
+
+/*
+ * A failed FRL setup leaves video muted, and gamescope keeps its mode when
+ * only the mode list changes. Once FRL is withheld for the sink, switch to
+ * the same size at the highest refresh rate still offered (the framebuffer
+ * stays valid), then let userspace re-probe.
+ */
+static void dm_ps5_frl_fallback_work_func(struct work_struct *work)
+{
+	struct drm_device *dev = READ_ONCE(ps5_frl_fallback_dev);
+	struct drm_connector_list_iter iter;
+	struct drm_connector *connector;
+	unsigned long pending, retry = 0;
+	bool changed = false;
+
+	if (!dev)
+		return;
+	drm_modeset_lock_all(dev);
+	pending = xchg(&ps5_frl_fallback_crtcs, 0);
+	drm_connector_list_iter_begin(dev, &iter);
+	drm_for_each_connector_iter(connector, &iter) {
+		const struct drm_display_mode *cur, *mode, *best = NULL;
+		const struct dm_connector_state *dm_state;
+		struct drm_crtc *crtc;
+		int ret;
+
+		if (!dm_ps5_is_hdmi_connector(connector) ||
+		    connector->status != connector_status_connected ||
+		    !connector->state || !connector->state->crtc)
+			continue;
+		crtc = connector->state->crtc;
+		dm_state = to_dm_connector_state(connector->state);
+		cur = &crtc->state->mode;
+		if (!(pending & BIT(drm_crtc_index(crtc))) || !crtc->state->active ||
+		    !dm_state->ps5_hdmi_plan_valid || !dm_state->ps5_hdmi_plan.frl ||
+		    !ps5_hdmi_plan_connection_failed(&dm_state->ps5_hdmi_plan))
+			continue;
+		changed = true;
+		if (ps5_hdmi_recovery_enabled()) {
+			struct ps5_hdmi_plan next;
+
+			/* Recheck the same request, excluding failed candidates. */
+			if (dm_ps5_select_frl_plan(cur, connector->state,
+						   connector->state->max_requested_bpc,
+						   &next) == PS5_HDMI_PLAN_OK) {
+				ret = dm_ps5_commit_mode(connector, cur);
+				if (ret)
+					retry |= BIT(drm_crtc_index(crtc));
+				continue;
+			}
+		}
+		list_for_each_entry(mode, &connector->modes, head) {
+			if (mode->hdisplay != cur->hdisplay || mode->vdisplay != cur->vdisplay ||
+			    mode->flags & DRM_MODE_FLAG_INTERLACE ||
+			    isHdmiFrlTiming(mode) ||
+			    !isHdmiModeValid(mode, &connector->display_info, amdgpu_force_1080p))
+				continue;
+			if (!best || drm_mode_vrefresh(mode) > drm_mode_vrefresh(best))
+				best = mode;
+		}
+		if (!best) {
+			drm_warn(dev, "PS5: FRL is withheld and there is no mode to fall back to\n");
+			continue;
+		}
+		drm_info(dev, "PS5: FRL is withheld, falling back to " DRM_MODE_FMT "\n",
+			 DRM_MODE_ARG(best));
+		ret = dm_ps5_commit_mode(connector, best);
+		if (ret) {
+			drm_warn(dev, "PS5: fallback modeset failed: %d\n", ret);
+			retry |= BIT(drm_crtc_index(crtc));
+		}
+	}
+	drm_connector_list_iter_end(&iter);
+	if (retry && ++ps5_frl_fallback_retries < PS5_FRL_FALLBACK_RETRIES) {
+		while (retry) {
+			unsigned int index = __ffs(retry);
+
+			set_bit(index, &ps5_frl_fallback_crtcs);
+			retry &= ~BIT(index);
+		}
+		mod_delayed_work(system_dfl_wq, &ps5_frl_fallback_work, msecs_to_jiffies(100));
+	}
+	drm_modeset_unlock_all(dev);
+	if (changed)
+		drm_kms_helper_hotplug_event(dev);
+}
