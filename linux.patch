+	unsigned int rx_count;
+	unsigned int query_mark;
+	unsigned int query_retries;
+	u8 claimed_la;
+	struct delayed_work query_work;
+	struct work_struct config_work;
+
+	bool active_source;
+	bool otp_done;
+	struct work_struct otp_work;
+
+	spinlock_t key_lock;
+	unsigned int key;
+	struct delayed_work key_work;
+};
+
