+/* Accept a four-lane polarity mask and a permutation, or firmware defaults. */
+static bool frl_wiring_valid(void)
+{
+	u8 seen = 0;
+	unsigned int lane;
+
+	if (dp_polarity != 0xff && dp_polarity > 0x0f)
+		return false;
+	if (dp_ch_swap == 0xff)
+		return true;
+	for (lane = 0; lane < 4; lane++) {
+		u8 bit = 1 << ((dp_ch_swap >> (lane * 2)) & 3);
+
+		if (seen & bit)
+			return false;
+		seen |= bit;
+	}
+	return true;
+}
+
+/* Converter timing selectors are shared across displays, not EDID IDs. */
+static bool frl_mode_config(const struct drm_display_mode *mode, unsigned int max_bpc,
+			    struct ps5_hdmi_frl_config *config)
+{
+	struct ps5_hdmi_frl_config candidate = {
+		.vic = drm_match_cea_mode(mode),
+		.bpc = max_bpc >= 10 ? 10 : 8,
+		.min_rate = 4,
+		.format = PS5_HDMI_422,
+		.limited = true,
+	};
+	u64 kbps;
+
+	if (max_bpc < 8 || mode->clock <= 0)
+		return false;
+	switch (candidate.vic) {
+	case 117: /* 2160p100, 16:9 */
+	case 119: /* 2160p100, 64:27 */
+		candidate.selector = 10;
+		break;
+	case 118: /* 2160p120, 16:9 */
+	case 120: /* 2160p120, 64:27 */
+		candidate.selector = 11;
+		break;
+	default:
+		return false;
+	}
+	/* The uncompressed DP input is four HBR3 lanes with 8b/10b coding. */
+	for (; candidate.bpc >= 8; candidate.bpc -= 2) {
+		kbps = (u64)mode->clock * candidate.bpc * 2;
+		if (kbps > 25920000)
+			continue;
+		candidate.dp_kbps = kbps;
+		*config = candidate;
+		return true;
+	}
+	return false;
+}
+
+bool getHdmiFrlConfig(const struct drm_display_mode *mode, unsigned int max_bpc,
+		      struct ps5_hdmi_frl_config *config)
+{
+	return READ_ONCE(frl_4k120) && hdmi_ic_type == HDMI_IC_TYPE_FLAVA3 &&
+	       frl_wiring_valid() && frl_mode_config(mode, max_bpc, config);
+}
+EXPORT_SYMBOL(getHdmiFrlConfig);
+
+bool isHdmiFrlTiming(const struct drm_display_mode *mode)
+{
+	struct ps5_hdmi_frl_config config;
+
+	return frl_mode_config(mode, 10, &config);
+}
+EXPORT_SYMBOL(isHdmiFrlTiming);
+
+bool isHdmiModeFrl(const struct drm_display_mode *mode)
+{
+	struct ps5_hdmi_frl_config config;
+
+	return getHdmiFrlConfig(mode, 10, &config);
+}
+EXPORT_SYMBOL(isHdmiModeFrl);
